      <h1 style="font-size:2rem;line-height:1.35;">How Should Children Be Educated to Thrive in the AI Era?</h1>
      <div class="article-meta">
        <span>2026-05-08</span>
        {tags.filter(Boolean).map(t => <span class="tag">{t}</span>)}
      </div>
    </div>
