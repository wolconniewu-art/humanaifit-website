#!/bin/bash
# deploy_humanaifit.sh — 一键构建 + Wrangler部署 + Purge Cache + 线上验证
# 
# 用法:
#   bash deploy_humanaifit.sh              # 标准部署（需 CTA 审查标记存在）
#   bash deploy_humanaifit.sh --site-update # 站点信息更新（非新文章）

set -euo pipefail

SITE_DIR="/home/connie/.openclaw/workspace/humanaifit-website"
ZONE_ID="9274a5936a5ae5d9b2fe82889cd4e79a"
TOKEN_FILE="/home/connie/.wsl_cf_token"

# ---- 参数解析 ----
SITE_UPDATE=false
CI_MODE=false
for arg in "$@"; do
  case "$arg" in
    --site-update) SITE_UPDATE=true;;
    --ci-mode) CI_MODE=true;;
  esac
done

# ---- 读取 CF Token ----
if [ ! -f "$TOKEN_FILE" ]; then
  echo "错误: $TOKEN_FILE 不存在，请先创建 (echo -n 'your token' > $TOKEN_FILE && chmod 600 $TOKEN_FILE)" >&2
  exit 1
fi
CF_TOKEN=$(cat "$TOKEN_FILE")
if [ ${#CF_TOKEN} -lt 40 ]; then
  echo "错误: Token 长度异常 (${#CF_TOKEN} bytes)，请检查 $TOKEN_FILE" >&2
  exit 1
fi

cd "$SITE_DIR"

# ---- Step 0: CTA 审查检查 ----
if [ "$CI_MODE" = true ]; then
  echo ""
  echo "  CI模式：跳过 CTA/审阅检查（由 publish-article 在阶段二完成）"
elif [ "$SITE_UPDATE" = false ]; then
  echo ""
  echo "Step 0: CTA 审查检查..."
  CTA_FLAGS=$(ls _cta_reviewed_*.md 2>/dev/null || true)
  if [ -z "$CTA_FLAGS" ]; then
    echo "   错误: 未找到 CTA 审查标志文件 (_cta_reviewed_*.md)"
    echo "   所有文章发布前必须经过 product_manager CTA 审查。"
    echo "   如需跳过: python3 ../scripts/cta_review.py skip <slug> <原因>"
    echo "   或: touch _cta_reviewed_$(date +%Y%m%d)_SKIPPED.md"
    exit 1
  fi
  for f in _cta_reviewed_*.md; do
    echo "   CTA 审查已通过: $f"
  done

  echo ""
  echo "Step 0a: 审阅完成标记检查..."
  if [[ -f "../memory/_review_completed_${SLUG:-*}.md" ]]; then
    echo "   ✅ 审阅完成标记已存在"
  else
    echo "   警告: 未找到审阅完成标记 (memory/_review_completed_*.md)"
    echo "   建议在部署前完成多AGENT审阅 + 运行 scripts/review_completed.py"
    echo "   （此警告暂不阻断，未来将升级为硬门禁）"
  fi
else
  echo ""
  echo "  站点更新模式（跳过 CTA 审查）"
fi

# ---- Step 0b: 标题校验 ----
echo ""
echo "Step 0b: 标题完整性校验..."

# 英文标题
SHORT_TITLES=$(grep -oP '(?<=title: ")[^"]+' src/pages/en/blog.astro | awk 'length < 20 {print}' | head -5)
if [ -n "$SHORT_TITLES" ]; then
  echo "   错误: 发现短标题（<20字符），疑似截断:"
  echo "$SHORT_TITLES" | while IFS= read -r t; do
    echo "      \"$t\""
  done
  echo "   请在 en/blog.astro 中修复完整标题后重试。"
  exit 1
fi

# 中文标题
python3 scripts/check_title_length.py || exit 1

echo "   所有标题长度正常"

# ---- Step 0c: 中英文同步检查 ----
echo ""
echo "Step 0c: 中英文同步检查..."
python3 scripts/auto_sync_check.py || true

# ---- Step 1: 构建 ----
echo ""
echo "Step 1: 构建..."
npm run build
echo "   ✅ 构建成功"

# ---- Step 2: Wrangler 部署 ----
echo ""
echo "Step 2: Wrangler 部署..."
DEPLOY_OUTPUT=$(CLOUDFLARE_API_TOKEN="$CF_TOKEN" \
  npx wrangler pages deploy dist --project-name=humanaifit-website 2>&1)
DEPLOY_EXIT_CODE=$?

echo "$DEPLOY_OUTPUT"

if [ $DEPLOY_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "   ❌ Wrangler 部署失败 (exit code $DEPLOY_EXIT_CODE)"
  echo "   错误信息如上。可能原因:"
  echo "     - CF_TOKEN 无效或过期"
  echo "     - 网络连接问题"
  echo "     - wrangler 版本不兼容"
  echo ""
  echo "   手动部署方案:"
  echo "     1. 确认 token: cat ~/.wsl_cf_token | wc -c (应 ≥ 40)"
  echo "     2. 手动构建: npm run build"
  echo "     3. 通过 Cloudflare Dashboard 上传 dist/"
  echo "     4. 在 Dashboard 中 Purge Cache"
  exit 1
fi

# 提取部署 URL
DEPLOY_URL=$(echo "$DEPLOY_OUTPUT" | grep -oP 'https://[a-z0-9-]+\.pages\.dev' | head -1)
echo "   ✅ Wrangler 部署成功"
[ -n "$DEPLOY_URL" ] && echo "   临时域名: $DEPLOY_URL"

# ---- Step 3: Purge Cache ----
echo ""
echo "Step 3: Purge Cache..."
PURGE_RESULT=$(curl -s --max-time 15 -X POST \
  "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/purge_cache" \
  -H "Authorization: Bearer $CF_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"purge_everything":true}')

echo "$PURGE_RESULT" | python3 -c "
import sys, json
d = json.load(sys.stdin)
if d.get('success'):
    print('   缓存清除: ✅ 成功')
else:
    errors = d.get('errors', [])
    for e in errors:
        print(f'   缓存清除: ❌ 失败 - {e.get(\"message\", \"unknown\")}')
    sys.exit(1)
"

# ---- Step 4: 线上验证 ----
echo ""
echo "Step 4: 线上验证..."
# 等待缓存刷新
sleep 3

# 验证首页
HOME_CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "https://www.humanaifit.com/" 2>/dev/null || echo "000")
echo "   首页: $HOME_CODE https://www.humanaifit.com/"

# 验证中英文博客首页
BLOG_ZH_CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "https://www.humanaifit.com/blog/" 2>/dev/null || echo "000")
BLOG_EN_CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "https://www.humanaifit.com/en/blog/" 2>/dev/null || echo "000")
echo "   博客首页: 中文=$BLOG_ZH_CODE 英文=$BLOG_EN_CODE"

if [ "$HOME_CODE" = "200" ] && [ "$BLOG_ZH_CODE" = "200" ] && [ "$BLOG_EN_CODE" = "200" ]; then
  echo "   ✅ 站点核心页面均 200 OK"
else
  echo "   ⚠️  部分页面状态异常（首页=$HOME_CODE 中文博客=$BLOG_ZH_CODE 英文博客=$BLOG_EN_CODE）"
  echo "     可能原因: CF 缓存尚未完全刷新，等待 1 分钟后重试"
fi

echo ""
echo "=========================================="
echo "  部署完成！访问 https://www.humanaifit.com 查看"
echo "=========================================="
