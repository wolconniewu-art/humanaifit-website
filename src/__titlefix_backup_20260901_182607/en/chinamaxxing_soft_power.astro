      <h1 style="font-size:2rem;line-height:1.35;">The Soft-Power Shift Behind Chinamaxxing: From "Function" to "Way of Life"</h1>
      <div class="article-meta">
        <span>2026-09-01</span>
        {tags.filter(Boolean).map(t => <span class="tag">{t}</span>)}
