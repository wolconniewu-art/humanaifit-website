---
export interface Props {
  title: string;
  description: string;
  date?: string;
  tags?: string[];
  lang?: string;
}

const { title, description, date = '', tags = [], lang = 'zh-CN' } = Astro.props;
const isCn = lang.startsWith('zh');
const path = Astro.url.pathname;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | humanaifit 博客</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | humanaifit 博客`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://www.humanaifit.com${path}`} />
  <link rel="canonical" href={`https://www.humanaifit.com${path}`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:image" content={`https://www.humanaifit.com/og-default.jpg`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="article:published_time" content={date} />
  {tags.map(t => <meta property="article:tag" content={t} />)}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    datePublished: date,
    inLanguage: lang,
    keywords: tags.join(', '),
    author: { '@type': 'Organization', name: 'humanAIfit' },
    publisher: { '@type': 'Organization', name: 'humanAIfit', logo: { '@type': 'ImageObject', url: 'https://www.humanaifit.com/logo.svg' } },
    mainEntityOfPage: `https://www.humanaifit.com${path}`,
    image: 'https://www.humanaifit.com/og-default.jpg'
  })} />
  <style>
    /* 阅读进度条 */
    #readProgress {
      position: fixed; top: 0; left: 0; height: 3px; width: 0%;
      background: linear-gradient(90deg, #0F2B46, #C9A96E);
      z-index: 9999; transition: width 0.1s linear;
    }
  </style>
  <style is:global>
    .article-hero {
      padding: 120px 0 40px;
      background: linear-gradient(160deg, #f5f7fa 0%, #ffffff 50%, #eef1f5 100%);
      position: relative;
      overflow: hidden;
    }
    .article-hero::after {
      content: '';
      position: absolute;
      top: -80px; right: -80px;
      width: 300px; height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,169,110,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .article-hero h1 {
      margin: 0 0 4px 0;
      line-height: 1.3;
      overflow: visible;
      text-overflow: clip;
    }
    .article-hero .article-subtitle {
      display: block;
      margin: 6px 0 0 0;
      font-size: clamp(1.05rem, 1.2vw + 0.6rem, 1.25rem) !important;
      line-height: 1.5 !important;
      color: var(--color-text-secondary, #555) !important;
      font-weight: 500;
      white-space: normal !important;
    }
    .article-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: var(--spacing-md);
      font-size: 13px;
      color: var(--color-text-muted);
    }
    .article-meta .tag {
      display: inline-block;
      padding: 3px 10px;
      background: rgba(201,169,110,0.12);
      color: var(--color-accent-dark);
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
    }
    .article-body {
      max-width: 720px;
      margin: 0 auto;
      padding: 40px var(--content-padding) 80px;
      font-size: 16px;
      line-height: 1.9;
      color: var(--color-text);
    }
    .article-body h2 {
      font-size: 1.5rem;
      margin-top: 48px;
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--color-border);
    }
    .article-body h3 {
      font-size: 1.2rem;
      margin-top: 32px;
      margin-bottom: 12px;
    }
    .article-body p {
      margin-bottom: 16px;
    }
    .article-body blockquote {
      margin: 24px 0;
      padding: 16px 24px;
      border-left: 4px solid var(--color-accent);
      background: rgba(201,169,110,0.06);
      border-radius: 0 8px 8px 0;
      font-style: italic;
      color: #555;
    }
    .article-body blockquote p { margin-bottom: 0; }
    /* ===== 表格显示样式 ===== */
    .article-body table {
      width: 100%;
      margin: 32px 0;
      border-collapse: collapse;
    }
    .article-body th {
      background: var(--color-accent);
      color: white;
      font-weight: 600;
      text-align: left;
      padding: 12px 16px;
      font-size: 14px;
    }
    .article-body td {
      padding: 10px 16px;
      border-bottom: 1px solid #eee;
      font-size: 14px;
      line-height: 1.6;
      vertical-align: top;
    }
    .article-body thead + tbody tr:nth-child(even) td {
      background: #f9f9f7;
    }
    .article-body .copy-source {
      display: none;
    }
    /* 浏览器复制时的优化：在td之间插入空格，让复制出来的表格列之间有分隔 */
    .article-body th::after,
    .article-body td::after {
      content: " | ";
      white-space: pre;
    }
    .article-body td:last-child::after {
      content: none;
    }
    .article-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 24px 0;
      font-size: 14px;
    }
    .article-body th, .article-body td {
      padding: 10px 14px;
      border: 1px solid var(--color-border);
      text-align: left;
    }
    .article-body th {
      background: var(--color-primary);
      color: white;
      font-weight: 600;
    }
    .article-body tr:nth-child(even) {
      background: #f8f8f8;
    }
    .article-body hr {
      margin: 40px 0;
      border: none;
      border-top: 1px solid var(--color-border);
    }
    .article-body .callout {
      margin: 24px 0;
      padding: 16px 20px;
      background: rgba(15,43,70,0.04);
      border-radius: 8px;
      border-left: 4px solid var(--color-primary);
    }
    .article-body .callout strong {
      color: var(--color-primary);
    }
    /* ===== 参考文献规范显示 ===== */
    .article-body ol {
      margin: 16px 0 24px;
      padding-left: 24px;
      list-style: decimal;
    }
    .article-body ol li {
      margin: 8px 0;
      padding-left: 4px;
      line-height: 1.7;
      font-size: 14px;
      color: var(--color-text);
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .article-body ol li a, .article-body p a {
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .article-body ol li strong {
      color: var(--color-text);
    }
    .article-body .reference-section p {
      margin: 8px 0;
      font-size: 14px;
      color: var(--color-text);
    }
    .article-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 24px;
      font-size: 14px;
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .article-back:hover { color: var(--color-accent); }
    .article-footer {
      max-width: 720px;
      margin: 0 auto;
      padding: 32px var(--content-padding) 64px;
      border-top: 1px solid var(--color-border);
      text-align: center;
    }
    @media (max-width: 768px) {
      .article-hero { padding: 90px 0 24px; }
      .article-body { font-size: 15px; padding: 24px var(--content-padding) 80px; }
      .article-body h2 { font-size: 1.3rem; }
    }
  </style>
  <!-- 全局（非 scoped）：覆盖每篇文章 <h1> 的内联 white-space:nowrap，
       避免小屏标题强制单行导致横向溢出。标题在窄屏改为正常换行。 -->
  <style is:global>
    .article-hero h1 {
      white-space: nowrap;
      overflow-wrap: normal;
      word-break: keep-all;
      max-width: 100%;
      font-size: clamp(1.25rem, 2.2vw + 0.5rem, 1.75rem);
      line-height: 1.3;
    }
    /* 标题区域可比正文更宽：桌面放宽 hero 容器，让长标题单行且不缩得太小 */
    @media (min-width: 900px) {
      .article-hero .container { max-width: 880px !important; }
    }
    /* 窄屏：标题尽量用满宽度（减少两侧留白），以便单行可读 */
    @media (max-width: 640px) {
      .article-hero .container { padding-left: 12px !important; padding-right: 12px !important; }
    }
    .article-body {
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
    }
    /* 参考文献/正文长 URL 一律不溢出（全局，覆盖 scoped 够不到的链接） */
    .article-body a,
    .article-body li,
    .article-body ul,
    .article-body p,
    .article-body h2,
    .article-body h3,
    .article-body h4,
    .article-body td,
    .article-body th,
    .article-body ol li,
    .article-body ol li a,
    .article-body p a {
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
    }
  </style>
  <script is:inline>
    // 标题排版：先尝试单行；若按可读下限仍装不下，则改为正常换行（保证永不溢出）
    (function () {
      var MIN = 12; // 单行模式的字号下限（px）——低于此则改用更宽的行宽
      function fitTitle() {
        var h1 = document.querySelector('.article-hero h1');
        if (!h1) return;
        var box = h1.parentElement || h1;
        // 标题允许比正文更宽：桌面上放宽到最多 1000px，减少因过窄造成的过度缩字
        h1.style.maxWidth = '1000px';
        h1.style.width = '100%';
        // 量测基准：强制单行 + 自然字距
        h1.style.whiteSpace = 'nowrap';
        h1.style.wordBreak = 'keep-all';
        h1.style.overflowWrap = 'normal';
        h1.style.fontSize = '';
        // 标题允许比正文更宽：桌面上 hero 容器已放宽（见全局 CSS）
        var boxPad = parseFloat(getComputedStyle(box).paddingLeft || 0) + parseFloat(getComputedStyle(box).paddingRight || 0);
        var avail = (box.clientWidth - boxPad) - 2;
        if (avail <= 0) avail = h1.clientWidth || 300;
        var base = parseFloat(getComputedStyle(h1).fontSize) || 20;
        if (base < MIN) base = MIN;
        // 单次比例估算，避免多次重排振荡
        var need = base * (avail / Math.max(1, h1.scrollWidth)) * 0.985;
        if (need >= MIN) {
          // 单行可行：用缩后字号，保持单行
          if (need < base) h1.style.fontSize = need.toFixed(2) + 'px';
          h1.style.whiteSpace = 'nowrap';
        } else {
          // 单行不可行：用可读下限 + 正常换行
          h1.style.fontSize = MIN + 'px';
          h1.style.whiteSpace = 'normal';
          h1.style.wordBreak = 'normal';
          h1.style.overflowWrap = 'break-word';
        }
      }
      var raf = window.requestAnimationFrame || function (f) { setTimeout(f, 16); };
      function run() { raf(fitTitle); }
      if (document.readyState !== 'loading') run();
      document.addEventListener('DOMContentLoaded', run);
      window.addEventListener('load', run);
      var t; window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(fitTitle, 120); });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(run);
    })();
  </script>
</head>
<body>
  <div id="readProgress" aria-hidden="true"></div>
  <!-- Header -->
  <header class="header">
    <nav class="nav">
      <a href={isCn ? '/' : '/en/'} class="nav-logo" style="flex-direction:column;gap:3px;">
        <img src="/logo-mark.svg?v=5" width="30" height="30" alt="humanAIfit" style="flex-shrink:0;display:block;" />
        <span class="logo-text" style="font-size:13px;">
          <span style="font-weight:400;color:#0F2B46;">human</span><span style="font-weight:800;color:#C9A96E;">AI</span><span style="font-weight:300;color:#8A8A8A;">fit</span>
        </span>
      </a>
      <ul class="nav-links">
        <li><a href={isCn ? '/' : '/en/'} class="nav-home">{isCn ? '首页' : 'Home'}</a></li>
        <li><a href={isCn ? '/services/' : '/en/services/'} class="nav-services">{isCn ? '服务' : 'Services'}</a></li>
        <li><a href={isCn ? '/about/' : '/en/about/'} class="nav-about">{isCn ? '关于' : 'About'}</a></li>
        <li><a href={isCn ? '/blog/' : '/en/blog/'} class="nav-insights">{isCn ? '博客' : 'Insights'}</a></li>
        <li><a href={isCn ? '/diagnosis/cbam/' : 'https://cbam.humanaifit.com/?lang=en'} class="btn btn-cbam" target="_blank">{isCn ? 'CBAM助手' : 'CBAM Tool'}</a></li>
        <li><a href={isCn ? '/contact/' : '/en/contact/'} class="btn btn-primary" style="padding:8px 20px;font-size:13px;">{isCn ? '合作咨询' : 'Contact'}</a></li>
        <li><span class="lang-switch">{isCn ? 'EN' : '中文'}</span></li>
      </ul>
    </nav>
  </header>

  <main style="padding-top:0;">
    <slot />
  </main>

  <!-- Footer (与 Base.astro 一致：logo + 页面导航 + 订阅 + 回到顶部) -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="company" style="margin-bottom:12px;">
            <img src="/logo.svg?v=5" width="150" height="150" alt="humanAIfit — www.humanaifit.com" style="display:block;width:150px;height:auto;" />
          </div>
          <div style="font-size:14px;color:var(--color-text-secondary);margin-bottom:8px;">{isCn ? '彼恳企业管理咨询（上海）有限责任公司' : 'Beacon Consulting Co., Ltd.'}</div>
          <div style="font-size:13px;color:var(--color-text-muted);line-height:1.7;max-width:280px;">
            {isCn
              ? '组织及个人真正的竞争力不来自AI本身，而来自人类智能与人工智能的协同增长。'
              : 'True competitiveness does not come from AI alone, but from the synergy between human intelligence and artificial intelligence.'}
          </div>
          <div style="margin-top:var(--spacing-md);display:flex;gap:14px;align-items:center;">
            <a href="https://www.zhihu.com/people/humanaifit" target="_blank" rel="noopener noreferrer" title="知乎" style="font-size:13px;color:var(--color-text-secondary);text-decoration:none;border:1px solid var(--color-border);border-radius:6px;padding:5px 12px;">知乎</a>
            <span title="微信公众号：humanaifit" style="font-size:13px;color:var(--color-text-secondary);border:1px solid var(--color-border);border-radius:6px;padding:5px 12px;">公众号 humanaifit</span>
          </div>
        </div>
        <div>
          <h4>{isCn ? '页面导航' : 'Navigate'}</h4>
          <a href={isCn ? '/' : '/en/'}>{isCn ? '首页' : 'Home'}</a>
          <a href={isCn ? '/services/' : '/en/services/'}>{isCn ? '服务' : 'Services'}</a>
          <a href={isCn ? '/about/' : '/en/about/'}>{isCn ? '关于我们' : 'About'}</a>
          <a href={isCn ? '/blog/' : '/en/blog/'}>{isCn ? '博客' : 'Insights'}</a>
          <a href={isCn ? '/diagnosis/' : '/en/diagnosis/'}>{isCn ? '诊断工具' : 'Diagnostics'}</a>
          <a href={isCn ? '/policy-tables/' : '/en/policy-tables/'}>{isCn ? '政策表' : 'Policy Tables'}</a>
        </div>
        <div>
          <h4>{isCn ? '服务' : 'Services'}</h4>
          <a href={isCn ? '/services/' : '/en/services/'}>{isCn ? '人机协同咨询' : 'Human-AI Fit Consulting'}</a>
          <a href={isCn ? '/services/' : '/en/services/'}>{isCn ? 'CBAM碳合规' : 'CBAM Carbon Compliance'}</a>
          <a href={isCn ? '/services/' : '/en/services/'}>{isCn ? '全球化战略' : 'Globalization Strategy'}</a>
        </div>
        <div>
          <h4>{isCn ? '联系' : 'Contact'}</h4>
          <a href={isCn ? '/contact/' : '/en/contact/'}>{isCn ? '合作咨询' : 'Get in Touch'}</a>
        </div>
        <div>
          <h4>{isCn ? '订阅更新' : 'Subscribe'}</h4>
          <p style="font-size:13px;color:var(--color-text-muted);margin-bottom:var(--spacing-sm);">
            {isCn ? '每周精选博客，直接到你的邮箱。' : 'Weekly insights delivered to your inbox.'}
          </p>
          <form id="footerSubscribe" onsubmit="return humaSubscribe(event)" style="display:flex;gap:6px;">
            <input type="email" name="email" placeholder={isCn ? '输入邮箱' : 'your@email.com'} required style="flex:1;min-width:0;padding:8px 12px;border:1px solid var(--color-border);border-radius:6px;font-size:13px;background:var(--color-bg);" />
            <button type="submit" style="padding:8px 16px;background:#3B82F6;color:white;border:none;border-radius:6px;font-size:13px;cursor:pointer;">{isCn ? '订阅' : '→'}</button>
          </form>
          <div id="footerSubscribeMsg" style="font-size:12px;margin-top:8px;min-height:16px;"></div>
        </div>
      </div>
      <div class="footer-bottom">
        &copy; {new Date().getFullYear()} {isCn ? '彼恳企业管理咨询（上海）有限责任公司' : 'Beacon Consulting Co., Ltd.'} — {isCn ? 'All rights reserved.' : 'All rights reserved.'}
      </div>
    </div>
    <button id="backToTop" aria-label={isCn ? '回到顶部' : 'Back to top'} title={isCn ? '回到顶部' : 'Back to top'} onclick="window.scrollTo({top:0,behavior:'smooth'})">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
      <span>{isCn ? '顶部' : 'Top'}</span>
    </button>
  </footer>

  <script is:inline>
    async function humaSubscribe(e) {
      e.preventDefault();
      var f = e.target, msg = document.getElementById('footerSubscribeMsg');
      var email = (f.email.value || '').trim();
      if (!email) return false;
      msg.style.color = '#666'; msg.textContent = '提交中...';
      try {
        var res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, intent: '订阅内容', source: 'subscribe', note: 'Article footer 订阅新文通知' })
        });
        var data = await res.json();
        if (data && data.success === false) throw new Error(data.error || 'failed');
        msg.style.color = '#2e7d32';
        msg.textContent = document.documentElement.lang === 'en' ? '✅ Subscribed. New posts will reach you.' : '✅ 已订阅，有新文章会通知你。';
        f.reset();
      } catch (err) {
        msg.style.color = '#c62828';
        msg.textContent = document.documentElement.lang === 'en' ? 'Failed, try again.' : '提交失败，请稍后再试。';
      }
      return false;
    }
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 阅读进度条
      var bar = document.getElementById('readProgress');
      if (bar) {
        var upd = function() {
          var h = document.documentElement.scrollHeight - window.innerHeight;
          var p = h > 0 ? Math.min(100, Math.max(0, (window.scrollY / h) * 100)) : 0;
          bar.style.width = p + '%';
        };
        window.addEventListener('scroll', upd, { passive: true });
        window.addEventListener('resize', upd, { passive: true });
        upd();
      }
      const langSwitch = document.querySelector('.lang-switch');
      if (langSwitch) {
        langSwitch.addEventListener('click', () => {
          const isCn = document.documentElement.lang === 'zh-CN';
          const path = window.location.pathname;
          let target;
          if (isCn) {
            // On blog article pages, go to /en/blog/ instead of non-existent /en/blog/...
            if (path.startsWith('/blog/') && path !== '/blog/') {
              target = '/en/blog/';
            } else if (path === '/' || path === '') {
              target = '/en/';
            } else {
              target = '/en' + path;
            }
          } else {
            target = path.replace('/en', '') || '/';
          }
          window.location.href = target;
        });
      }
    });
  </script>
</body>
</html>
