---
export interface Props {
  title: string;
  description: string;
  lang?: string;
  path?: string;
}

const { title, description, lang = 'zh-CN', path = '/' } = Astro.props;
const isCn = lang.startsWith('zh');
const alternateLang = isCn ? 'en' : 'zh-cn';
const alternatePath = path === '/' 
  ? (isCn ? '/en/' : '/') 
  : (isCn ? `/en${path}` : path.replace('/en', ''));
const canonicalBase = 'https://humanaifit.com';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | humanaifit</title>
  <meta name="description" content={description} />

  <!-- Canonical -->
  <link rel="canonical" href={`${canonicalBase}${path}`} />

  <!-- Alternate hreflang -->
  <link rel="alternate" href={`${canonicalBase}${isCn ? '/' : '/en/'}`} hreflang="zh-CN" />
  <link rel="alternate" href={`${canonicalBase}${isCn ? '/en/' : '/'}`} hreflang="en" />
  <link rel="alternate" href={`${canonicalBase}/`} hreflang="x-default" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | humanaifit`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${canonicalBase}${path}`} />
  <meta property="og:locale" content={isCn ? 'zh_CN' : 'en_US'} />
  <meta property="og:image" content={`${canonicalBase}/og-default.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={`${canonicalBase}/og-default.jpg`} />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Styles -->
  <!-- global.css 由 Astro 在 frontmatter 中 import，自动注入带哈希的 <link> -->

  <!-- Scripts -->
  <script>
    // Language switch — works on any page, not just index
    // Only fires when lang-switch has no href (legacy fallback)
    document.addEventListener('DOMContentLoaded', () => {
      const langSwitch = document.querySelector('.lang-switch');
      if (langSwitch && !langSwitch.getAttribute('href')) {
        langSwitch.addEventListener('click', () => {
          const isCn = document.documentElement.lang === 'zh-CN';
          const path = window.location.pathname;
          let target;
          if (isCn) {
            if (path.startsWith('/blog/') && path !== '/blog/') {
              target = '/en/blog/';
            } else if (path === '/' || path === '') {
              target = '/en/';
            } else {
              target = '/en' + path;
            }
          } else {
            target = path.replace('/en', '') || '/';
          }
          window.location.href = target;
        });
      }
    });

    // Active nav highlighting
    document.addEventListener('DOMContentLoaded', () => {
      var path = window.location.pathname;
      var links = document.querySelectorAll('.nav-links a');
      links.forEach(function(a) {
        var href = a.getAttribute('href');
        // Skip buttons and external links
        if (a.classList.contains('btn') || a.classList.contains('btn-cbam') || a.classList.contains('lang-switch') || !href) return;
        // Exact match or starts-with match for deeper pages
        if (href === '/' && (path === '/' || path === '')) {
          a.style.color = '#C9A96E';
          a.style.fontWeight = '600';
        } else if (href !== '/' && path.startsWith(href) && href.length > 1) {
          a.style.color = '#C9A96E';
          a.style.fontWeight = '600';
        }
      });
    });
  </script>
</head>
<body>
  <!-- Header (v2: 毛玻璃效果 + 当前页面高亮) -->
  <header class="header" style="-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);background:rgba(255,255,255,0.85);">
    <nav class="nav">
      <a href={isCn ? '/' : '/en/'} class="nav-logo">
        <img src="/logo.svg?v=4" width="76" height="76" alt="humanAIfit — www.humanaifit.com" style="display:block;flex-shrink:0;" />
      </a>
      <ul class="nav-links">
        <li><a href={isCn ? '/' : '/en/'} class="nav-home">{isCn ? '首页' : 'Home'}</a></li>
        <li><a href={isCn ? '/services/' : '/en/services/'} class="nav-services">{isCn ? '服务' : 'Services'}</a></li>
        <li><a href={isCn ? '/about/' : '/en/about/'} class="nav-about">{isCn ? '关于' : 'About'}</a></li>
        <li><a href={isCn ? '/policy-tables/' : '/en/policy-tables/'} class="nav-tables">{isCn ? '政策表' : 'Policy Tables'}</a></li>
        <li><a href={isCn ? '/blog/' : '/en/blog/'} class="nav-insights">{isCn ? '博客' : 'Blog'}</a></li>
        <li><a href={isCn ? '/diagnosis/cbam/' : '/en/diagnosis/cbam/'} class="btn btn-cbam">{isCn ? 'CBAM助手' : 'CBAM Tool'}</a></li>
        <li><a href={isCn ? '/diagnosis/' : '/en/diagnosis/'} class="btn btn-diagnosis" style="padding:8px 16px;background:var(--color-accent);color:#0F2B46;border-radius:6px;font-size:13px;font-weight:600;text-decoration:none;">{isCn ? 'AI素养诊断' : 'AI Literacy Diagnosis'}</a></li>
        <li><a href={isCn ? '/contact/' : '/en/contact/'} class="btn btn-primary" style="padding:8px 20px;font-size:13px;">{isCn ? '合作咨询' : 'Contact'}</a></li>
        <li>
          <!-- Language switch as direct links (no JS dependency) -->
          <a href={isCn ? '/en/' : '/'} class="lang-switch" style="text-decoration:none;cursor:pointer;">{isCn ? 'EN' : '中文'}</a>
        </li>
      </ul>
    </nav>
  </header>

  <main style="padding-top:88px;">
    <slot />
  </main>

  <!-- Footer (v2: 加大Logo + 订阅区 + 社交链接占位) -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="company" style="margin-bottom:12px;">
            <img src="/logo.svg?v=4" width="150" height="150" alt="humanAIfit — www.humanaifit.com" style="display:block;width:150px;height:auto;" />
          </div>
          <div style="font-size:14px;color:var(--color-text-secondary);margin-bottom:8px;">{isCn ? '彼恳企业管理咨询（上海）有限责任公司' : 'Beacon Consulting Co., Ltd.'}</div>
          <div style="font-size:13px;color:var(--color-text-muted);line-height:1.7;max-width:280px;">
            {isCn
              ? '组织及个人真正的竞争力不来自AI本身，而来自人类智能与人工智能的协同增长。'
              : 'True competitiveness does not come from AI alone, but from the synergy between human intelligence and artificial intelligence.'}
          </div>
          <!-- Social links: 只放真实存在的（知乎 / 微信公众号）；未确定的 LinkedIn/X/FB 暂不展示死链 -->
          <div style="margin-top:var(--spacing-md);display:flex;gap:14px;align-items:center;">
            <a href="https://www.zhihu.com/people/humanaifit" target="_blank" rel="noopener noreferrer" title="知乎" style="font-size:13px;color:var(--color-text-secondary);text-decoration:none;border:1px solid var(--color-border);border-radius:6px;padding:5px 12px;">知乎</a>
            <span title="微信公众号：humanaifit" style="font-size:13px;color:var(--color-text-secondary);border:1px solid var(--color-border);border-radius:6px;padding:5px 12px;">公众号 humanaifit</span>
          </div>
        </div>
        <div>
          <h4>{isCn ? '服务' : 'Services'}</h4>
          <a href={isCn ? '/services/' : '/en/services/'}>{isCn ? '人机协同咨询' : 'Human-AI Fit Consulting'}</a>
          <a href={isCn ? '/services/' : '/en/services/'}>{isCn ? 'CBAM碳合规' : 'CBAM Carbon Compliance'}</a>
          <a href={isCn ? '/services/' : '/en/services/'}>{isCn ? '全球化战略' : 'Globalization Strategy'}</a>
        </div>
        <div>
          <h4>{isCn ? '联系' : 'Contact'}</h4>
          <a href={isCn ? '/contact/' : '/en/contact/'}>{isCn ? '合作咨询' : 'Get in Touch'}</a>
        </div>
        <!-- Newsletter subscribe section -->
        <div>
          <h4>{isCn ? '订阅更新' : 'Subscribe'}</h4>
          <p style="font-size:13px;color:var(--color-text-muted);margin-bottom:var(--spacing-sm);">
            {isCn ? '每周精选博客，直接到你的邮箱。' : 'Weekly insights delivered to your inbox.'}
          </p>
          <form id="footerSubscribe" onsubmit="return humaSubscribe(event)" style="display:flex;gap:6px;">
            <input type="email" name="email" placeholder={isCn ? '输入邮箱' : 'your@email.com'} required style="flex:1;min-width:0;padding:8px 12px;border:1px solid var(--color-border);border-radius:6px;font-size:13px;background:var(--color-bg);" />
            <button type="submit" style="padding:8px 16px;background:#3B82F6;color:white;border:none;border-radius:6px;font-size:13px;cursor:pointer;">{isCn ? '订阅' : '→'}</button>
          </form>
          <div id="footerSubscribeMsg" style="font-size:12px;margin-top:8px;min-height:16px;"></div>
        </div>
      </div>
      <div class="footer-bottom">
        &copy; {new Date().getFullYear()} {isCn ? '彼恳企业管理咨询（上海）有限责任公司' : 'Beacon Consulting Co., Ltd.'} — {isCn ? 'All rights reserved.' : 'All rights reserved.'}
      </div>
    </div>
  </footer>

  <!-- Footer subscribe → 复用 /api/lead 接口（source=subscribe） -->
  <script is:inline>
    async function humaSubscribe(e) {
      e.preventDefault();
      var f = e.target, msg = document.getElementById('footerSubscribeMsg');
      var email = (f.email.value || '').trim();
      if (!email) return false;
      msg.style.color = '#666'; msg.textContent = '提交中...';
      try {
        var res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, intent: '订阅内容', source: 'subscribe', note: 'Footer 订阅新文通知' })
        });
        var data = await res.json();
        if (data && data.success === false) throw new Error(data.error || 'failed');
        msg.style.color = '#2e7d32';
        msg.textContent = document.documentElement.lang === 'en' ? '✅ Subscribed. New posts will reach you.' : '✅ 已订阅，有新文章会通知你。';
        f.reset();
      } catch (err) {
        msg.style.color = '#c62828';
        msg.textContent = document.documentElement.lang === 'en' ? 'Failed, try again.' : '提交失败，请稍后再试。';
      }
      return false;
    }
  </script>
</body>
</html>
