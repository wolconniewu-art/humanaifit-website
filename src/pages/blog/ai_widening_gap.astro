      <h1 style="font-size:2rem;line-height:1.35;">AI 没有抹平差距，它在拉开差距</h1>
      <div class="article-meta">
        <span>2026-09-01</span>
        {tags.filter(Boolean).map(t => <span class="tag">{t}</span>)}
      </div>
    </div>
