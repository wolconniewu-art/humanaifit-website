              const ansIdx = answers[q.id];
              if (ansIdx === undefined) return '';
              const opt = q.options[ansIdx];
              const es = opt.scores.explore || 0;
              const aa = opt.scores.apply || 0;
              const cc = opt.scores.create || 0;
              const maxS = Math.max(es, aa, cc);
              let note = '';
              if (maxS > 0) {
                if (es === maxS && es > 0) note = '➕ 增加了“探索型”倾向';
                else if (aa === maxS && aa > 0) note = '➕ 增加了“应用型”倾向';
                else if (cc === maxS && cc > 0) note = '➕ 增加了“创作型”倾向';
              } else {
                note = '— 背景信息题，不计入倾向评分';
              }
              return `<div style="padding:6px 0;border-bottom:1px solid #eee;font-size:12px;color:#555;">
