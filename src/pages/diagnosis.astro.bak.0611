      if (pct) el.style.width = pct.textContent;
    });
  }, 100);
}

// ===== 分享 =====
function shareResult() {
  const r = RESULTS[result.type];
  const text = [
    '我的孩子是' + r.icon + r.label + '型！',
    '',
    '10道题30秒免费诊断，测测你家孩子是哪种AI学习者',
    'https://www.humanaifit.com/diagnosis/'
  ].join('\n');

  // 先复制文案
  navigator.clipboard.writeText(text).then(() => {
    // 再生成截图保存到手机
    screenshotShare();
  }).catch(() => {
    alert('📸 复制文案失败！\n\n请手动复制↓\n' + text);
  });
}

function screenshotShare() {
  if (typeof html2canvas !== 'undefined') {
    const card = document.querySelector('.card');
    if (card) {
      html2canvas(card, { backgroundColor: '#ffffff' }).then(canvas => {
        const dataUrl = canvas.toDataURL('image/png');
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;animation:fadeIn 0.2s;';
        overlay.innerHTML = '<div style="background:white;border-radius:16px;padding:20px;max-width:360px;width:100%;text-align:center;position:relative;">' +
          '<button onclick="this.parentElement.parentElement.remove()" style="position:absolute;top:8px;left:8px;border:none;background:rgba(0,0,0,0.5);color:white;font-size:20px;width:30px;height:30px;border-radius:50%;cursor:pointer;line-height:30px;z-index:10;">x</button>' +
          '<p style="font-size:14px;color:#333;margin:0 0 12px;"><strong>长按图片保存到相册</strong></p>' +
          '<p style="font-size:12px;color:#888;margin:0 0 12px;">也可以在微信中直接发该图片</p>' +
          '<img src="' + dataUrl + '" style="width:100%;border-radius:8px;" />' +
          '<button onclick="this.parentElement.parentElement.remove()" style="margin-top:12px;padding:10px 24px;border:none;background:#0F2B46;color:white;border-radius:8px;font-size:14px;cursor:pointer;">关闭</button>' +
          '</div>';
        document.body.appendChild(overlay);
      });
    }
  } else {
    alert('📸 请截图保存诊断结果！');
  }
}

function restart() {
  // 记录本次结果到localStorage用于复诊
  if (result) {
    try {
      const prevResults = JSON.parse(localStorage.getItem('diagnosis_results_history') || '[]');
      prevResults.push({ type: result.type, scores: result.scores, pct: result.pct, date: new Date().toISOString() });
      localStorage.setItem('diagnosis_results_history', JSON.stringify(prevResults.slice(-5)));
    } catch(e) {}
  }
  currentStep = 0;
  answers = {};
  result = null;
  leadSubmitted = false;
  renderStart();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ===== 留资 =====
function showLead() {
  document.getElementById('leadOverlay').classList.add('active');
}

function closeLead() {
  document.getElementById('leadOverlay').classList.remove('active');
  leadSubmitted = true;
  calculateResult();
}

function submitLead() {
  const name = document.getElementById('leadName').value.trim();
  const contact = document.getElementById('leadContact').value.trim();
  
  if (!contact) {
    alert('请输入微信号或手机号，以便接收诊断报告');
    return;
  }
  
  const privacyCheck = document.getElementById('privacyAgree');
  if (!privacyCheck || !privacyCheck.checked) {
    alert('请勾选同意隐私承诺，我们承诺保护您和孩子的信息安全');
    return;
  }
  
  try {
    const leads = JSON.parse(localStorage.getItem('diagnosis_leads') || '[]');
    leads.push({ name, contact, result, timestamp: new Date().toISOString() });
    localStorage.setItem('diagnosis_leads', JSON.stringify(leads));
  } catch(e) {}

  leadSubmitted = true;
  document.getElementById('leadOverlay').classList.remove('active');
  calculateResult();
}

// ===== 键盘支持 =====
document.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    const nextBtn = document.getElementById('nextBtn');
    if (nextBtn && !nextBtn.disabled) nextBtn.click();
  }
  if (['1','2','3'].includes(e.key)) {
    const opts = document.querySelectorAll('.option');
    const idx = parseInt(e.key) - 1;
    if (opts[idx]) opts[idx].click();
  }
});

// ===== 启动 =====
renderStart();

// ===== 支付弹窗 =====
function showPayment(tier) {
  const plans = {
    '49': { price: '49', name: 'AI素养深度解读报告', planet: '送1周星球体验' },
    '199': { price: '199', name: 'AI学习者家庭计划（季度）', planet: '送1个月星球免费' },
    '599': { price: '599', name: '1对1家庭教育顾问咨询', planet: '送2个月星球免费' }
  };
  const p = plans[tier];
  
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;';
  
  overlay.innerHTML = `
    <div style="background:white;border-radius:16px;padding:28px;max-width:380px;width:100%;text-align:center;animation:fadeIn 0.2s;">
      <button onclick="this.closest('[style*=\"z-index:9999\"]').remove()" style="float:right;border:none;background:none;font-size:20px;cursor:pointer;color:#999;">×</button>
      <h3 style="margin:8px 0 4px;font-size:18px;">${p.name}</h3>
      <p style="font-size:28px;font-weight:700;color:#0F2B46;margin:12px 0 4px;">¥${p.price}</p>
      <p style="font-size:13px;color:#C9A96E;font-weight:600;margin-bottom:16px;">🎁 ${p.planet}</p>
      <div style="background:#f5f5f5;padding:16px;border-radius:12px;margin-bottom:16px;">
        <div style="background:#fff8e1;padding:12px;border-radius:8px;margin-bottom:16px;">
        <p style="font-size:13px;color:#666;margin-bottom:8px;">微信扫码支付</p>
        <img src="/images/wechat_pay.jpg" alt="微信支付二维码" style="width:180px;height:180px;object-fit:cover;border-radius:8px;" />
        <p style="font-size:12px;color:#e65100;margin-bottom:4px;">💬 联系微信购买</p>
        <p style="font-size:12px;color:#555;margin-bottom:4px;">长按复制微信ID：</p>
        <div style="background:#f5f5f5;padding:8px;border-radius:6px;font-size:14px;font-weight:600;color:#0F2B46;margin:4px 0;text-align:center;cursor:pointer;" onclick="navigator.clipboard.writeText('blurblurfish');alert('已复制微信ID')">blurblurfish</div>
        <p style="font-size:12px;color:#666;margin-top:6px;">添加时备注“孩子诊断”，Connie会为你开通报告和星球免费期</p>
      </div>
      <button onclick="this.closest('[style*=\"z-index:9999\"]').remove()" style="padding:10px 28px;background:#f5f5f5;border:none;border-radius:8px;cursor:pointer;font-size:14px;color:#666;">关闭</button>
    </div>
  `;
  
  document.body.appendChild(overlay);
}
</script>

