        <p>${r.desc}</p>
      </div>

      <!-- MVA：今晚就能做的一件事 -->
      <div class="result-section" style="background:#f0f7ff;padding:16px;border-radius:10px;margin:12px 0;">
        <h3 style="margin-top:0;">🌙 今晚就能做的一件事</h3>
        <p>${r.mva}</p>
      </div>

      <!-- 混合型判定 -->
      ${
        result.secondaryType ? `<div class="result-section">
