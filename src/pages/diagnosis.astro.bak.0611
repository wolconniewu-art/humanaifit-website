---
// 孩子AI素养诊断 — v2.0 完善版
// 改进点：增加开始页面、得分雷达百分比、留资环节、社交分享、知识星球联动
// 路径: /diagnosis/
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>孩子AI素养诊断 — 10题测出你孩子的AI学习类型</title>
  <meta name="description" content="10道选择题，30秒测出你孩子的AI学习类型：探索型🔍 / 应用型🛠️ / 创作型🎨 附个性化学习建议" />
  <meta property="og:title" content="孩子AI素养诊断 — 10题测出你孩子的AI学习类型" />
  <meta property="og:description" content="30秒免费诊断，帮你回答「我的孩子该学什么AI？」" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.humanaifit.com/diagnosis/" />
  <style>
    :root {
      --primary: #0F2B46;
      --accent: #C9A96E;
      --bg: #f8f7f4;
      --card-bg: #ffffff;
      --text: #2d2d2d;
      --muted: #888888;
      --radius: 12px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
    }
    .container { max-width: 640px; margin: 0 auto; padding: 20px 16px; }
    .header { text-align: center; padding: 32px 0 8px; }
    .header h1 { font-size: 24px; color: var(--primary); font-weight: 700; }
    .header p { color: var(--muted); font-size: 14px; margin-top: 4px; }
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 12px;
    }
    .badge.green { background: #e8f5e9; color: #2e7d32; }
    .badge.gold { background: #fff8e1; color: #f57f17; }
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 24px;
      margin: 16px 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .progress-bar {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin: 16px 0;
    }
    .dot {
      width: 24px;
      height: 6px;
      border-radius: 3px;
      background: #e0e0e0;
      transition: background 0.3s;
    }
    .dot.active { background: var(--primary); }
    .dot.done { background: var(--accent); }
    .q-number {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .q-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 20px;
      color: var(--primary);
    }
    .options { display: flex; flex-direction: column; gap: 10px; }
    .option {
      padding: 14px 16px;
      border: 1px solid #e0e0e0;
      border-radius: 10px;
      background: white;
      text-align: left;
      font-size: 15px;
      cursor: pointer;
      transition: all 0.2s;
      line-height: 1.5;
      color: var(--text);
    }
    .option:hover { border-color: var(--accent); background: #fefcf6; }
    .option.selected {
      border-color: var(--primary);
      background: #eef3f8;
      font-weight: 500;
    }
    .btn-row {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }
    .btn {
      padding: 10px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }
    .btn-primary {
      background: var(--primary);
      color: white;
    }
    .btn-primary:hover { background: #1a3f64; }
    .btn-primary:disabled { background: #ccc; cursor: not-allowed; }
    .btn-secondary {
      background: #f0f0f0;
      color: #666;
    }
    .btn-secondary:hover { background: #e0e0e0; }
    .result-type { font-size: 48px; text-align: center; margin: 8px 0; }
    .result-label {
      text-align: center;
      font-size: 26px;
      font-weight: 700;
      color: var(--primary);
    }
    .result-sub {
      text-align: center;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .result-section { margin-top: 20px; }
    .result-section h3 {
      font-size: 15px;
      font-weight: 600;
      color: var(--primary);
      margin-bottom: 6px;
    }
    .result-section p { font-size: 14px; color: #444; line-height: 1.7; }
    .result-section ul { padding-left: 18px; margin-top: 6px; }
    .result-section li { margin-bottom: 4px; font-size: 14px; color: #444; }
    .sep { border: none; border-top: 1px solid #eee; margin: 20px 0; }
    .share-area { text-align: center; margin-top: 12px; }
    .share-description { font-size: 13px; color: #888; }
    .footer-note {
      text-align: center;
      padding: 20px 0;
      font-size: 12px;
      color: var(--muted);
    }
    .footer-note a { color: var(--muted); }
    .loading-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(255,255,255,0.8);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .loading-overlay.hidden { display: none; }
    .loading-spinner {
      width: 32px;
      height: 32px;
      border: 3px solid #e0e0e0;
      border-top: 3px solid var(--primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .fade-in { animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    /* 开始页 */
    .hero-icon { font-size: 56px; text-align: center; margin-bottom: 16px; }
    .hero-desc { text-align: center; font-size: 14px; color: #555; line-height: 1.8; margin-bottom: 24px; }
    .hero-desc strong { color: var(--primary); }
    .feature-list { margin: 20px 0; }
    .feature-item {
      display: flex; align-items: flex-start; gap: 10px;
      margin-bottom: 12px;
      font-size: 14px;
      color: #444;
    }
    .feature-icon { font-size: 18px; flex-shrink: 0; }
    .start-btn {
      display: block; width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--primary) 0%, #1a3f64 100%);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 17px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s;
      margin: 24px 0 12px;
    }
    .start-btn:hover { transform: scale(1.02); }
    .start-btn:active { transform: scale(0.98); }

    /* 雷达图 - 使用CSS简化版 */
    .score-bars { margin: 20px 0; }
    .score-row {
      display: flex; align-items: center;
      margin-bottom: 12px;
    }
    .score-label {
      width: 60px;
      font-size: 13px;
      font-weight: 500;
      color: var(--primary);
    }
    .score-track {
      flex: 1;
      height: 20px;
      background: #f0f0f0;
      border-radius: 10px;
      overflow: hidden;
      position: relative;
    }
    .score-fill {
      height: 100%;
      border-radius: 10px;
      transition: width 1s ease;
    }
    .score-fill.explore { background: linear-gradient(90deg, #4CAF50, #81C784); }
    .score-fill.apply { background: linear-gradient(90deg, #2196F3, #64B5F6); }
    .score-fill.create { background: linear-gradient(90deg, #FF9800, #FFB74D); }
    .score-pct {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 12px;
      font-weight: 600;
      color: #333;
    }

    /* 留资弹窗 */
    .lead-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .lead-overlay.active { display: flex; }
    .lead-modal {
      background: white;
      border-radius: 16px;
      padding: 28px 24px 20px;
      max-width: 380px;
      width: 100%;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      text-align: center;
    }
    .lead-modal h2 { font-size: 18px; margin-bottom: 4px; color: #333; }
    .lead-modal p { font-size: 13px; color: #666; margin-bottom: 16px; }
    .lead-modal input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #ddd;
      border-radius: 10px;
      font-size: 14px;
      margin-bottom: 10px;
      outline: none;
      box-sizing: border-box;
    }
    .lead-modal input:focus { border-color: var(--accent); }
    .lead-btn {
      width: 100%;
      padding: 12px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }
    .lead-btn:hover { background: #1a3f64; }
    .lead-close {
      margin-top: 12px;
      font-size: 13px;
      color: #999;
      cursor: pointer;
      background: none;
      border: none;
    }

    @media (max-width: 480px) {
      .header h1 { font-size: 20px; }
      .q-title { font-size: 16px; }
      .option { font-size: 14px; padding: 12px 14px; }
      .result-label { font-size: 22px; }
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "孩子AI素养诊断",
    "description": "10道选择题，30秒测出你孩子的AI学习类型：探索型🔍 / 应用型🛠️ / 创作型🎨",
    "educationalLevel": "Parent",
    "teaches": "AI Learning Style Assessment for Children",
    "url": "https://www.humanaifit.com/diagnosis/"
  }
  </script>
</head>
<body>

<div class="container" id="app">
  <div class="header">
    <span class="badge green">🎯 免费 · 30秒出结果</span>
    <h1>孩子AI素养诊断</h1>
    <p>10道选择题，帮你回答「我的孩子该学什么AI？」</p>
  </div>

  <div class="progress-bar" id="progressBar"></div>
  <div id="cardArea">
    <!-- 初始为空，由JS渲染开始页 -->
  </div>
  <div class="footer-note">
    彼恳管理咨询 · <a href="https://www.humanaifit.com">www.humanaifit.com</a>
  </div>
</div>

<!-- 留资弹窗 -->
<div class="lead-overlay" id="leadOverlay">
  <div class="lead-modal">
    <h2>📋 免费领取诊断报告</h2>
    <p>输入你的联系方式，获取完整版诊断分析（含详细学习建议+适龄工具推荐）</p>
    <input type="text" id="leadName" placeholder="你的称呼（选填）" />
    <input type="text" id="leadContact" placeholder="微信号 / 手机号（必填）" />
    <p style="font-size:11px;color:#999;margin:-4px 0 12px;">提交后你会收到《2025全球AI教育政策汇编》PDF + 诊断结果</p>
    <p style="font-size:12px;color:#888;margin:6px 0;">我们承诺严格保护您的隐私，不会向第三方分享您或孩子的信息</p>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:#666;margin:8px 0;cursor:pointer;white-space:nowrap;">
          <input type="checkbox" id="privacyAgree" style="width:16px;height:16px;flex-shrink:0;" />
          <span style="line-height:1.4;">我已阅读并同意以上隐私承诺</span>
        </label>
    <button class="lead-btn" onclick="submitLead()">✅ 免费领取报告</button>
    <button class="lead-close" onclick="closeLead()">跳过，直接看结果</button>
  </div>
</div>

<!-- 加载覆盖 -->
<div id="loadingOverlay" class="loading-overlay hidden">
  <div class="loading-spinner"></div>
</div>

<script is:inline>
// ===== 10道题数据 =====
const QUESTIONS = [
  {
    id: 1,
    title: '孩子多大？',
    options: [
      { text: '6-9岁（小学低年级）', scores: { explore: 0, apply: 0, create: 0 }, ageGroup: '6-9' },
      { text: '10-12岁（小学高年级）', scores: { explore: 0, apply: 0, create: 0 }, ageGroup: '10-12' },
      { text: '13-18岁（初中/高中）', scores: { explore: 0, apply: 0, create: 0 }, ageGroup: '13-18' },
    ]
  },
  {
    id: 2,
    title: '孩子拿到一个新工具，一般会？',
    options: [
      { text: '先翻来覆去研究，搞清楚每个按钮干嘛的', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '直接上手用，能达成目的就行', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '不太主动，需要人带着用', scores: { explore: 0, apply: 0, create: 1 } },
    ]
  },
  {
    id: 3,
    title: '如果孩子有机会用AI工具（如ChatGPT），你觉得TA最可能会？',
    options: [
      { text: '好奇追问"它是怎么做到的？"，想了解背后的原理', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '想用它完成任务——写作文、查资料、做PPT', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '想用它来画画、写故事、做点自己的作品', scores: { explore: 0, apply: 0, create: 2 } },
    ]
  },
  {
    id: 4,
    title: '孩子对动手做东西的态度是？',
    options: [
      { text: '非常喜欢——做手工、画画、搭积木、写小故事', scores: { explore: 0, apply: 0, create: 2 } },
      { text: '还行——不排斥，但也不会主动', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '不太感兴趣——更喜欢看书或看视频', scores: { explore: 1, apply: 0, create: 0 } },
    ]
  },
  {
    id: 5,
    title: '孩子使用电子设备的情况是？',
    options: [
      { text: '每天主动用，而且会自己探索新功能', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '主要在大人安排下使用（上网课、做作业）', scores: { explore: 0, apply: 1, create: 0 } },
      { text: '尽量限制，接触很少', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  },
  {
    id: 6,
    title: '孩子最近有没有问过你关于AI的问题？',
    options: [
      { text: '问过，比如"ChatGPT是什么？""AI会取代人类吗？"', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '听说过但没深入问过', scores: { explore: 0, apply: 1, create: 0 } },
      { text: '基本没提过', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  },
  {
    id: 7,
    title: '如果孩子拿到AI工具（如ChatGPT），你觉得他/她会？',
    options: [
      { text: '乱试各种问题，看看它能干嘛', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '在大人引导下用，解决具体问题', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '不知道怎么用，或不太感兴趣', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  },
  {
    id: 8,
    title: '你希望孩子通过AI学习获得什么？（选最优先的一项）',
    options: [
      { text: '保持好奇心和探索能力', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '掌握实用工具，提升学习效率', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '培养创造力和表达能力', scores: { explore: 0, apply: 0, create: 2 } },
    ]
  },
  {
    id: 9,
    title: '你平时对孩子使用科技产品的态度是？',
    options: [
      { text: '开放但有规则——用可以，但要约定时间', scores: { explore: 1, apply: 1, create: 1 } },
      { text: '比较谨慎——能不碰就不碰', scores: { explore: 0, apply: 0, create: 0 } },
      { text: '中立——随他用，反正也管不住', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  },
  {
    id: 10,
    title: '如果现在有一个免费的AI学习路线图，你最想解决的问题是什么？',
    options: [
      { text: '"我不懂AI，不知道怎么引导孩子"', scores: { explore: 1, apply: 0, create: 0 } },
      { text: '"孩子已经在接触AI，我想让她学得更系统"', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '"孩子对AI没兴趣，我想看看有没有必要推"', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  }
];

// ===== 结果模板 =====
const RESULTS = {
  explore: {
    icon: '\uD83D\uDD0D',
    label: '探索型',
    badge: '好奇心驱动',
    desc: '这个小发明家对世界充满好奇\u2014\u2014TA总是想知道"为什么"和"如果\u2026\u2026会怎样"。你的孩子是天生的探索者，喜欢自己发现规律。',
    mva: '打开一个免费AI问答工具（如豆包或文心一言），让孩子问它三个"为什么"的问题。观察TA的反应：是相信AI的答案还是会追问。这件事不需要任何准备，今晚就能做。',
    direction: 'AI工作原理科普、与ChatGPT对话实验、AI伦理小讨论',
    ageAdvice: {
      '6-9': 'AI故事 + AI小实验 + 简单的因果推理游戏',
      '10-12': 'AI原理科普（机器学习入门）+ 数据可视化小项目',
      '13-18': 'AI伦理讨论 + Python+AI入门 + 未来职业探索',
    },
    service: '我们提供"AI探索者家庭学习计划"，包含AI原理启蒙课程、亲子对话指南和适龄学习路径设计。从孩子的第一个AI实验开始，系统培养科学思维。',
    parentNote: '在AI时代，好奇心是孩子最宝贵的能力。您的角色不是回答所有问题，而是帮孩子找到探索AI的起点。我们可以一起构建这份学习计划。'
  },
  apply: {
    icon: '\uD83D\uDEE0\uFE0F',
    label: '应用型',
    badge: '实用主义导向',
    desc: '这个实用主义者不喜欢空谈\u2014\u2014TA更关心"这个东西能帮我做什么"。你的孩子注重效率和结果，善于用工具解决实际问题。',
    mva: '让孩子用AI辅助完成一件TA本周的学习任务（比如写作文提纲、整理知识点）。完成后问TA："AI帮了多大忙？哪些地方是AI做不了的？"——这能帮孩子理解AI是工具不是替代品。',
    direction: 'AI写作辅助、AI绘画工具、AI+学习效率',
    ageAdvice: {
      '6-9': '图形化AI工具 + AI辅助画画/写故事',
      '10-12': 'AI辅助学习工具 + 零代码AI项目入门',
      '13-18': 'AI高效学习技巧 + 项目实践（用AI做个作品）',
    },
    service: '我们提供"AI应用者赋能方案"，包含适龄AI工具清单、学习效能提升指南和应用型项目模板。帮孩子从"会用AI"到"用AI解决问题"。',
    parentNote: '您已经看到了AI作为实用工具的价值。接下来可以帮孩子聚焦一个具体问题，用AI去解决它。我们的方案可以帮您和孩子找到最合适的路径。'
  },
  create: {
    icon: '\uD83C\uDFA8',
    label: '创作型',
    badge: '表达者冲动',
    desc: '这个小创作者有表达的冲动\u2014\u2014TA需要的是工具，让想法变成作品。你的孩子善于将想象变成现实，具有强烈的自我表达欲望。',
    mva: '让孩子用AI画画工具（如文心一格）输入TA心中的一个场景，然后一起给画面想一个故事。目标是"用AI把脑子里的画面变成可以看到的东西"——这件事不需要任何技术基础。',
    direction: 'AI音乐创作、AI视频制作、AI绘本/故事生成',
    ageAdvice: {
      '6-9': 'AI绘画 + AI绘本制作 + 简单AI音乐创作',
      '10-12': 'AI视频入门 + AI音乐制作 + 数字艺术创作',
      '13-18': '完整创作项目 + 专业工具链 + 作品集搭建指导',
    },
    service: '我们提供"AI创作者成长计划"，包括AI创作工具入门指导、从想法到作品的项目流程和作品集打造建议。让孩子的表达力在AI时代充分释放。',
    parentNote: '创作是孩子理解世界的方式。AI可以帮孩子跨越技术门槛，把脑洞变成真正的作品。我们的计划能帮您为孩子找到合适的创作起点。'
  }
};

// ===== 状态 =====
let currentStep = -1; // -1 = 开始页
let answers = {};
let result = null;
let leadSubmitted = false;

// ===== DOM引用 =====
const cardArea = document.getElementById('cardArea');
const progressBar = document.getElementById('progressBar');
const loadingOverlay = document.getElementById('loadingOverlay');

// ===== 渲染 =====

function renderProgress() {
  if (currentStep < 0) {
    progressBar.innerHTML = '';
    return;
  }
  progressBar.innerHTML = QUESTIONS.map((q, i) => {
    let cls = 'dot';
    if (i < currentStep) cls += ' done';
    else if (i === currentStep) cls += ' active';
    return `<div class="${cls}"></div>`;
  }).join('');
}

function renderStart() {
  currentStep = -1;
  progressBar.innerHTML = '';
  cardArea.innerHTML = `
    <div class="card fade-in" style="padding:32px 24px;">
      <div class="hero-icon">🔍🧠🎨</div>
      <div class="hero-desc">
        <strong>10道选择题</strong>，帮你回答那个让你焦虑的问题：
        <br/>
        「<strong>我的孩子该学什么AI</strong>？」
      </div>

      <div class="feature-list">
        <div class="feature-item">
          <span class="feature-icon">🔬</span>
          <span><strong>科学分型</strong> — 基于认知行为特征，将孩子划分为三种AI学习类型</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">🎯</span>
          <span><strong>分龄建议</strong> — 6-9岁 / 10-12岁 / 13-18岁，每年龄段不同指导</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">⚡</span>
          <span><strong>30秒出结果</strong> — 完成即得个性化学习建议</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">📊</span>
          <span><strong>得分可视化</strong> — 三种倾向的百分比对比，不只一个标签</span>
        </div>
      </div>

      <button class="start-btn" onclick="startQuiz()">
        🚀 开始诊断
      </button>
      <p style="text-align:center;font-size:12px;color:#999;">已完成问卷将获得《2025全球AI教育政策汇编》PDF</p>
    </div>
  `;
}

function startQuiz() {
  currentStep = 0;
  answers = {};
  renderQuestion(0);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function renderQuestion(step) {
  if (step >= QUESTIONS.length) {
    showResult();
    return;
  }
  const q = QUESTIONS[step];
  const selected = answers[q.id];

  renderProgress();

  cardArea.innerHTML = `
    <div class="card fade-in">
      <div class="q-number">第 ${step + 1} / 10 题</div>
      <div class="q-title">${q.title}</div>
      <div class="options">
        ${q.options.map((opt, i) => `
          <button class="option ${selected === i ? 'selected' : ''}" 
                  data-opt-index="${i}"
                  onclick="selectOption(${step}, ${i})">
            ${opt.text}
          </button>
        `).join('')}
      </div>
      <div class="btn-row">
        ${step > 0 ? '<button class="btn btn-secondary" onclick="prevStep()">\u2190 上一题</button>' : '<div></div>'}
        <button class="btn btn-primary" id="nextBtn" ${selected === undefined ? 'disabled' : ''} 
                onclick="nextStep()">
          ${step < QUESTIONS.length - 1 ? '下一步 \u2192' : '\uD83D\uDCCA 查看结果'}
        </button>
      </div>
    </div>
  `;
}

// ===== 逻辑 =====

function selectOption(step, optIndex) {
  const q = QUESTIONS[step];
  answers[q.id] = optIndex;

  document.querySelectorAll('.option').forEach((btn, i) => {
    btn.classList.toggle('selected', i === optIndex);
  });

  document.getElementById('nextBtn').disabled = false;
}

function nextStep() {
  if (currentStep < QUESTIONS.length - 1) {
    currentStep++;
    renderQuestion(currentStep);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  } else {
    // 查看结果前，先弹出留资（如果还没提交过）
    if (!leadSubmitted) {
      showLead();
    } else {
      calculateResult();
    }
  }
}

function prevStep() {
  if (currentStep > 0) {
    currentStep--;
    renderQuestion(currentStep);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function calculateResult() {
  loadingOverlay.classList.remove('hidden');

  let scores = { explore: 0, apply: 0, create: 0 };
  let ageGroup = '10-12';

  QUESTIONS.forEach((q, i) => {
    const ansIdx = answers[q.id];
    if (ansIdx === undefined) return;
    const opt = q.options[ansIdx];
    if (opt.ageGroup) ageGroup = opt.ageGroup;
    scores.explore += (opt.scores.explore || 0);
    scores.apply += (opt.scores.apply || 0);
    scores.create += (opt.scores.create || 0);
  });

  // 计算百分比（基于各维度的最大可能得分）
  const maxExplore = QUESTIONS.reduce((m, q) => {
    const maxOpt = Math.max(...q.options.map(o => o.scores.explore || 0));
    return m + maxOpt;
  }, 0);
  const maxApply = QUESTIONS.reduce((m, q) => {
    const maxOpt = Math.max(...q.options.map(o => o.scores.apply || 0));
    return m + maxOpt;
  }, 0);
  const maxCreate = QUESTIONS.reduce((m, q) => {
    const maxOpt = Math.max(...q.options.map(o => o.scores.create || 0));
    return m + maxOpt;
  }, 0);

  // 判定主要类型
  let type;
  if (scores.explore >= scores.apply && scores.explore >= scores.create) type = 'explore';
  else if (scores.apply >= scores.create) type = 'apply';
  else type = 'create';

  const pctExplore = Math.round((scores.explore / maxExplore) * 100);
  const pctApply = Math.round((scores.apply / maxApply) * 100);
  const pctCreate = Math.round((scores.create / maxCreate) * 100);

  // 副类型检测
  let secondaryType = null;
  const sorted = [
    { key: 'explore', pct: pctExplore },
    { key: 'apply', pct: pctApply },
    { key: 'create', pct: pctCreate },
  ].sort((a, b) => b.pct - a.pct);
  if (sorted[1].pct >= sorted[0].pct * 0.7 && sorted[1].pct > 35) {
    secondaryType = sorted[1].key;
  }

  result = { type, secondaryType, ageGroup, scores, pct: { explore: pctExplore, apply: pctApply, create: pctCreate } };

  setTimeout(() => {
    loadingOverlay.classList.add('hidden');
    renderResult();
  }, 400);
}

// 显示历史对比（如果有）
function renderComparison() {
  try {
    var histData = JSON.parse(localStorage.getItem('diagnosis_results_history') || '[]');
    if (histData.length < 2) return '';
    var last = histData[histData.length - 2];
    var labelMap = { explore: '🔍探索型', apply: '🛠️应用型', create: '🎨创作型' };
    return '<div class="result-section" style="background:#fff8e1;padding:16px;border-radius:10px;margin:12px 0;">' +
      '<h3 style="margin-top:0;">🔄 与上次结果对比</h3>' +
      '<p style="font-size:13px;color:#555;">上次诊断: ' + (labelMap[last.type] || last.type) + ' | ' +
      '探索' + last.pct.explore + '% / 应用' + last.pct.apply + '% / 创作' + last.pct.create + '%</p>' +
      '<p style="font-size:13px;color:#555;margin:4px 0 0;">📈 孩子的AI学习倾向会随着接触AI工具的变化而改变。建议每3个月重新诊断一次，追踪成长轨迹。</p>' +
      '</div>';
  } catch(e) { return ''; }
}

function renderResult() {
  const r = RESULTS[result.type];
  const ageKey = result.ageGroup;
  const ageAdviceText = r.ageAdvice[ageKey] || r.ageAdvice['10-12'];
  const ageLabel = { '6-9': '6-9岁', '10-12': '10-12岁', '13-18': '13-18岁' }[ageKey] || '10-12岁';

  progressBar.innerHTML = QUESTIONS.map(() => `<div class="dot done"></div>`).join('');

  // 构建分数条
  const scores = [
    { key: 'explore', label: '探索型 ' + RESULTS.explore.icon, pct: result.pct.explore },
    { key: 'apply', label: '应用型 ' + RESULTS.apply.icon, pct: result.pct.apply },
    { key: 'create', label: '创作型 ' + RESULTS.create.icon, pct: result.pct.create },
  ];

  cardArea.innerHTML = `
    <div class="card fade-in" style="text-align:left;">
      <div class="result-type">${r.icon}</div>
