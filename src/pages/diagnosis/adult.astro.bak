---
// English Adult "AI职场力诊断"
// 26-question quiz → 8-dimension 3-tier scoring → "Action of the Day" → Paywall
// Pure frontend, no API dependency
//

export const prerender = true;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI职场力诊断 — humanaifit</title>
  <meta name="description" content="26 questions, 8 dimensions: assess your true AI competitiveness at work. Free, no registration." />
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif; background:#f8f7f4; color:#1a1a1a; }
    .container { max-width:640px; margin:0 auto; padding:20px 16px; }
    .page { animation:fadeIn 0.25s ease; }
    @keyframes fadeIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
    .hero-icon { font-size:48px; text-align:center; margin:40px 0 12px; }
    .hero-desc { text-align:center; font-size:15px; color:#555; line-height:1.8; margin-bottom:24px; }
    .feature-list { margin:20px 0; }
    .feature-item { display:flex; align-items:center; gap:10px; margin-bottom:14px; font-size:14px; color:#444; line-height:1.5; }
    .feature-item span strong { color:#0F2B46; }
    .btn-start {
      display:block; width:100%; padding:16px; background:linear-gradient(135deg,#0F2B46,#1a3f64); color:#fff;
      border:none; border-radius:12px; font-size:18px; font-weight:700; cursor:pointer; transition:transform .15s;
      margin:24px 0 12px;
    }
    .btn-start:hover { transform:scale(1.02); }
    .btn-start:active { transform:scale(0.98); }
    .free-tag { text-align:center; font-size:13px; color:#999; }
    .quiz-header { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
    .q-progress-text { font-size:14px; color:#666; flex-shrink:0; }
    .progress-track { flex:1; height:6px; background:#e5e7eb; border-radius:3px; overflow:hidden; }
    .progress-fill { height:100%; background:#3b82f6; border-radius:3px; transition:width .3s; }
    .q-card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:24px; margin-bottom:16px; }
    .stem { font-size:18px; line-height:1.6; margin:0 0 24px; font-weight:500; color:#1a1a1a; }
    .options { display:flex; flex-direction:column; gap:8px; }
    .option {
      display:flex; align-items:center; gap:12px; padding:12px 16px; border:1px solid #e5e7eb;
      border-radius:8px; cursor:pointer; transition:all .15s; font-size:16px; color:#333;
    }
    .option:hover { background:#f5f5f5; }
    .option.selected { background:#e8f4fd; border-color:#3b82f6; border-left:3px solid #3b82f6; }
    .option-radio { font-size:20px; color:#3b82f6; width:20px; text-align:center; }
    .q-footer-text { text-align:center; font-size:12px; color:#999; margin-top:12px; }
    .nav-btns { display:flex; justify-content:space-between; gap:12px; }
    .btn { padding:12px 24px; border-radius:8px; border:none; font-size:16px; font-weight:600; cursor:pointer; transition:all .15s; }
    .btn:disabled { opacity:0.4; cursor:not-allowed; }
    .btn-pri { background:#3b82f6; color:#fff; }
    .btn-pri:hover:not(:disabled) { background:#2563eb; }
    .btn-sec { background:#f5f5f5; color:#333; }
    .btn-sec:hover:not(:disabled) { background:#e5e7eb; }
    .result-container { padding-bottom:60px; }
    .result-title { font-size:22px; text-align:center; margin:20px 0; color:#0F2B46; }
    .layer-block { margin-bottom:24px; }
    .layer-header {
      padding:8px 12px; background:#f0f0f0; border-radius:6px;
      font-size:13px; color:#666; font-weight:600; margin-bottom:8px;
    }
    .dim-row {
      display:flex; align-items:center; gap:10px; padding:6px 8px; margin-bottom:4px;
    }
    .dim-name { width:90px; font-size:14px; color:#333; font-weight:500; flex-shrink:0; }
    .dim-bar-bg { flex:1; height:14px; background:#e5e7eb; border-radius:7px; overflow:hidden; }
    .dim-bar-fill { height:100%; border-radius:7px; transition:width .8s ease; }
    .dim-score { width:44px; text-align:right; font-size:14px; font-weight:600; color:#1a1a1a; flex-shrink:0; }
    .dim-badge { font-size:11px; width:24px; text-align:center; flex-shrink:0; }
    .layer-total { font-size:13px; color:#888; text-align:right; margin-bottom:6px; }
    .layer-total strong { color:#333; }
    .weakness-box {
      background:#f0f9ff; border:1px solid #bae6fd; border-radius:12px; padding:16px; margin:20px 0;
      text-align:center;
    }
    .weakness-box h3 { font-size:16px; color:#0F2B46; margin-bottom:4px; }
    .weakness-box p { font-size:14px; color:#555; }
    .cta-box {
      background:#f0f9ff; border:1px solid #bae6fd; border-radius:12px; padding:20px; margin:20px 0; text-align:center;
    }
    .cta-box h3 { font-size:16px; margin-bottom:6px; color:#0F2B46; }
    .cta-box p { font-size:14px; color:#555; margin-bottom:12px; line-height:1.6; }
    .cta-prompt-box {
      background:#fff; border:1px solid #d1d5db; border-radius:8px; padding:12px; margin:12px 0;
      font-size:14px; color:#333; text-align:left;
    }
    .cta-btn { padding:12px 24px; border-radius:8px; border:none; font-size:15px; font-weight:600; cursor:pointer; margin:4px; }
    .cta-btn-blue { background:#3b82f6; color:#fff; }
    .cta-btn-blue:hover { background:#2563eb; }
    .cta-btn-green { background:#22c55e; color:#fff; }
    .cta-btn-green:hover { background:#16a34a; }
    .cta-btn-ghost { background:transparent; color:#3b82f6; border:1px solid #3b82f6; }
    .paywall {
      background:#fff; border:2px solid #C9A96E; border-radius:12px; padding:20px; margin:20px 0; text-align:center;
    }
    .paywall h3 { font-size:18px; color:#0F2B46; margin-bottom:4px; }
    .paywall .price { font-size:28px; font-weight:700; color:#C9A96E; margin:8px 0; }
    .paywall ul { list-style:none; padding:0; margin:12px 0; font-size:13px; color:#555; text-align:left; }
    .paywall ul li { padding:4px 0; padding-left:20px; position:relative; }
    .paywall ul li::before { content:'✅'; position:absolute; left:0; }
    .feedback-ring { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:16px; margin:16px 0; }
    .feedback-ring h4 { font-size:15px; margin-bottom:8px; }
    .feedback-btn { display:block; width:100%; padding:12px; border:1px solid #ddd; border-radius:8px; margin:6px 0; font-size:14px; cursor:pointer; background:#f9fafb; text-align:left; }
    .feedback-btn:hover { background:#f0f0f0; }
    .transition-page { text-align:center; padding:40px 16px; }
    .transition-page h2 { font-size:22px; color:#0F2B46; margin:16px 0; }
    .transition-page p { font-size:15px; color:#555; line-height:1.8; margin-bottom:20px; }
    @media(max-width:480px) {
      .dim-name { width:70px; font-size:12px; }
      .dim-score { width:36px; font-size:12px; }
      .stem { font-size:16px; }
      .option { font-size:14px; }
    }
  </style>
</head>
<body>
  <main id="app">
    <!-- Start Page -->
    <div id="start-page" class="page">
      <div class="container">
        <div class="hero-icon">📊</div>
        <h1>AI职场力诊断</h1>
        <p class="hero-desc"><strong>26 multiple-choice questions</strong> across 8 dimensions to assess your true AI competitiveness at work.</p>
        <div class="feature-list">
          <div class="feature-item">🧩 <span><strong>8维全面评估</strong> — 从工具力到元认知</span></div>
          <div class="feature-item">📊 <span><strong>三层可视化</strong> — 基础层 / 进阶层 / 领导层</span></div>
          <div class="feature-item">⚡ <span><strong>10分钟完成</strong> — Instant feedback at every step</span></div>
          <div class="feature-item">🎯 <span><strong>首次行动</strong> — 看完结果就知道今天做什么</span></div>
          <div class="feature-item">🎓 <span><strong>三步行动</strong> — 复制 → 尝试 → 分享</span></div>
        </div>
        <button id="start-btn" class="btn-start">开始诊断 →</button>
        <p class="free-tag">免费 · 无需注册</p>
      </div>
    </div>

    <!-- Quiz Page -->
    <div id="quiz-page" class="page" style="display:none">
      <div class="container">
        <div class="quiz-header">
          <span id="q-progress" class="q-progress-text">Q 1</span>
          <div class="progress-track"><div id="q-progress-fill" class="progress-fill" style="width:5%"></div></div>
        </div>
        <div id="q-card" class="q-card"></div>
        <div class="nav-btns">
          <button id="prev-btn" class="btn btn-sec" disabled>← 上一题</button>
          <button id="next-btn" class="btn btn-pri" disabled>下一题 →</button>
        </div>
      </div>
    </div>

    <!-- Result Page -->
    <div id="result-page" class="page" style="display:none">
      <div class="container result-container">
        <h2 class="result-title">📊 Your AI职场力诊断 Report</h2>
        <div id="result-content"></div>
      </div>
    </div>
  </main>

  <!-- Payment modal -->
  <div id="payment-overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:10000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:24px;max-width:380px;width:90%;text-align:center;position:relative;">
      <button onclick="closeAdultPayment()" style="position:absolute;top:12px;right:16px;background:none;border:none;font-size:20px;cursor:pointer;color:#999;">✕</button>
      
      <!-- Tier selection -->
      <div id="pay-tier-selection">
        <!-- Tier 1: $29 Report -->
        <div onclick="showAdultPayTier('report')" style="border:2px solid #e5e7eb;border-radius:12px;padding:16px;margin-bottom:12px;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.borderColor='#3b82f6'" onmouseout="this.style.borderColor='#e5e7eb'">
          <h3 style="font-size:16px;color:#0F2B46;margin:0 0 4px;">📋 完整诊断报告</h3>
          <p style="font-size:28px;font-weight:700;color:#C9A96E;margin:4px 0;">$29</p>
          <ul style="list-style:none;padding:0;margin:4px 0;font-size:12px;color:#555;text-align:left;display:inline-block;">
            <li>✅ 8维完整得分 + 对比分析</li>
            <li>✅ W1-W4完整行动卡</li>
            <li>✅ 同龄同行业对比</li>
            <li>✅ 具体短板提升方案</li>
          </ul>
        </div>

        <!-- Tier 2: $199/year 知识星球 -->
        <div onclick="showAdultPayTier('planet')" style="border:2px solid #C9A96E;border-radius:12px;padding:16px;margin-bottom:12px;cursor:pointer;background:#fffbf0;transition:all 0.2s;" onmouseover="this.style.borderColor='#0F2B46'" onmouseout="this.style.borderColor='#C9A96E'">
          <h3 style="font-size:16px;color:#0F2B46;margin:0 0 4px;">🌟 《AI时代生存手册》知识星球</h3>
          <p style="font-size:28px;font-weight:700;color:#C9A96E;margin:4px 0;">$199<span style="font-size:14px;font-weight:400;color:#888;">/year</span></p>
          <ul style="list-style:none;padding:0;margin:4px 0;font-size:12px;color:#555;text-align:left;display:inline-block;">
            <li>✅ 送完整诊断报告</li>
            <li>📌 Planet ID: 43035986</li>
            <li>✅ 全年行动卡持续推送</li>
            <li>✅ 每月线上工作坊</li>
            <li>✅ 社群交流 + 专家答疑</li>
            <li>🎁 试运营限50人</li>
          </ul>
        </div>
      </div>

      <!-- Payment detail -->
      <div id="pay-tier-detail" style="display:none;">
        <h3 id="pay-detail-title" style="font-size:18px;color:#0F2B46;margin:0 0 4px;"></h3>
        <p id="pay-detail-price" style="font-size:28px;font-weight:700;color:#C9A96E;margin:12px 0 4px;"></p>
        <p style="font-size:13px;color:#666;margin-bottom:8px;">微信扫码支付</p>
        <img src="/images/wechat_pay.jpg" alt="WeChat Pay QR code" style="width:180px;height:180px;object-fit:cover;border-radius:8px;" />
        <p style="font-size:12px;color:#e65100;margin:8px 0 4px;">💬 付款后联系微信</p>
        <p style="font-size:12px;color:#555;margin-bottom:4px;">长按复制微信ID：</p>
        <div style="background:#f5f5f5;padding:8px;border-radius:6px;font-size:14px;font-weight:600;color:#0F2B46;margin:4px 0;text-align:center;cursor:pointer;" onclick="navigator.clipboard.writeText('blurblurfish');alert('WeChat ID copied')">blurblurfish</div>
        <p style="font-size:11px;color:#999;margin-top:8px;">扫码付款后加微信发送付款截图，人工开通。</p>
        <button onclick="showAdultPayBack()" style="margin-top:8px;padding:6px 16px;background:none;border:none;font-size:13px;color:#3b82f6;cursor:pointer;">← 返回选择</button>
      </div>
    </div>
  </div>

  <!-- Question bank data -->
  <script id="adult-questions-data" type="application/json">[{"id": "AC-AI-TC-E-001", "version": "adult", "dimension": "ai_tool_competency", "difficulty": "easy", "stem": "You're new to AI and want it to help you write a work email. How would you phrase your instruction?", "options": [{"id": "A", "text": "Help me write an email", "score": 1}, {"id": "B", "text": "Write an email to a client about a project delay, with a sincere tone while remaining professional", "score": 4}, {"id": "C", "text": "Write email", "score": 2}, {"id": "D", "text": "I wouldn't use AI to write emails", "score": 0}], "theoreticalBasis": "TTF Framework (Goodhue & Thompson, 1995)"}, {"id": "AC-AI-TC-M-002", "version": "adult", "dimension": "ai_tool_competency", "difficulty": "medium", "stem": "You need to (1) organize meeting minutes, (2) create a data analysis chart, and (3) make illustrations for a PPT. Which tools would you use for each task?", "options": [{"id": "A", "text": "Use one AI tool for everything", "score": 1}, {"id": "B", "text": "Notion AI for meeting minutes, Claude + Excel for charts, Midjourney for illustrations", "score": 4}, {"id": "C", "text": "Use common software and do it all manually", "score": 2}, {"id": "D", "text": "I don't know what tools are available", "score": 0}], "theoreticalBasis": "AI Tool Ecosystem Awareness"}, {"id": "AC-DD-DM-E-001", "version": "adult", "dimension": "data_decision", "difficulty": "easy", "stem": "AI says: \"According to data analysis, 90% of customer satisfaction comes from price advantage.\" What's your take?", "options": [{"id": "A", "text": "It's backed by data, so it's trustworthy", "score": 1}, {"id": "B", "text": "I want to know the data source, sample size, and how customers were selected", "score": 4}, {"id": "C", "text": "Not sure, but I can't be bothered to dig deeper", "score": 2}, {"id": "D", "text": "I think AI is making things up", "score": 0}], "theoreticalBasis": "Critical Thinking (Facione, 1990)"}, {"id": "AC-DD-DM-M-002", "version": "adult", "dimension": "data_decision", "difficulty": "medium", "stem": "AI built a prediction model based on last year's monthly sales data. What should you check most before using it?", "options": [{"id": "A", "text": "Whether the data range covers special dates like holidays", "score": 4}, {"id": "B", "text": "Whether the decimal places of the predictions are accurate", "score": 1}, {"id": "C", "text": "Whether the chart colors look 良好", "score": 0}, {"id": "D", "text": "What programming language AI used to write the code", "score": 2}], "theoreticalBasis": "Data Literacy (Mandinach & Gummer, 2016)"}, {"id": "AC-WF-DS-E-001", "version": "adult", "dimension": "workflow_design", "difficulty": "easy", "stem": "You have to write a weekly report. Which division of labor makes the most sense?", "options": [{"id": "A", "text": "Let AI do all of it", "score": 1}, {"id": "B", "text": "I set up the data framework → AI fills in details → I review", "score": 4}, {"id": "C", "text": "I write it → AI polishes the wording", "score": 3}, {"id": "D", "text": "Don't consider using AI at all", "score": 0}], "theoreticalBasis": "Task-Technology Fit"}, {"id": "AC-WF-DS-M-002", "version": "adult", "dimension": "workflow_design", "difficulty": "medium", "stem": "A full market research task: ① Define research direction → ② Collect data → ③ Analyze data → ④ Write report → ⑤ Present findings. Which steps are most suitable for AI assistance?", "options": [{"id": "A", "text": "②③④ (Data collection + analysis + report writing)", "score": 4}, {"id": "B", "text": "All of them", "score": 2}, {"id": "C", "text": "Only ④ (Write report)", "score": 1}, {"id": "D", "text": "None are suitable", "score": 0}], "theoreticalBasis": "Human-AI Division Strategy"}, {"id": "AC-AI-CR-M-001", "version": "adult", "dimension": "ai_creativity", "difficulty": "medium", "stem": "You're using AI to write product copy, but all the generated versions feel \"too AI-like.\" How would you improve?", "options": [{"id": "A", "text": "Have AI generate more versions until I see one I like", "score": 2}, {"id": "B", "text": "Give AI a specific brand tone reference (e.g., 'Tone like Apple ad copy')", "score": 4}, {"id": "C", "text": "Give up on AI and write it myself", "score": 1}, {"id": "D", "text": "Try a different AI tool", "score": 0}], "theoreticalBasis": "Human-AI Co-Creation (Davis, 2024)"}, {"id": "AC-AI-CR-M-002", "version": "adult", "dimension": "ai_creativity", "difficulty": "medium", "stem": "AI generated a proposal, but you feel the direction is off. What's the best course of action?", "options": [{"id": "A", "text": "Keep the AI content and submit it as is", "score": 1}, {"id": "B", "text": "Delete AI's content and redo it myself", "score": 2}, {"id": "C", "text": "Tell AI 'You're going in the wrong direction, go back and rethink from XX angle'", "score": 4}, {"id": "D", "text": "Switch to another tool and regenerate", "score": 0}], "theoreticalBasis": "Iterative Prompt Engineering"}, {"id": "AC-AI-JD-M-001", "version": "adult", "dimension": "ai_judgment", "difficulty": "medium", "stem": "AI says: \"According to 2025 WHO data, the global depression rate has risen by 15%.\" What would you do?", "options": [{"id": "A", "text": "WHO data should be reliable, so I'll cite it directly", "score": 1}, {"id": "B", "text": "Search 'WHO 2025 depression' to verify the data first", "score": 4}, {"id": "C", "text": "Feel something is off but can't explain why", "score": 2}, {"id": "D", "text": "Trust that AI wouldn't make things up", "score": 0}], "theoreticalBasis": "AI Output Credibility Assessment"}, {"id": "AC-AI-JD-M-002", "version": "adult", "dimension": "ai_judgment", "difficulty": "medium", "stem": "You used AI to generate a competitive analysis report and found that AI incorrectly cited a company's internal data. What would you do?", "options": [{"id": "A", "text": "No one else will know, just use it as is", "score": 0}, {"id": "B", "text": "Edit out the inaccurate data and continue using the rest", "score": 2}, {"id": "C", "text": "Add a note in the report: 'This data cannot be verified and is for reference only'", "score": 3}, {"id": "D", "text": "Discard the entire report", "score": 4}], "theoreticalBasis": "AI Ethics (Floridi et al., 2018)"}, {"id": "AC-HA-CL-M-001", "version": "adult", "dimension": "human_ai_collab", "difficulty": "medium", "stem": "Time is tight and you need to simultaneously: ① Think through strategic direction, ② Write meeting minutes, ③ Create data charts. How do you divide work between yourself and AI?", "options": [{"id": "A", "text": "Do it all myself — AI is unreliable", "score": 1}, {"id": "B", "text": "AI does ①②③ — AI can handle anything", "score": 0}, {"id": "C", "text": "I think through strategy → AI writes meeting minutes + AI generates charts → I review", "score": 4}, {"id": "D", "text": "Ask a colleague to help share the load", "score": 2}], "theoreticalBasis": "Human-AI Division Principles"}, {"id": "AC-HA-CL-M-002", "version": "adult", "dimension": "human_ai_collab", "difficulty": "medium", "stem": "AI wrote a proposal, but the content direction is off — not what you wanted. What's your first reaction?", "options": [{"id": "A", "text": "First figure out: Did I give unclear instructions, or is AI inherently unable to handle this problem?", "score": 4}, {"id": "B", "text": "Rewrite the prompt", "score": 3}, {"id": "C", "text": "Switch to a different AI tool and ask again", "score": 1}, {"id": "D", "text": "Forget it, I'll write it myself", "score": 0}], "theoreticalBasis": "In-Process Metacognition"}, {"id": "AC-AI-ST-M-001", "version": "adult", "dimension": "ai_strategy", "difficulty": "medium", "stem": "You heard that 'AI agents will replace a large number of customer service positions by 2027.' What's your assessment?", "options": [{"id": "A", "text": "It must be true — technology is advancing too fast", "score": 1}, {"id": "B", "text": "Analyze which parts of customer service can be automated and which require human involvement", "score": 4}, {"id": "C", "text": "Not sure", "score": 2}, {"id": "D", "text": "It has nothing to do with me", "score": 0}], "theoreticalBasis": "Critical Analysis of Technology Trends"}, {"id": "AC-AI-ST-H-002", "version": "adult", "dimension": "ai_strategy", "difficulty": "hard", "stem": "Your company needs to set an 'AI + Business' direction. Which strategy would you prioritize?", "options": [{"id": "A", "text": "Invest resources to build an AI Agent platform", "score": 1}, {"id": "B", "text": "Identify the 3 most repetitive and error-prone processes in current operations and optimize them with AI first", "score": 4}, {"id": "C", "text": "Buy the hottest AI SaaS tools on the market for all employees", "score": 2}, {"id": "D", "text": "Wait for competitors to try first", "score": 0}], "theoreticalBasis": "Technology Adoption Theory (Rogers, 2003)"}, {"id": "AC-AI-SA-E-001", "version": "adult", "dimension": "ai_self_awareness", "difficulty": "easy", "stem": "You just finished writing a report with AI and closed the chat window. Can you clearly tell if the process went well or not?", "options": [{"id": "A", "text": "Yes — I can clearly distinguish which steps AI helped a lot and where it made things up", "score": 4}, {"id": "B", "text": "Roughly know AI helped, but can't clearly say where it did well or poorly", "score": 2}, {"id": "C", "text": "Not sure — I just closed it when I was done", "score": 1}, {"id": "D", "text": "I rarely reflect on how I use AI", "score": 0}], "theoreticalBasis": "Metacognition (Flavell, 1979)"}, {"id": "AC-AI-SA-E-002", "version": "adult", "dimension": "ai_self_awareness", "difficulty": "easy", "stem": "You have a new task that's different from what you usually do with AI. How do you decide 'what to delegate to AI and what to do yourself'?", "options": [{"id": "A", "text": "Analyze the task characteristics first, then judge what to give AI and what to keep based on the specific situation", "score": 4}, {"id": "B", "text": "I have a go-to method — AI produces a first draft, then I refine it", "score": 3}, {"id": "C", "text": "Give everything to AI and try — if it doesn't work, I'll take over", "score": 1}, {"id": "D", "text": "Do it all myself — I'm not confident using AI for new tasks", "score": 0}], "theoreticalBasis": "Strategy Adaptation"}, {"id": "AC-AI-SA-M-003", "version": "adult", "dimension": "ai_self_awareness", "difficulty": "medium", "stem": "If you were to rate your own AI proficiency (1-10), and then have a colleague who knows your work style rate you as well — what do you think the result would be?", "options": [{"id": "A", "text": "I'd guess what score my colleague would give, compare it with my self-assessment, and pay attention to areas with large gaps", "score": 4}, {"id": "B", "text": "They'd probably be close — not too far off", "score": 2}, {"id": "C", "text": "My colleague doesn't know how I use AI, so their rating wouldn't be accurate", "score": 1}, {"id": "D", "text": "Never thought about how others would rate my AI skills", "score": 0}], "theoreticalBasis": "Metacognitive Calibration"}, {"id": "AC-AI-SA-H-005", "version": "adult", "dimension": "ai_self_awareness", "difficulty": "hard", "stem": "After using AI for a while, you realize you have a genuine weakness in a certain area — like 'I never know how to get AI to do data analysis.' Which statement best describes what you would actually do?", "options": [{"id": "A", "text": "Review recent failed attempts, identify exactly which step I'm stuck on, then search for tutorials targeting that step", "score": 4}, {"id": "B", "text": "Set it aside for now — I'll search for a solution when the problem comes up again", "score": 2}, {"id": "C", "text": "Tell myself to try more next time — I'll get better with practice", "score": 3}, {"id": "D", "text": "This weakness doesn't really affect my work, so there's no rush to fix it", "score": 0}], "theoreticalBasis": "Metacognitive Learning Strategies"}, {"id": "AC-AI-TC-H-003", "version": "adult", "dimension": "ai_tool_competency", "difficulty": "hard", "stem": "You need to finish a competitive market research report in 2 hours, covering 10 competitors. How do you combine AI tools?", "options": [{"id": "A", "text": "Ask one AI to do everything", "score": 1}, {"id": "B", "text": "One AI for data search → another AI for comparison table → yourself for conclusion", "score": 4}, {"id": "C", "text": "Do most yourself, use AI only for polish", "score": 2}, {"id": "D", "text": "No AI, search and write manually", "score": 0}], "theoreticalBasis": "AI tool chain"}, {"id": "AC-DD-DM-H-003", "version": "adult", "dimension": "data_decision", "difficulty": "hard", "stem": "AI predicts 30% growth next quarter based on past 3 years data and suggests stocking up. What do you do?", "options": [{"id": "A", "text": "Trust the prediction and stock up 30%", "score": 1}, {"id": "B", "text": "Verify if the data includes recent market changes first", "score": 4}, {"id": "C", "text": "Ask AI to build a more complex model", "score": 3}, {"id": "D", "text": "Completely ignore the prediction", "score": 0}], "theoreticalBasis": "Data-driven decision validation"}, {"id": "AC-WF-DS-H-003", "version": "adult", "dimension": "workflow_design", "difficulty": "hard", "stem": "You start each day by: checking emails → responding messages → making slides → coding → scheduling meetings. How can AI Agents optimize this?", "options": [{"id": "A", "text": "One Agent handles everything", "score": 1}, {"id": "B", "text": "Design different Agents for different task types, then aggregate", "score": 4}, {"id": "C", "text": "Use AI assistants without building automation", "score": 2}, {"id": "D", "text": "Never heard of AI Agent", "score": 0}], "theoreticalBasis": "AI Agent architecture"}, {"id": "AC-AI-CR-H-003", "version": "adult", "dimension": "ai_creativity", "difficulty": "hard", "stem": "You need to create a complete brand story for a new product. How do you collaborate with AI?", "options": [{"id": "A", "text": "Let AI do everything", "score": 1}, {"id": "B", "text": "Brainstorm core concept first → ask AI for 3 directions → iterate → final manual review", "score": 4}, {"id": "C", "text": "Let AI make the first draft then edit", "score": 3}, {"id": "D", "text": "Create it completely on your own", "score": 0}], "theoreticalBasis": "Human-AI co-creation"}, {"id": "AC-AI-JD-H-003", "version": "adult", "dimension": "ai_judgment", "difficulty": "hard", "stem": "AI generated an employee performance ranking and gives layoff suggestions. What must you do first?", "options": [{"id": "A", "text": "Use the suggestion directly", "score": 1}, {"id": "B", "text": "Check if the ranking dimensions are fair and unbiased", "score": 4}, {"id": "C", "text": "Reference the AI suggestion but make your own decision", "score": 3}, {"id": "D", "text": "Don't use AI for HR decisions", "score": 0}], "theoreticalBasis": "AI ethics"}, {"id": "AC-HA-CL-H-003", "version": "adult", "dimension": "human_ai_collab", "difficulty": "hard", "stem": "Your colleague is resistant to AI, but you know it can save the team hours. What do you do?", "options": [{"id": "A", "text": "Use AI yourself and share results without mentioning AI", "score": 2}, {"id": "B", "text": "Pick a small task, demonstrate AI's effect, let them see it firsthand", "score": 4}, {"id": "C", "text": "Ask management to mandate AI usage", "score": 1}, {"id": "D", "text": "Respect their choice not to use AI", "score": 0}], "theoreticalBasis": "AI team collaboration"}, {"id": "AC-AI-ST-H-004", "version": "adult", "dimension": "ai_strategy", "difficulty": "hard", "stem": "Your team of 10 has a limited budget. Leadership wants a 30% efficiency boost via AI next quarter. How do you proceed?", "options": [{"id": "A", "text": "Purchase an enterprise AI tool and train everyone", "score": 2}, {"id": "B", "text": "Pick 2-3 high-repetition pain points, pilot small → verify → scale", "score": 4}, {"id": "C", "text": "Hire an AI expert to lead", "score": 1}, {"id": "D", "text": "Wait for more mature solutions", "score": 0}], "theoreticalBasis": "AI strategy evaluation"}]</script>

  <script is:inline>
(function() {
  const QUESTIONS = JSON.parse(document.getElementById('adult-questions-data').textContent);

  const DIMENSIONS = [
    { id:'ai_tool_competency', name:'AI Tool Competency', layer:'base', color:'#3b82f6' },
    { id:'data_decision', name:'Data-Driven Decision', layer:'base', color:'#3b82f6' },
    { id:'workflow_design', name:'Workflow Design', layer:'base', color:'#3b82f6' },
    { id:'ai_creativity', name:'AI Creativity', layer:'advanced', color:'#3b82f6' },
    { id:'ai_judgment', name:'AI Judgment', layer:'advanced', color:'#3b82f6' },
    { id:'human_ai_collab', name:'Human-AI Collab', layer:'advanced', color:'#3b82f6' },
    { id:'ai_strategy', name:'AI Strategy', layer:'leadership', color:'#3b82f6' },
    { id:'ai_self_awareness', name:'AI Self-Awareness', layer:'leadership', color:'#8b5cf6' },
  ];
  const LAYER_NAMES = { base:'Base Layer — AI-Enabled', advanced:'Advanced Layer — Co-creating with AI', leadership:'Leadership Layer — Steering AI' };
  const LAYER_ORDER = ['base','advanced','leadership'];

  let currentIndex = 0;
  const answers = {};
  let resultData = null;

  const $ = id => document.getElementById(id);
  const startPage = $('start-page');
  const quizPage = $('quiz-page');
  const resultPage = $('result-page');
  const qCard = $('q-card');
  const qProgress = $('q-progress');
  const qFill = $('q-progress-fill');
  const prevBtn = $('prev-btn');
  const nextBtn = $('next-btn');

  $('start-btn').addEventListener('click', () => {
    startPage.style.display = 'none';
    quizPage.style.display = 'block';
    currentIndex = 0;
    renderQuestion(0);
    updateButtons();
    window.scrollTo({top:0,behavior:'smooth'});
  });

  function renderQuestion(idx) {
    const q = QUESTIONS[idx];
    qCard.innerHTML = `<div class="stem">${q.stem}</div>
      <div class="options">${q.options.map(o =>
        `<div class="option ${answers[q.id]===o.id?'selected':''}" data-q="${q.id}" data-opt="${o.id}">
          <span class="option-radio">${answers[q.id]===o.id?'●':'○'}</span>
          <span>${o.text}</span>
        </div>`
      ).join('')}</div>
      <div class="q-footer-text">${QUESTIONS.length - idx - 1} more questions</div>`;
    qCard.querySelectorAll('.option').forEach(el => {
      el.addEventListener('click', () => {
        answers[el.dataset.q] = el.dataset.opt;
        renderQuestion(idx);
        updateButtons();
      });
    });
  }

  function updateButtons() {
    const q = QUESTIONS[currentIndex];
    prevBtn.disabled = currentIndex === 0;
    nextBtn.disabled = !answers[q.id];
    nextBtn.textContent = currentIndex < QUESTIONS.length - 1 ? '下一题 →' : '查看结果';
    qProgress.textContent = `Q ${currentIndex + 1} / ${QUESTIONS.length}`;
    qFill.style.width = `${((currentIndex + 1) / QUESTIONS.length) * 100}%`;
  }

  prevBtn.addEventListener('click', () => {
    if (currentIndex > 0) { currentIndex--; renderQuestion(currentIndex); updateButtons(); window.scrollTo({top:0,behavior:'smooth'}); }
  });

  nextBtn.addEventListener('click', () => {
    if (currentIndex < QUESTIONS.length - 1) {
      currentIndex++; renderQuestion(currentIndex); updateButtons(); window.scrollTo({top:0,behavior:'smooth'});
    } else {
      calculateAndShowResult();
    }
  });

  function calculateAndShowResult() {
    const dimScores = {};
    DIMENSIONS.forEach(d => { dimScores[d.id] = { total:0, weight:0 }; });

    QUESTIONS.forEach(q => {
      const optId = answers[q.id];
      if (!optId) return;
      const opt = q.options.find(o => o.id === optId);
      if (!opt) return;
      const weight = q.difficulty === 'hard' ? 2.0 : q.difficulty === 'medium' ? 1.5 : 1.0;
      const dim = q.dimension;
      if (dimScores[dim]) {
        dimScores[dim].total += opt.score * weight;
        dimScores[dim].weight += 4 * weight;
      }
    });

    const dimQuestionCount = {};
    QUESTIONS.forEach(q => {
      if (answers[q.id]) dimQuestionCount[q.dimension] = (dimQuestionCount[q.dimension]||0) + 1;
    });

    const dimensions = DIMENSIONS.map(d => {
      const raw = dimScores[d.id];
      let score = 0;
      if (raw && raw.weight > 0) score = Math.round((raw.total / raw.weight) * 100);
      score = Math.max(0, Math.min(100, score));
      const label = score >= 76 ? '优秀' : score >= 56 ? '良好' : '需提升';
      return { dimensionId: d.id, name: d.name, score, label, color: d.color, layer: d.layer };
    });

    const overallScore = Math.round(dimensions.reduce((s,d) => s + d.score, 0) / dimensions.length);
    const sorted = [...dimensions].sort((a,b) => a.score - b.score);
    const weakest = sorted[0];
    const strongest = sorted[sorted.length - 1];
    resultData = { dimensions, overallScore, weakest, strongest };
    quizPage.style.display = 'none';
    resultPage.style.display = 'block';
    renderResult();
    window.scrollTo({top:0,behavior:'smooth'});
  }

  function renderResult() {
    const rc = $('result-content');
    const d = resultData;
    let html = '';

    html += `<div style="text-align:center;margin-bottom:16px;">
      <div style="font-size:40px;font-weight:700;color:#0F2B46;">${d.overallScore}</div>
      <div style="font-size:14px;color:#888;">综合得分（满分100）</div>
    </div>`;

    LAYER_ORDER.forEach(layer => {
      const dims = d.dimensions.filter(dm => dm.layer === layer);
      if (dims.length === 0) return;
      const avgScore = Math.round(dims.reduce((s,dm) => s + dm.score, 0) / dims.length);
      html += `<div class="layer-block">
        <div class="layer-header">${LAYER_NAMES[layer]}  ${avgScore}/100</div>`;
      dims.forEach(dm => {
        const barColor = dm.score <= 30 ? '#ef4444' : dm.score <= 55 ? '#f59e0b' : dm.score <= 75 ? '#3b82f6' : '#22c55e';
        const isWeakest = dm.dimensionId === d.weakest.dimensionId;
        const isD08 = dm.dimensionId === 'ai_self_awareness';
        const barStyle = isD08
          ? `width:${dm.score}%;background:repeating-linear-gradient(0deg,${barColor},${barColor} 3px,transparent 3px,transparent 6px);`
          : `width:${dm.score}%;background:${barColor};`;
        html += `<div class="dim-row">
          <div class="dim-name">${isD08 ? '⭐ ' : ''}${dm.name}</div>
          <div class="dim-bar-bg"><div class="dim-bar-fill" style="${barStyle}"></div></div>
          <div class="dim-score">${dm.score}</div>
          <div class="dim-badge">${isWeakest ? '⚠️' : dm.score >= 76 ? '⭐' : ''}</div>
        </div>`;
      });
      html += '</div>';
    });

    html += `<div class="weakness-box">
      <h3>⚠️ 你最大的成长空间: ${d.weakest.name} (${d.weakest.score})</h3>
      <p>Start with "Action of the Day" — only 1 minute.</p>
    </div>`;

    html += `<div class="cta-box">
      <h3>📋 Action of the Day (1 min)</h3>
      <p>你最大的成长空间: ${d.weakest.name}<br>先做这件事试试：</p>
      <div class="cta-prompt-box">
        <strong>复制 this and paste into your AI tool:</strong><br>
        "Summarize in one sentence what AI means for my career in 2026"
        <button id="copy-prompt-btn" class="cta-btn cta-btn-blue" style="display:block;width:100%;margin-top:8px;">📋 复制</button>
      </div>
      <button id="step1-done-btn" class="cta-btn cta-btn-green" style="opacity:0.5;">✅ I did it</button>
      <button id="feedback-trigger-btn" class="cta-btn cta-btn-ghost">💬 Not happy with the result?</button>
      <p style="font-size:12px;color:#999;margin-top:8px;">完成后系统会解锁W1行动卡，帮助你提升短板。</p>
    </div>`;

    html += `<div class="paywall">
      <h3>🔒 完整诊断报告</h3>
      <div class="price">$29</div>
      <ul>
        <li>8维完整得分 + 对比分析</li>
        <li>W1-W4完整行动卡</li>
        <li>同龄同行业对比 (same industry & role)</li>
        <li>个性化提升方案</li>
      </ul>
      <button class="cta-btn cta-btn-blue" onclick="showAdultPayment()">立即购买 ¥29</button>
      <p style="font-size:12px;color:#999;margin-top:6px;">微信扫码支付 · Contact us after payment</p>
    </div>`;

    rc.innerHTML = html;
    bindResultEvents();
  }

  function bindResultEvents() {
    const copyBtn = $('copy-prompt-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('Summarize in one sentence what AI means for my career in 2026').then(() => {
          copyBtn.textContent = '✅ Copied';
          copyBtn.style.background = '#22c55e';
          $('step1-done-btn').style.opacity = '1';
        });
      });
    }
    const step1Btn = $('step1-done-btn');
    if (step1Btn) step1Btn.addEventListener('click', showTransition);
    const fbBtn = $('feedback-trigger-btn');
    if (fbBtn) fbBtn.addEventListener('click', showFeedback);
  }

  function showTransition() {
    const rc = $('result-content');
    rc.innerHTML = `
      <div class="transition-page">
        <div style="font-size:64px;margin-bottom:16px;">🎉</div>
        <h2>太好了！ 你已经迈出了第一步 in your AI growth journey</h2>
        <p>你刚刚复制了一段Prompt，看到了AI的回复。<br>
        Want to know:<br>
        <strong>"How do I make AI understand me better?"</strong><br>
        <strong>"How do I write better prompts?"</strong></p>
        <p>Next, you'll love this 👇</p>
        <div style="background:#f0f0f0;border-radius:12px;padding:20px;margin:24px 0;text-align:left;">
          <h3 style="font-size:16px;margin-bottom:8px;">📋 W1 Task: Write a "4-Element Prompt Template"</h3>
          <p style="font-size:13px;color:#666;margin-top:8px;">今天就能做（10分钟）:<br>打开AI工具, type:<br><strong>角色+格式+约束+示例 → 生成</strong></p>
        </div>
        <div style="background:#fff8e1;border-radius:12px;padding:16px;margin:16px 0;">
          <p style="font-size:13px;color:#333;">🔒 Full guide in the paid report ($29)<br>或者明天系统自动推送给你</p>
        </div>
        <button id="back-to-result-btn" class="cta-btn cta-btn-blue">返回报告</button>
        <button id="try-another-btn" class="cta-btn cta-btn-ghost" style="display:block;width:100%;margin-top:8px;">▼ Try a different prompt</button>
        <div id="try-another-area" style="display:none;margin-top:12px;">
          <div class="cta-prompt-box">
            <strong>试试这个：</strong><br>
            "Describe AI's impact on my career in 3 words, each with an example"
            <button id="copy2-btn" class="cta-btn cta-btn-blue" style="display:block;width:100%;margin-top:8px;">📋 复制</button>
          </div>
        </div>
        <button id="share-btn" class="cta-btn cta-btn-ghost" style="display:block;width:100%;margin-top:8px;">📤 分享 to social (anonymous radar)</button>
      </div>`;
    $('back-to-result-btn').addEventListener('click', renderResult);
    $('try-another-btn').addEventListener('click', () => {
      const area = $('try-another-area');
      area.style.display = area.style.display === 'none' ? 'block' : 'none';
    });
    const copy2 = $('copy2-btn');
    if (copy2) copy2.addEventListener('click', () => {
      navigator.clipboard.writeText("Describe AI's impact on my career in 3 words, each with an example").then(() => copy2.textContent = '✅ Copied');
    });
    const shareBtn = $('share-btn');
    if (shareBtn) shareBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('I just completed the AI职场力诊断 — 20 questions across 8 dimensions. Try it: https://www.humanaifit.com/en/diagnosis/adult/').then(() => alert('Copied! 分享 it on social.'));
    });
    window.scrollTo({top:0,behavior:'smooth'});
  }

  let feedbackLevel = 0;
  function showFeedback() {
    const rc = $('result-content');
    rc.innerHTML = '<div class="feedback-ring"><h4>换一种方式试试</h4><p style="font-size:13px;color:#555;margin-bottom:12px;">在你的提示词后面加上：<br><strong>"Explain in detail with a concrete example"</strong></p><button id="fb-retry-btn" class="cta-btn cta-btn-blue">✅ Auto-add and copy</button><button id="fb-level2-btn" class="cta-btn cta-btn-ghost" style="display:block;width:100%;margin-top:8px;">↓ Still not right? Other options</button></div>';
    $('fb-retry-btn').addEventListener('click', () => {
      navigator.clipboard.writeText('Explain in detail with a concrete example').then(() => alert('Copied! Paste into your AI tool.'));
    });
    $('fb-level2-btn').addEventListener('click', () => {
      rc.innerHTML = '<div class="feedback-ring"><h4>遇到什么问题了？</h4><div><button class="feedback-btn" onclick="alert(\'Try DeepSeek/ChatGPT/Claude\')">🔧 AI tool not working</button><button class="feedback-btn" onclick="alert(\'复制 this and ask AI to explain\')">🔧 Output is confusing</button><button class="feedback-btn" onclick="alert(\'Here are more examples to try\')">🔧 Not sure what to do next</button><button class="feedback-btn" onclick="showLevel3()">🔧 Other issues</button></div></div>';
    });
    window.scrollTo({top:0,behavior:'smooth'});
  }

  window.showLevel3 = function() {
    const rc = $('result-content');
    rc.innerHTML = '<div class="feedback-ring" style="text-align:center;"><h4>💬 仍然卡住了？</h4><p style="font-size:13px;color:#555;margin:12px 0;">加入AI职场社群<br>联系微信 blurblurfish</p><div style="background:#f0f0f0;border-radius:8px;padding:24px;margin:16px 0;font-size:12px;color:#888;">[QR code placeholder - WeChat: blurblurfish]</div><p style="font-size:12px;color:#999;font-style:italic;">"Your biggest competitive advantage is not in AI. It is between you and AI."</p><button class="cta-btn cta-btn-ghost" onclick="renderResult()" style="margin-top:12px;">返回报告</button></div>';
    window.scrollTo({top:0,behavior:'smooth'});
  };

  window.showAdultPayment = function() {
    document.getElementById('payment-overlay').style.display = 'flex';
    document.getElementById('pay-tier-selection').style.display = 'block';
    document.getElementById('pay-tier-detail').style.display = 'none';
  };
  window.closeAdultPayment = function() {
    document.getElementById('payment-overlay').style.display = 'none';
  };
  window.showAdultPayTier = function(tier) {
    document.getElementById('pay-tier-selection').style.display = 'none';
    document.getElementById('pay-tier-detail').style.display = 'block';
    if (tier === 'report') {
      document.getElementById('pay-detail-title').textContent = '📋 完整诊断报告';
      document.getElementById('pay-detail-price').innerHTML = '$29';
    } else {
      document.getElementById('pay-detail-title').textContent = '🌟 《AI时代生存手册》知识星球';
      document.getElementById('pay-detail-price').innerHTML = '$199<span style="font-size:14px;font-weight:400;color:#888;">/year</span>';
    }
  };
  window.showAdultPayBack = function() {
    document.getElementById('pay-tier-selection').style.display = 'block';
    document.getElementById('pay-tier-detail').style.display = 'none';
  };
})();
</script>
</body>
</html>