---
// CBAM 碳合规自查 — 独立全屏页（与 AI 素养诊断页一致：不显示全站 header/nav）
export const prerender = true;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CBAM碳合规自查 — 30秒检查你的产品 | humanaifit</title>
  <meta name="description" content="输入你的HS编码（前6-8位），30秒免费诊断：你的产品是否受欧盟CBAM影响？包含排放估算和合规路线图。" />
  <meta property="og:title" content="CBAM碳合规自查 — 30秒检查你的产品 | humanaifit" />
  <meta property="og:description" content="输入你的HS编码（前6-8位），30秒免费诊断：你的产品是否受欧盟CBAM影响？" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://humanaifit.com/og-default.jpg" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>
    :root {
      --color-primary: #0F2B46;
      --color-accent: #C9A96E;
      --color-accent-dark: #B8944C;
      --color-text: #2D2D2D;
      --color-text-muted: #999;
      --color-border: #E5E5E5;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif; }

    /* ===== 留资浮窗（独立页内联样式） ===== */
    .huma-lead-float-btn {
      position: fixed; right: 24px; bottom: 28px; z-index: 9998;
      padding: 13px 20px; font-size: 14px; font-weight: 600; color: #fff;
      background: var(--color-accent); border: none; border-radius: 50px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2); cursor: pointer; transition: transform 0.2s;
    }
    .huma-lead-float-btn:hover { transform: translateY(-2px); }
    .huma-lead-modal {
      display: none; position: fixed; inset: 0; z-index: 9999;
      background: rgba(15,43,70,0.45); align-items: center; justify-content: center; padding: 20px;
    }
    .huma-lead-modal-card { width: 100%; max-width: 420px; padding: 28px; background: #fff; border-radius: 16px; position: relative; }
    .huma-lead-close { position: absolute; top: 14px; right: 18px; background: none; border: none; font-size: 20px; color: var(--color-text-muted); cursor: pointer; }
    .huma-lead-close:hover { color: var(--color-primary); }
    .huma-lead-title { font-size: 19px; font-weight: 700; color: var(--color-primary); margin-bottom: 6px; }
    .huma-lead-sub { font-size: 13px; color: var(--color-text-muted); margin-bottom: 16px; line-height: 1.5; }
    .huma-lead-form label { display: block; font-size: 13px; font-weight: 600; color: var(--color-primary); margin: 12px 0 5px; }
    .huma-lead-form input, .huma-lead-form select, .huma-lead-form textarea {
      width: 100%; padding: 11px 14px; font-size: 14px; font-family: inherit;
      color: var(--color-text); background: #fafaf8; border: 1.5px solid var(--color-border);
      border-radius: 10px; outline: none; transition: border-color 0.2s; box-sizing: border-box;
    }
    .huma-lead-form input:focus, .huma-lead-form select:focus, .huma-lead-form textarea:focus { border-color: var(--color-accent); }
    .huma-lead-form textarea { min-height: 70px; resize: vertical; }
    .huma-lead-note { font-size: 12px; color: var(--color-text-muted); margin-top: -4px; }
    .huma-lead-submit { margin-top: 6px; padding: 12px 24px; font-size: 15px; font-weight: 600; color: #fff; background: var(--color-accent); border: none; border-radius: 10px; cursor: pointer; transition: background 0.2s; }
    .huma-lead-submit:hover { background: var(--color-accent-dark); }
    .huma-lead-submit:disabled { opacity: 0.6; cursor: wait; }
    .huma-lead-msg { font-size: 13px; margin-top: 10px; }
    .huma-lead-msg.ok { color: #2e7d32; }
    .huma-lead-msg.err { color: #c62828; }
  </style>
</head>
<body>
  <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;">CBAM碳合规自查 — 30秒检查你的产品是否受欧盟碳关税影响</h1>

  <div style="width:100%;height:100vh;border:none;overflow:hidden;">
    <iframe
      src="https://cbam.humanaifit.com/?lang=zh&v=2"
      style="width:100%;height:100%;border:none;min-height:100vh;"
      title="CBAM碳合规自查工具"
      loading="eager"
      allow="payment"
    ></iframe>
  </div>

  <!-- CBAM 留资浮窗 -->
  <button class="huma-lead-float-btn" onclick="humaLead.open()">💬 CBAM 咨询</button>
  <div class="huma-lead-modal" id="huma-lead-modal">
    <div class="huma-lead-modal-card">
      <button class="huma-lead-close" onclick="humaLead.close()">×</button>
      <div class="huma-lead-title">留下联系方式</div>
      <div class="huma-lead-sub">告诉我你的产品情况，24小时内我亲自回复 CBAM 合规建议。</div>
      <form class="huma-lead-form" id="leadForm-cbam" onsubmit="return humaLeadSubmit(event, 'cbam')">
        <label>怎么称呼你？</label>
        <input type="text" name="name" required placeholder="你的姓名或昵称" />
        <label>邮箱</label>
        <input type="email" name="email" required placeholder="you@example.com" />
        <label>你关心什么？</label>
        <select name="intent" required>
          <option value="">请选择</option>
          <option>CBAM碳合规</option>
          <option>碳关税咨询</option>
          <option>全球化合规</option>
          <option>其他合作</option>
        </select>
        <label>想解决的问题（选填）</label>
        <textarea name="note" placeholder="例如：我司出口钢材到欧盟，想知道是否受影响"></textarea>
        <p class="huma-lead-note">不收集手机号，可随时要求删除。</p>
        <button type="submit" class="huma-lead-submit">发送</button>
        <div class="huma-lead-msg" id="leadMsg-cbam"></div>
      </form>
    </div>
  </div>

  <script is:inline>
    // iframe 自适应高度（若子页面 postMessage resize）
    window.addEventListener('message', function (e) {
      if (e.data && e.data.type === 'resize') {
        var iframe = document.querySelector('iframe');
        if (iframe) iframe.style.height = e.data.height + 'px';
      }
    });
    (function(){
      window.humaLead = {
        open: function(){ var m=document.getElementById('huma-lead-modal'); if(m) m.style.display='flex'; },
        close: function(){ var m=document.getElementById('huma-lead-modal'); if(m) m.style.display='none'; }
      };
      window.humaLeadSubmit = async function(e, source){
        e.preventDefault();
        var f = e.target, msg = document.getElementById('leadMsg-'+source), btn = f.querySelector('.huma-lead-submit');
        var data = { name:f.name.value, email:f.email.value, intent:f.intent.value, note:f.note.value, source:source };
        btn.disabled=true; btn.textContent='发送中...';
        try{
          await fetch('/api/lead',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
          msg.className='huma-lead-msg ok'; msg.textContent='✅ 已收到，我24小时内回复你。';
          f.reset(); setTimeout(function(){ var m=document.getElementById('huma-lead-modal'); if(m) m.style.display='none'; }, 1500);
        }catch(err){ msg.className='huma-lead-msg err'; msg.textContent='发送失败，请稍后再试。'; }
        btn.disabled=false; btn.textContent='发送';
      };
    })();
  </script>
</body>
</html>
