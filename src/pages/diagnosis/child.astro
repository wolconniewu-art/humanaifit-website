function renderQuestion(step) {
  if (step >= QUESTIONS.length) {
    showResult();
    return;
  }
  const q = QUESTIONS[step];
  const selected = answers[q.id];

  renderProgress();

  cardArea.innerHTML = `
    <div class="card fade-in">
      <div class="q-number">Q${step + 1} / 22</div>
      <div class="q-title">${q.title}</div>
      <div class="options">
        ${q.options.map((opt, i) => `
          <button class="option ${selected === i ? 'selected' : ''}" 
                  data-opt-index="${i}"
                  onclick="selectOption(${step}, ${i})">
            ${opt.text}
          </button>
        `).join('')}
      </div>
      <div class="btn-row">
        ${step > 0 ? '<button class="btn btn-secondary" onclick="prevStep()">\u2190 上一题</button>' : '<div></div>'}
        <button class="btn btn-primary" id="nextBtn" ${selected === undefined ? 'disabled' : ''} 
                onclick="nextStep()">
          ${step < QUESTIONS.length - 1 ? '下一题 \u2192' : '\uD83D\uDCCA 查看结果'}
        </button>
      </div>
    </div>
  `;
}

// ===== 逻辑 =====

function selectOption(step, optIndex) {
  const q = QUESTIONS[step];
  answers[q.id] = optIndex;

  document.querySelectorAll('.option').forEach((btn, i) => {
    btn.classList.toggle('selected', i === optIndex);
  });

  document.getElementById('nextBtn').disabled = false;
}

function nextStep() {
  if (currentStep < QUESTIONS.length - 1) {
    currentStep++;
    renderQuestion(currentStep);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  } else {
    // 查看结果前，先弹出留资（如果还没提交过）
    if (!leadSubmitted) {
      showLead();
    } else {
      calculateResult();
    }
  }
}

function prevStep() {
  if (currentStep > 0) {
    currentStep--;
    renderQuestion(currentStep);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function calculateResult() {
  loadingOverlay.classList.remove('hidden');

  // 双轴评分
  // 轴1：5维度能力分（用于雷达图）
  let dimScores = { cognitive: 0, practice: 0, social: 0, critical: 0, digital: 0 };
  // 轴2：3类型风格分（用于学习类型）
  let typeScores = { explore: 0, apply: 0, create: 0 };
  
  // 获取年龄
  let ageGroup = '10-12';
  const screeningQ = QUESTIONS.find(q => q.isScreening);
  if (screeningQ) {
    const ageAns = answers[screeningQ.id];
    if (ageAns !== undefined) {
      const opt = screeningQ.options[ageAns];
      if (opt && opt.ageGroup) ageGroup = opt.ageGroup;
    }
  }

  // 遍历所有诊断题
  QUESTIONS.forEach(q => {
    if (q.isScreening) return;
    const ansIdx = answers[q.id];
    if (ansIdx === undefined) return;
    const opt = q.options[ansIdx];
    
    // 累加维度分
    if (opt.scores) {
      DIM_ORDER.forEach(dim => {
        if (opt.scores[dim]) dimScores[dim] += opt.scores[dim];
      });
    }
    // 累加类型分
    if (opt.types) {
      TYPE_ORDER.forEach(typ => {
        if (opt.types[typ]) typeScores[typ] += opt.types[typ];
      });
    }
  });

  // 归一化维度分到0-100
  const maxDim = Math.max(...DIM_ORDER.map(d => dimScores[d]), 1);
  const dimPct = {};
  DIM_ORDER.forEach(d => {
    dimPct[d] = maxDim > 0 ? Math.round((dimScores[d] / maxDim) * 100) : 0;
  });

  // 归一化类型分到百分比
  const totalType = typeScores.explore + typeScores.apply + typeScores.create;
  let typePct = { explore: 33, apply: 33, create: 33 };
  if (totalType > 0) {
    typePct.explore = Math.round((typeScores.explore / totalType) * 100);
    typePct.apply = Math.round((typeScores.apply / totalType) * 100);
    typePct.create = Math.max(0, 100 - typePct.explore - typePct.apply);
  }

  // 判定主要类型
  let mainType = 'explore';
  if (typeScores.apply >= typeScores.explore && typeScores.apply >= typeScores.create) mainType = 'apply';
  if (typeScores.create >= typeScores.explore && typeScores.create >= typeScores.apply) mainType = 'create';

  // 判定副类型
  let secondaryType = null;
  const sorted = TYPE_ORDER.map(t => ({ key: t, pct: typePct[t] })).sort((a, b) => b.pct - a.pct);
  if (sorted[1].pct >= sorted[0].pct * 0.7 && sorted[1].pct > 35) {
    secondaryType = sorted[1].key;
  }

  result = { 
    mainType, secondaryType, ageGroup, 
    dimScores, typeScores, 
    dimPct, typePct 
  };

  setTimeout(() => {
    loadingOverlay.classList.add('hidden');
    renderResult();
  }, 400);
