    parentNote: 'You\'ve already seen AI\'作为实用工具的价值。下一步，帮助孩子聚焦一个具体问题，用AI来搞定它。'
  },
  create: {
    icon: '\uD83C\uDFA8',
    label: '创作型',
    badge: '表达冲动',
    desc: '这个小创作者有表达冲动——他们需要工具把想法变成作品。你的孩子擅长将想象变为现实，有强烈的自我表达欲望。',
    mva: '让孩子用AI绘画工具输入想象中的场景，然后一起创作故事。目标："把脑子里的画面变成能看到的东西"——零技术门槛。',
    direction: 'AI音乐创作、AI视频制作、AI故事/绘本生成',
    ageAdvice: {
      '6-9': 'AI绘画 + AI绘本制作 + 基础AI音乐',
      '10-12': 'AI视频入门 + AI音乐制作 + 数字艺术',
