        <p class="share-description">👋 👋 分享给朋友，看看他们的孩子是什么类型！'s type!</p>
        <button class="btn btn-primary" onclick="shareResult()">
          📤 分享到微信
        </button>
        <button class="btn btn-secondary" onclick="screenshotShare()" style="margin-top:8px;">
          📸 保存截图
        </button>
        <button class="btn btn-secondary" onclick="restart()" style="margin-top:8px;">
          🔄 重新诊断
        </button>
      </div>
    </div>
  `;
  window.scrollTo({ top: 0, behavior: 'smooth' });

  // 延迟触发分数条动画
  setTimeout(() => {
    document.querySelectorAll('.score-fill').forEach(el => {
      const pct = el.parentElement.querySelector('.score-pct');
      if (pct) el.style.width = pct.textContent;
    });
  }, 100);
}

// ===== 分享 =====
function shareResult() {
  const r = RESULTS[result.type];
  const text = [
    '我的孩子是' + r.icon + r.label + '型！',
    '',
    '10 questions, 30 seconds free diagnosis. Find your child AI learning style.',
    'https://www.humanaifit.com/diagnosis/'
  ].join('\n');

  // 先复制文案
  navigator.clipboard.writeText(text).then(() => {
    // 再生成截图保存到手机
    screenshotShare();
  }).catch(() => {
    alert('📸 复制文案失败！\n\n请手动复制↓\n' + text);
  });
}

function screenshotShare() {
  if (typeof html2canvas !== 'undefined') {
    const card = document.querySelector('.card');
    if (card) {
      html2canvas(card, { backgroundColor: '#ffffff' }).then(canvas => {
        const dataUrl = canvas.toDataURL('image/png');
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;animation:fadeIn 0.2s;';
        overlay.innerHTML = '<div style="background:white;border-radius:16px;padding:20px;max-width:360px;width:100%;text-align:center;position:relative;">' +
          '<button onclick="this.parentElement.parentElement.remove()" style="position:absolute;top:8px;left:8px;border:none;background:rgba(0,0,0,0.5);color:white;font-size:20px;width:30px;height:30px;border-radius:50%;cursor:pointer;line-height:30px;z-index:10;">x</button>' +
          '<p style="font-size:14px;color:#333;margin:0 0 12px;"><strong>长按保存到相册</strong></p>' +
          '<p style="font-size:12px;color:#888;margin:0 0 12px;">你也可以在微信中分享此图片</p>' +
          '<img src="' + dataUrl + '" style="width:100%;border-radius:8px;" />' +
          '<button onclick="this.parentElement.parentElement.remove()" style="margin-top:12px;padding:10px 24px;border:none;background:#0F2B46;color:white;border-radius:8px;font-size:14px;cursor:pointer;">关闭</button>' +
          '</div>';
        document.body.appendChild(overlay);
      });
    }
  } else {
    alert('📸 请截图保存你的诊断结果！');
  }
}

function restart() {
  // 记录本次结果到localStorage（按孩子昵称区分）
  if (result) {
    try {
      saveChildHistory({ type: result.type, scores: result.scores, pct: result.pct, date: new Date().toISOString() });
    } catch(e) {}
  }
  currentStep = 0;
  answers = {};
  result = null;
  leadSubmitted = false;
  renderStart();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ===== 留资 =====
function showLead() {
  document.getElementById('leadOverlay').classList.add('active');
}

function closeLead() {
  document.getElementById('leadOverlay').classList.remove('active');
  leadSubmitted = true;
  calculateResult();
}

function submitLead() {
  const name = document.getElementById('leadName').value.trim();
  const contact = document.getElementById('leadContact').value.trim();
  
  if (!contact) {
    alert('请输入微信号或手机号以获取诊断报告');
    return;
  }
  
  const privacyCheck = document.getElementById('privacyAgree');
  if (!privacyCheck || !privacyCheck.checked) {
    alert('请同意隐私政策。我们保护您和孩子的数据安全');
    return;
  }
  
  // Store locally
  try {
    const leads = JSON.parse(localStorage.getItem('diagnosis_leads') || '[]');
    leads.push({ name, contact, result, timestamp: new Date().toISOString() });
    localStorage.setItem('diagnosis_leads', JSON.stringify(leads));
  } catch(e) {}

  // Send to Feishu via Cloudflare Pages Function proxy
  fetch('/api/lead', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      nickname: childNickname || 'Default',
      name: name,
      contact: contact,
      result: result ? {
        type: result.type,
        typeLabel: TYPE_LABELS_EN[result.type],
        pct: result.pct,
      } : null,
    }),
  }).catch(function(err) {
    console.error('Feishu notification failed:', err);
  });

  leadSubmitted = true;
  document.getElementById('leadOverlay').classList.remove('active');
  calculateResult();
}

// ===== 键盘支持 =====
document.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    const nextBtn = document.getElementById('nextBtn');
    if (nextBtn && !nextBtn.disabled) nextBtn.click();
  }
  if (['1','2','3'].includes(e.key)) {
    const opts = document.querySelectorAll('.option');
    const idx = parseInt(e.key) - 1;
    if (opts[idx]) opts[idx].click();
  }
});

// ===== 启动 =====
renderStart();

// ===== 支付弹窗 =====
function showPayment(tier) {
  const plans = {
    '9.9': { price: '9.9', name: 'AI素养深度分析报告', planet: '+1周免费星球权限' },
    '19.9': { price: '19.9', name: '月度订阅', planet: '+1个月免费星球权限' },
    '199annual': { price: '199', name: '年度家庭计划', planet: '+2个月免费星球权限' }
  };
  const p = plans[tier];
  
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;';
  
  overlay.innerHTML = `
    <div style="background:white;border-radius:16px;padding:28px;max-width:380px;width:100%;text-align:center;animation:fadeIn 0.2s;">
      <button onclick="this.closest('[style*=\"z-index:9999\"]').remove()" style="float:right;border:none;background:none;font-size:20px;cursor:pointer;color:#999;">×</button>
      <h3 style="margin:8px 0 4px;font-size:18px;">${p.name}</h3>
      <p style="font-size:28px;font-weight:700;color:#0F2B46;margin:12px 0 4px;">¥${p.price}</p>
      <p style="font-size:13px;color:#C9A96E;font-weight:600;margin-bottom:16px;">🎁 ${p.planet}</p>
      <div style="background:#f5f5f5;padding:16px;border-radius:12px;margin-bottom:16px;">
        <div style="background:#fff8e1;padding:12px;border-radius:8px;margin-bottom:16px;">
        <p style="font-size:13px;color:#666;margin-bottom:8px;">微信扫码支付</p>
        <img src="/images/wechat_pay.jpg" alt="微信扫码支付 QR Code" style="width:180px;height:180px;object-fit:cover;border-radius:8px;" />
        <p style="font-size:12px;color:#e65100;margin-bottom:4px;">💬 Contact via WeChat to Purchase</p>
        <p style="font-size:12px;color:#555;margin-bottom:4px;">长按复制微信ID：</p>
        <div style="background:#f5f5f5;padding:8px;border-radius:6px;font-size:14px;font-weight:600;color:#0F2B46;margin:4px 0;text-align:center;cursor:pointer;" onclick="navigator.clipboard.writeText('blurblurfish');alert('WeChat ID copied')">blurblurfish</div>
        <p style="font-size:12px;color:#666;margin-top:6px;">备注"孩子诊断"，Connie会激活你的报告和免费星球权限</p>
      </div>
      <button onclick="this.closest('[style*=\"z-index:9999\"]').remove()" style="padding:10px 28px;background:#f5f5f5;border:none;border-radius:8px;cursor:pointer;font-size:14px;color:#666;">关闭</button>
    </div>
  `;
  
  document.body.appendChild(overlay);
}
</script>

<style>
@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}
</style>

<script>
  // 5-dim ring after results appear
  setTimeout(function(){
    var el=document.getElementById('cardArea');
    if(!el||el.querySelector('.fdr'))return;
    var d=[
      {l:"探索型",c:'#4A90D9'},
      {l:"创意制造者",c:'#E67E22'},
      {l:"社交连接者",c:'#27AE60'},
      {l:"审美思考者",c:'#8E44AD'},
      {l:"数字原住民",c:'#F39C12'}
    ];
    var h='<div class="card fdr" style="padding:20px;margin-top:16px;background:linear-gradient(135deg,#f8f9fa,#e3f2fd);">'+
      '<h3 style="margin:0 0 4px;font-size:16px;">🧭 5维AI潜能（免费预览）</h3>'+
      '<p style="font-size:12px;color:#888;margin:0 0 12px;">简化版预览</p>'+
      '<div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;">';
    d.forEach(function(x){
      h+='<div style="text-align:center;width:68px;"><div style="width:52px;height:52px;margin:0 auto;border-radius:50%;border:4px solid '+x.c+';display:flex;align-items:center;justify-content:center;">'+
      '<span style="font-size:20px;color:'+x.c+';">?</span></div>'+
      '<div style="font-size:11px;color:#555;margin:3px 0;">'+x.l+'</div></div>';
    });
    h+='</div><div style="background:#fff3e0;border:1px solid #ffe082;border-radius:12px;padding:16px;margin:10px 0;text-align:center;">'+
      '<p style="font-size:14px;color:#e65100;margin:0 0 8px;font-weight:600;">🔒 解锁完整报告</p>'+
      '<p style="font-size:12px;color:#555;margin:0 0 10px;">✅ 完整5维雷达图<br>✅ 30天行动卡<br>✅ 家长指南<br>✅ 复测追踪</p>'+
      '<button onclick="alert(&apos;Paid version coming soon! WeChat: humanaifit&apos;)" style="padding:10px 20px;background:#FF9800;color:#fff;border:none;border-radius:8px;font-size:14px;cursor:pointer;width:100%;">🔓 解锁完整报告 ¥9.9</button>'+
      '<p style="font-size:11px;color:#999;margin:6px 0 0;">微信扫码支付</p></div></div>';
    el.insertAdjacentHTML('beforeend',h);
  },1200);
</script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" 
        onerror="console.log('html2canvas not loaded')"></script>

</body>
</html>