            : '<a href="/en/blog/ai_knowledge_meaning/" style="display:block;font-size:13px;color:#0F2B46;margin:4px 0;">🎓 AI时代，知识还有意义吗？</a><a href="/en/blog/sharing_ideas_with_ai_originality_2026/" style="display:block;font-size:13px;color:#0F2B46;margin:4px 0;">💡 该把你的研究想法分享给AI吗？</a><a href="/en/blog/ai_us_education_2026/" style="display:block;font-size:13px;color:#0F2B46;margin:4px 0;">🏫 AI如何重塑美国教育：从工具到新生态</a>'
        }
