};

// ===== 状态 =====
let currentStep = -1; // -1 = 开始页
let answers = {};
let result = null;
let leadSubmitted = false;
// Type label mapping (global)
const TYPE_LABELS_EN = { explore: '🔍探索型', apply: '🛠️应用型', create: '🎨创作型' };

let childNickname = ''; // child nickname, for multi-child differentiation

// ===== DOM引用 =====
const cardArea = document.getElementById('cardArea');
const progressBar = document.getElementById('progressBar');
const loadingOverlay = document.getElementById('loadingOverlay');

// ===== 渲染 =====

function renderProgress() {
  if (currentStep < 0) {
    progressBar.innerHTML = '';
    return;
  }
  progressBar.innerHTML = QUESTIONS.map((q, i) => {
    let cls = 'dot';
    if (i < currentStep) cls += ' done';
    else if (i === currentStep) cls += ' active';
    return `<div class="${cls}"></div>`;
  }).join('');
}

function renderStart() {
  currentStep = -1;
  progressBar.innerHTML = '';
  cardArea.innerHTML = `
    <div class="card fade-in" style="padding:32px 24px;">
      <div class="hero-icon">🧠</div>
      <div class="hero-desc">
        <strong>10道快速题</strong>，回答那个让你夜不能寐的问题:
        <br/>
        「<strong>我的孩子该学什么AI</strong>？」
      </div>

      <div class="child-nickname-area" style="margin:16px 0;padding:14px;background:#f0f7ff;border-radius:10px;">
        <label style="font-size:13px;font-weight:600;color:#0F2B46;display:block;margin-bottom:6px;">孩子昵称 (多孩家庭可区分不同孩子的记录)</label>
        <input type="text" id="childNicknameInput" placeholder="例如：小明、朵朵" style="width:100%;padding:10px 14px;border:1px solid #ddd;border-radius:8px;font-size:14px;outline:none;box-sizing:border-box;" />
        <p style="font-size:11px;color:#999;margin-top:4px;">选填。多孩家庭每次用不同昵称，系统将分别保存历史记录。</p>
      </div>

      <div class="feature-list">
        <div class="feature-item">
          <span class="feature-icon">🔬</span>
          <span><strong>科学分型</strong> — 基于认知行为特征，三种AI学习类型</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">🎯</span>
          <span><strong>分龄建议</strong> — 6-9 / 10-12 / 13-18, 每阶段专属建议</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">⚡</span>
          <span><strong>30秒出结果</strong> — 立刻获得个性化学习建议</span>
        </div>
      </div>

      <button class="start-btn" onclick="startQuiz()">
        开始诊断
      </button>
      <p style="text-align:center;font-size:12px;color:#999;">完成测评可获取《2025全球AI教育政策汇编》PDF</p>
    </div>
  `;
}

function startQuiz() {
  const nickInput = document.getElementById('childNicknameInput');
  childNickname = (nickInput ? nickInput.value.trim() : '') || 'Default';
  currentStep = 0;
  answers = {};
  renderQuestion(0);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function renderQuestion(step) {
  if (step >= QUESTIONS.length) {
    showResult();
    return;
  }
  const q = QUESTIONS[step];
  const selected = answers[q.id];

  renderProgress();

  cardArea.innerHTML = `
    <div class="card fade-in">
      <div class="q-number">Q${step + 1} / 10</div>
      <div class="q-title">${q.title}</div>
      <div class="options">
        ${q.options.map((opt, i) => `
          <button class="option ${selected === i ? 'selected' : ''}" 
                  data-opt-index="${i}"
                  onclick="selectOption(${step}, ${i})">
            ${opt.text}
          </button>
        `).join('')}
      </div>
      <div class="btn-row">
        ${step > 0 ? '<button class="btn btn-secondary" onclick="prevStep()">\u2190 上一题</button>' : '<div></div>'}
        <button class="btn btn-primary" id="nextBtn" ${selected === undefined ? 'disabled' : ''} 
                onclick="nextStep()">
          ${step < QUESTIONS.length - 1 ? '下一题 \u2192' : '\uD83D\uDCCA 查看结果'}
        </button>
      </div>
    </div>
  `;
}

// ===== 逻辑 =====

function selectOption(step, optIndex) {
  const q = QUESTIONS[step];
  answers[q.id] = optIndex;

  document.querySelectorAll('.option').forEach((btn, i) => {
    btn.classList.toggle('selected', i === optIndex);
  });

  document.getElementById('nextBtn').disabled = false;
}

function nextStep() {
  if (currentStep < QUESTIONS.length - 1) {
    currentStep++;
    renderQuestion(currentStep);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  } else {
    // 查看结果前，先弹出留资（如果还没提交过）
    if (!leadSubmitted) {
      showLead();
    } else {
      calculateResult();
    }
  }
}

function prevStep() {
  if (currentStep > 0) {
    currentStep--;
    renderQuestion(currentStep);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function calculateResult() {
  loadingOverlay.classList.remove('hidden');

  let scores = { explore: 0, apply: 0, create: 0 };
  let ageGroup = '10-12';

  QUESTIONS.forEach((q, i) => {
    const ansIdx = answers[q.id];
    if (ansIdx === undefined) return;
    const opt = q.options[ansIdx];
    if (opt.ageGroup) ageGroup = opt.ageGroup;
    scores.explore += (opt.scores.explore || 0);
    scores.apply += (opt.scores.apply || 0);
    scores.create += (opt.scores.create || 0);
  });

  // 计算百分比（基于总得分）
  const totalScores = scores.explore + scores.apply + scores.create;
  let pctExplore, pctApply, pctCreate;
  if (totalScores > 0) {
    // Calculate first two, third rounds to 100%, Math.max(0) prevents negative overflow
    pctExplore = Math.max(0, Math.round((scores.explore / totalScores) * 100));
    pctApply = Math.max(0, Math.round((scores.apply / totalScores) * 100));
    pctCreate = Math.max(0, 100 - pctExplore - pctApply);
  } else {
    pctExplore = pctApply = pctCreate = 33;
  }

  // 判定主要类型（基于原始分，不依赖百分比）
  let type;
  if (scores.explore >= scores.apply && scores.explore >= scores.create) type = 'explore';
  else if (scores.apply >= scores.create) type = 'apply';
  else type = 'create';

  // 副类型检测
  let secondaryType = null;
  const sorted = [
    { key: 'explore', pct: pctExplore },
    { key: 'apply', pct: pctApply },
    { key: 'create', pct: pctCreate },
  ].sort((a, b) => b.pct - a.pct);
  if (sorted[1].pct >= sorted[0].pct * 0.7 && sorted[1].pct > 35) {
    secondaryType = sorted[1].key;
  }

  result = { type, secondaryType, ageGroup, scores, pct: { explore: pctExplore, apply: pctApply, create: pctCreate } };

  setTimeout(() => {
    loadingOverlay.classList.add('hidden');
    renderResult();
  }, 400);
}

// 获取该孩子的历史记录
function getChildHistory() {
  const key = 'diagnosis_history_' + childNickname;
  try {
    return JSON.parse(localStorage.getItem(key) || '[]');
  } catch(e) { return []; }
}

function saveChildHistory(entry) {
  const key = 'diagnosis_history_' + childNickname;
  try {
    var hist = JSON.parse(localStorage.getItem(key) || '[]');
    hist.push(entry);
    localStorage.setItem(key, JSON.stringify(hist.slice(-5)));
  } catch(e) {}
}

// 显示历史对比（如果有）
function renderComparison() {
  try {
    var histData = getChildHistory();
    if (histData.length < 2) return '';
    var last = histData[histData.length - 2];
    // labelMap replaced by global TYPE_LABELS_EN
    return '<div class="result-section" style="background:#fff8e1;padding:16px;border-radius:10px;margin:12px 0;">' +
      '<h3 style="margin-top:0;">🔄 与上次对比</h3>' +
      '<p style="font-size:13px;color:#555;">Last result: ' + (TYPE_LABELS_EN[last.type] || last.type) + ' | ' +
      'Explore' + last.pct.explore + '% / Apply' + last.pct.apply + '% / Create' + last.pct.create + '%</p>' +
      '<p style="font-size:13px;color:#555;margin:4px 0 0;">📈 A child\'s AI learning tendency evolves as they interact with AI tools. Re-diagnose every 3 months to track progress.</p>' +
      '</div>';
  } catch(e) { return ''; }
}

function renderResult() {
  const r = RESULTS[result.type];
  const ageKey = result.ageGroup;
  const ageAdviceText = r.ageAdvice[ageKey] || r.ageAdvice['10-12'];
  const ageLabel = { '6-9': 'Age 6-9', '10-12': 'Age 10-12', '13-18': 'Age 13-18' }[ageKey] || 'Age 10-12';

  progressBar.innerHTML = QUESTIONS.map(() => `<div class="dot done"></div>`).join('');

  // 构建分数条
  const scores = [
    { key: 'explore', label: '探索型 ' + RESULTS.explore.icon, pct: result.pct.explore },
    { key: 'apply', label: '应用型 ' + RESULTS.apply.icon, pct: result.pct.apply },
    { key: 'create', label: '创作型 ' + RESULTS.create.icon, pct: result.pct.create },
  ];

  cardArea.innerHTML = `
    <div class="card fade-in" style="text-align:left;">
      <div class="result-type">${r.icon}</div>
      <div class="result-label">${r.label}</div>
      <div class="result-sub">${r.badge} \u00B7 ${ageLabel}</div>

      <hr class="sep" />

      <!-- 分数可视化 -->
      <div class="result-section">
        <h3>得分矩阵</h3>
        <div class="score-bars">
          ${scores.map(s => `
            <div class="score-row">
              <div class="score-label">${s.label}</div>
              <div class="score-track">
                <div class="score-fill ${s.key}" style="width: 0%;"></div>
                <span class="score-pct">${s.pct}%</span>
              </div>
            </div>
          `).join('')}
        </div>
        <p style="font-size:12px;color:#666;margin-top:6px;">探索型 ${scores.find(s => s.key === 'explore').pct}% · 应用型 ${scores.find(s => s.key === 'apply').pct}% · 创作型 ${scores.find(s => s.key === 'create').pct}% — Higher percentage indicates stronger tendency in that dimension.</p>
      </div>

      <hr class="sep" />

      <div class="result-section">
        <h3>你的孩子</h3>
        <p>${r.desc}</p>
      </div>

      <!-- MVA：今晚就能做的一件事 -->
      <div class="result-section" style="background:#f0f7ff;padding:16px;border-radius:10px;margin:12px 0;">
        <h3 style="margin-top:0;">🌙 今晚就能做的一件事</h3>
        <p>${r.mva}</p>
      </div>

      <!-- 混合型判定 -->
      ${
        result.secondaryType ? `<div class="result-section">
          <h3>💡 不止一个类型</h3>
          <p style="background:#fff8e1;padding:12px;border-radius:8px;font-size:14px;margin:8px 0;">
            Your child leans toward <strong>${r.label}</strong> but also shows clear <strong>${
              RESULTS[result.secondaryType].label
            }</strong> traits. Consider guiding both directions to let your child find what suits them best.
          </p>
        </div>` : ''
      }

      <div class="result-section">
        <h3>📝 推荐学习方向</h3>
        <p>${r.direction}</p>
      </div>

      <div class="result-section">
        <h3>${ageLabel} 学习建议</h3>
        <p>${ageAdviceText}</p>
      </div>

      <div class="result-section" style="margin-top:8px;">
        <h3>为你的孩子选择学习路径</h3>

        <!-- 进度指引 -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin:8px 0 12px;padding:8px 16px;background:#f0f7ff;border-radius:20px;">
          <span style="font-size:12px;color:#0F2B46;font-weight:600;">⚡ 从报告开始</span>
          <span style="font-size:10px;color:#999;">→</span>
          <span style="font-size:12px;color:#666;">🧱 深度学习</span>
          <span style="font-size:10px;color:#999;">→</span>
          <span style="font-size:12px;color:#666;">✍️ 一对一定制</span>
        </div>

        <div style="border:1px solid #e0e0e0;border-radius:10px;padding:14px;margin-bottom:10px;background:#f9fafb;">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
              <span style="font-weight:600;font-size:15px;">AI素养深度分析报告</span>
              <span style="display:inline-block;margin-left:8px;padding:1px 8px;background:#1a73e8;color:white;border-radius:10px;font-size:11px;">最佳选择</span>
            </div>
            <span style="font-weight:700;color:#0F2B46;font-size:16px;">¥9.9</span>
          </div>
          <p style="font-size:13px;color:#666;margin:6px 0 0;">基于诊断的10页个性化报告，含学习路线图和适龄工具清单</p>
        </div>

        <!-- 限时优惠横幅 -->
        <div style="background:linear-gradient(135deg,#0F2B46,#1A3F64);border-radius:10px;padding:14px;text-align:center;">
