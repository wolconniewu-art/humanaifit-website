---
// 孩子AI素养诊断 — v2.0 完善版
// 改进点：增加开始页面、得分雷达百分比、留资环节、社交分享、知识星球联动
// 路径: /diagnosis/
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>孩子AI素养诊断 — 30秒测出你孩子的AI学习风格</title>
  <meta name="description" content="10道快速题，30秒测出。发现你的孩子是探索型🧐、应用型🛠️还是创作型🎨——附带个性化学习建议。" />
  <meta property="og:title" content="孩子AI素养诊断 — 免费评估" />
  <meta property="og:description" content="30秒免费诊断，发现你的孩子应该学什么AI。" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.humanaifit.com/en/diagnosis/" />
  <style>
    :root {
      --primary: #0F2B46;
      --accent: #C9A96E;
      --bg: #f8f7f4;
      --card-bg: #ffffff;
      --text: #2d2d2d;
      --muted: #888888;
      --radius: 12px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
    }
    .container { max-width: 640px; margin: 0 auto; padding: 20px 16px; }
    .header { text-align: center; padding: 32px 0 8px; }
    .header h1 { font-size: 24px; color: var(--primary); font-weight: 700; }
    .header p { color: var(--muted); font-size: 14px; margin-top: 4px; }
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 12px;
    }
    .badge.green { background: #e8f5e9; color: #2e7d32; }
    .badge.gold { background: #fff8e1; color: #f57f17; }
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 24px;
      margin: 16px 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .progress-bar {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin: 16px 0;
    }
    .dot {
      width: 24px;
      height: 6px;
      border-radius: 3px;
      background: #e0e0e0;
      transition: background 0.3s;
    }
    .dot.active { background: var(--primary); }
    .dot.done { background: var(--accent); }
    .q-number {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .q-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 20px;
      color: var(--primary);
    }
    .options { display: flex; flex-direction: column; gap: 10px; }
    .option {
      padding: 14px 16px;
      border: 1px solid #e0e0e0;
      border-radius: 10px;
      background: white;
      text-align: left;
      font-size: 15px;
      cursor: pointer;
      transition: all 0.2s;
      line-height: 1.5;
      color: var(--text);
    }
    .option:hover { border-color: var(--accent); background: #fefcf6; }
    .option.selected {
      border-color: var(--primary);
      background: #eef3f8;
      font-weight: 500;
    }
    .btn-row {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }
    .btn {
      padding: 10px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }
    .btn-primary {
      background: var(--primary);
      color: white;
    }
    .btn-primary:hover { background: #1a3f64; }
    .btn-primary:disabled { background: #ccc; cursor: not-allowed; }
    .btn-secondary {
      background: #f0f0f0;
      color: #666;
    }
    .btn-secondary:hover { background: #e0e0e0; }
    .result-type { font-size: 48px; text-align: center; margin: 8px 0; }
    .result-label {
      text-align: center;
      font-size: 26px;
      font-weight: 700;
      color: var(--primary);
    }
    .result-sub {
      text-align: center;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .result-section { margin-top: 20px; }
    .result-section h3 {
      font-size: 15px;
      font-weight: 600;
      color: var(--primary);
      margin-bottom: 6px;
    }
    .result-section p { font-size: 14px; color: #444; line-height: 1.7; }
    .result-section ul { padding-left: 18px; margin-top: 6px; }
    .result-section li { margin-bottom: 4px; font-size: 14px; color: #444; }
    .sep { border: none; border-top: 1px solid #eee; margin: 20px 0; }
    .share-area { text-align: center; margin-top: 12px; }
    .share-description { font-size: 13px; color: #888; }
    .footer-note {
      text-align: center;
      padding: 20px 0;
      font-size: 12px;
      color: var(--muted);
    }
    .footer-note a { color: var(--muted); }
    .loading-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(255,255,255,0.8);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .loading-overlay.hidden { display: none; }
    .loading-spinner {
      width: 32px;
      height: 32px;
      border: 3px solid #e0e0e0;
      border-top: 3px solid var(--primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .fade-in { animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    /* 开始页 */
    .hero-icon { font-size: 56px; text-align: center; margin-bottom: 16px; }
    .hero-desc { text-align: center; font-size: 14px; color: #555; line-height: 1.8; margin-bottom: 24px; }
    .hero-desc strong { color: var(--primary); }
    .feature-list { margin: 20px 0; }
    .feature-item {
      display: flex; align-items: flex-start; gap: 10px;
      margin-bottom: 12px;
      font-size: 14px;
      color: #444;
    }
    .feature-icon { font-size: 18px; flex-shrink: 0; }
    .start-btn {
      display: block; width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--primary) 0%, #1a3f64 100%);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 17px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s;
      margin: 24px 0 12px;
    }
    .start-btn:hover { transform: scale(1.02); }
    .start-btn:active { transform: scale(0.98); }

    /* 雷达图 - 使用CSS简化版 */
    .score-bars { margin: 20px 0; }
    .score-row {
      display: flex; align-items: center;
      margin-bottom: 12px;
    }
    .score-label {
      width: 60px;
      font-size: 13px;

  // 简化5维环形图（免费版可见）+ 付费引导
  setTimeout(function() {
    var cardArea = document.getElementById('cardArea');
    if (!cardArea) return;
    var dims = [
      {label:"探索型", color:'#4A90D9'},
      {label:"创意制造者", color:'#E67E22'},
      {label:"社交连接者", color:'#27AE60'},
      {label:"审美思考者", color:'#8E44AD'},
      {label:"数字原住民", color:'#F39C12'}
    ];
    var html = '<div class="card" style="padding:20px;margin-top:16px;background:linear-gradient(135deg,#f8f9fa,#e3f2fd);">' +
      '<h3 style="margin:0 0 4px;font-size:16px;">🧭 5维AI潜能（免费预览）</h3>' +
      '<p style="font-size:12px;color:#888;margin:0 0 12px;">简化版预览 — full report shows detailed scores per dimension</p>' +
      '<div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;">';
    dims.forEach(function(d){
      html += '<div style="text-align:center;width:68px;">' +
        '<div style="width:52px;height:52px;margin:0 auto;border-radius:50%;border:4px solid ' + d.color + ';display:flex;align-items:center;justify-content:center;">' +
        '<span style="font-size:20px;color:' + d.color + ';">?</span></div>' +
        '<div style="font-size:11px;color:#555;margin:3px 0;">' + d.label + '</div></div>';
    });
    html += '</div>' +
      '<div style="background:#fff3e0;border:1px solid #ffe082;border-radius:12px;padding:16px;margin:10px 0;text-align:center;">' +
      '<p style="font-size:14px;color:#e65100;margin:0 0 8px;font-weight:600;">🔒 解锁完整报告</p>' +
      '<p style="font-size:12px;color:#555;margin:0 0 10px;">✅ 完整5维雷达图带分数<br>✅ 30天每日行动卡<br>✅ 家长指导手册<br>✅ 复测成长追踪</p>' +
      '<button onclick="alert('Paid version coming soon! Contact WeChat: humanaifit')" style="padding:10px 20px;background:#FF9800;color:#fff;border:none;border-radius:8px;font-size:14px;cursor:pointer;width:100%;">🔓 解锁完整报告  ¥9.9</button>' +
      '<p style="font-size:11px;color:#999;margin:6px 0 0;">微信扫码支付 · Contact us after payment</p></div></div>';
    cardArea.insertAdjacentHTML('beforeend', html);
  }, 800);
      font-weight: 500;
      color: var(--primary);
    }
    .score-track {
      flex: 1;
      height: 20px;
      background: #f0f0f0;
      border-radius: 10px;
      overflow: hidden;
      position: relative;
    }
    .score-fill {
      height: 100%;
      border-radius: 10px;
      transition: width 1s ease;
    }
    .score-fill.explore { background: linear-gradient(90deg, #4CAF50, #81C784); }
    .score-fill.apply { background: linear-gradient(90deg, #2196F3, #64B5F6); }
    .score-fill.create { background: linear-gradient(90deg, #FF9800, #FFB74D); }
    .score-pct {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 12px;
      font-weight: 600;
      color: #333;
    }

    /* 留资弹窗 */
    .lead-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .lead-overlay.active { display: flex; }
    .lead-modal {
      background: white;
      border-radius: 16px;
      padding: 28px 24px 20px;
      max-width: 380px;
      width: 100%;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      text-align: center;
    }
    .lead-modal h2 { font-size: 18px; margin-bottom: 4px; color: #333; }
    .lead-modal p { font-size: 13px; color: #666; margin-bottom: 16px; }
    .lead-modal input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #ddd;
      border-radius: 10px;
      font-size: 14px;
      margin-bottom: 10px;
      outline: none;
      box-sizing: border-box;
    }
    .lead-modal input:focus { border-color: var(--accent); }
    .lead-btn {
      width: 100%;
      padding: 12px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }
    .lead-btn:hover { background: #1a3f64; }
    .lead-close {
      margin-top: 12px;
      font-size: 13px;
      color: #999;
      cursor: pointer;
      background: none;
      border: none;
    }

    @media (max-width: 480px) {
      .header h1 { font-size: 20px; }
      .q-title { font-size: 16px; }
      .option { font-size: 14px; padding: 12px 14px; }
      .result-label { font-size: 22px; }
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "孩子AI素养诊断",
    "description": "10 quick questions, 30 seconds. Discover your child's AI learning style: 探索型, 应用型, or 创作型.",
    "educationalLevel": "Parent",
    "teaches": "AI Learning Style Assessment for Children",
    "url": "https://www.humanaifit.com/en/diagnosis/"
  }
  </script>
</head>
<body>

<div class="container" id="app">
  <div class="header">
    <span class="badge green">🎯 免费 · 30秒</span>
    <h1>孩子AI素养诊断</h1>
    <p>10道题，帮你回答：「我的孩子应该学什么AI？」</p>
  </div>

  <div class="progress-bar" id="progressBar"></div>
  <div id="cardArea">
    <!-- 初始为空，由JS渲染开始页 -->
  </div>
  <div class="footer-note">
    <a href="https://www.humanaifit.com">www.humanaifit.com</a> · <a href="https://www.humanaifit.com/en/blog/privacy_policy_2026/">隐私政策</a>
  </div>
</div>

<!-- 留资弹窗 -->
<div class="lead-overlay" id="leadOverlay">
  <div class="lead-modal">
    <h2>📋 免费诊断报告</h2>
    <p>输入联系方式，获取完整版诊断报告（含学习建议+适龄工具推荐）</p>
    <input type="text" id="leadName" placeholder="您的姓名（可选）" />
    <input type="text" id="leadContact" placeholder="微信号/手机号（必填）" />
    <p style="font-size:11px;color:#999;margin:-4px 0 12px;">您将收到《2025全球AI教育政策汇编》PDF + 诊断结果</p>
    <p style="font-size:12px;color:#888;margin:6px 0;">我们尊重您的隐私，不会向第三方分享您或孩子的信息。查看我们的<a href="https://www.humanaifit.com/en/blog/privacy_policy_2026/" target="_blank" style="color:#1a73e8;text-decoration:underline;">隐私政策</a>.</p>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:#666;margin:8px 0;cursor:pointer;white-space:nowrap;">
          <input type="checkbox" id="privacyAgree" style="width:16px;height:16px;flex-shrink:0;" />
          <span style="line-height:1.4;">我已阅读并同意我们的<a href="https://www.humanaifit.com/en/blog/privacy_policy_2026/" target="_blank" style="color:#1a73e8;text-decoration:underline;">隐私政策</a></span>
        </label>
    <button class="lead-btn" onclick="submitLead()">✅ 获取免费报告</button>
    <button class="lead-close" onclick="closeLead()">跳过，直接看结果</button>
  </div>
</div>

<!-- 加载覆盖 -->
<div id="loadingOverlay" class="loading-overlay hidden">
  <div class="loading-spinner"></div>
</div>

<script is:inline>
// ===== 10道题数据 =====
const QUESTIONS = [
  {
    id: 1,
    title: '你孩子多大了？',
    options: [
      { text: '6-9岁（小学低年级）', scores: { explore: 0, apply: 0, create: 0 }, ageGroup: '6-9' },
      { text: '10-12岁（小学高年级）', scores: { explore: 0, apply: 0, create: 0 }, ageGroup: '10-12' },
      { text: '13-18岁（中学）', scores: { explore: 0, apply: 0, create: 0 }, ageGroup: '13-18' },
    ]
  },
  {
    id: 2,
    title: '当孩子拿到一个新工具，通常会...',
    options: [
      { text: '先研究每个功能，摸清每个按钮是干嘛的', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '直接上手就用，先把事干了再说', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '不太主动，需要引导', scores: { explore: 0, apply: 0, create: 1 } },
    ]
  },
  {
    id: 3,
    title: '如果孩子能用AI工具（比如ChatGPT），最可能...',
    options: [
      { text: '好奇地问"它怎么工作的？"——想了解原理', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '用它完成任务——写作文、查资料、做PPT', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '用它画画、写故事、创作原创内容', scores: { explore: 0, apply: 0, create: 2 } },
    ]
  },
  {
    id: 4,
    title: '孩子对动手创作的态度是？',
    options: [
      { text: '非常喜欢——手工、画画、搭积木、写故事', scores: { explore: 0, apply: 0, create: 2 } },
      { text: '还行——不排斥，但不会主动', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '不太感兴趣——更喜欢看书或看视频', scores: { explore: 1, apply: 0, create: 0 } },
    ]
  },
  {
    id: 5,
    title: '孩子使用电子设备的情况是？',
    options: [
      { text: '每天主动使用，还会探索新功能', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '主要在大人监督下使用（网课、作业）', scores: { explore: 0, apply: 1, create: 0 } },
      { text: '接触很少，严格限制', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  },
  {
    id: 6,
    title: '孩子最近问过你关于AI的问题吗？',
    options: [
      { text: '问过——"ChatGPT是什么？""AI会取代人类吗？"', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '听说过但没追问', scores: { explore: 0, apply: 1, create: 0 } },
      { text: '没提过', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  },
  {
    id: 7,
    title: '如果给孩子一个AI工具，他会...',
    options: [
      { text: '各种问题都试试，看它能做什么', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '在大人的指导下用它解决具体问题', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '不知道怎么用，或不感兴趣', scores: { explore: 0, apply: 0, create: 0 } },
    ]
  },
  {
    id: 8,
    title: '你希望孩子从学AI中获得什么？（选出最优先的）',
    options: [
      { text: '保持好奇心和探索能力', scores: { explore: 2, apply: 0, create: 0 } },
      { text: '掌握实用工具，提高学习效率', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '培养创造力和表达能力', scores: { explore: 0, apply: 0, create: 2 } },
    ]
  },
  {
    id: 9,
    title: '你对孩子使用科技产品的态度是？',
    options: [
      { text: '开放但有规矩——可以用，但限时间', scores: { explore: 2, apply: 1, create: 1 } },
      { text: '保守——能不用就不用', scores: { explore: 0, apply: 0, create: 0 } },
      { text: '中立——让他们用吧，反正管不住', scores: { explore: 1, apply: 0, create: 0 } },
    ]
  },
  {
    id: 10,
    title: '如果有免费的AI学习路线图，你最想解决什么问题？',
    options: [
      { text: '"我不懂AI，不知道怎么引导孩子"', scores: { explore: 1, apply: 0, create: 0 } },
      { text: '"孩子已经在接触AI了，我想要更系统的引导"', scores: { explore: 0, apply: 2, create: 0 } },
      { text: '"孩子对AI不感兴趣，要不要推一把？"', scores: { explore: 0, apply: 0, create: 0.5 } },
    ]
  }
];

// ===== 结果模板 =====
const RESULTS = {
  explore: {
    icon: '\uD83D\uDD0D',
    label: '探索型',
    badge: '好奇心驱动',
    desc: '这个小发明家充满好奇心——总爱问"为什么"和"如果...会怎样"。你的孩子是天生的探索者，喜欢自己发现事物。',
    mva: '打开一个免费AI聊天工具（如豆包或文心一言），让孩子问三个"为什么"。观察：孩子是相信答案还是质疑它？零准备，今晚就能做。',
    direction: 'AI基础原理、ChatGPT对话实验、AI伦理讨论',
    ageAdvice: {
      '6-9': 'AI故事 + AI小实验 + 简单因果游戏',
      '10-12': 'AI原理（机器学习入门）+ 数据可视化小项目',
      '13-18': 'AI伦理 + Python+AI入门 + 职业探索',
    },
    service: '我们提供"AI探索型家庭学习方案"，包含AI基础课程、亲子对话指南和分龄学习路径。从孩子的第一次AI实验开始，系统构建科学思维。',
    parentNote: 'In the AI era, curiosity is your child\'最宝贵的资产。你的角色不是回答每个问题，而是帮他们找到探索AI的起点。'
  },
  apply: {
    icon: '\uD83D\uDEE0\uFE0F',
    label: '应用型',
    badge: '实用导向',
    desc: 'This little pragmatist doesn\'t like empty talk — they care about "what can this do for me?" Your child values efficiency and results, and is good at using tools to solve real problems.',
