          result.type === 'explore'
            ? '<a href="/en/blog/ai_education_future/" style="display:block;font-size:13px;color:#0F2B46;margin:4px 0;">📖 孩子如何学AI才能不被淘汰？</a><a href="/en/blog/ai_anxiety_three_steps_2026/" style="display:block;font-size:13px;color:#0F2B46;margin:4px 0;">💡 AI Anxiety? 3 Steps to Rekindle 你的孩子 Curiosity</a><a href="/en/blog/is_ai_dulling_minds_2026/" style="display:block;font-size:13px;color:#0F2B46;margin:4px 0;">🧠 AI让人变笨？三项独立研究给出回答</a>'
          : result.type === 'apply'
