---
import Base from '../../layouts/Base.astro';
---

<Base
  title="About"
  description="About Beacon Consulting — founder Connie and the core team."
  lang="en"
  path="/en/about/"
>
  <section class="section" style="padding-top:100px;">
    <div class="container">
      <p class="section-label">About</p>
      <h1>Beacon Consulting</h1>
      <p style="font-size:17px;color:var(--color-text-secondary);max-width:600px;">
        A new kind of consultancy — grounded in Human-AI Fit research, delivered through real-world practice.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container grid-2" style="align-items:start;">
      <div>
        <h2 style="font-size:1.3rem;margin-bottom:var(--spacing-md);">The Name</h2>
        <p style="color:var(--color-text-secondary);">
          Beacon — a lighthouse. In an era where everyone is "using AI" but few are genuinely growing stronger because of it, we aim to be a beacon, guiding organizations and individuals toward true human-AI synergy.
        </p>
        <p style="color:var(--color-text-secondary);">
          The Chinese name <strong>彼恳</strong> (Bǐ Kěn) is a phonetic translation of Beacon. The domain <strong>humanaifit.com</strong> directly expresses our core research focus.
        </p>

        <h2 style="font-size:1.3rem;margin:var(--spacing-xl) 0 var(--spacing-md);">Founder</h2>
        <img src="/images/people/founder-about-2026-09.jpg" alt="Dr. Connie Wu at the Asia Academy of Management Annual Conference" loading="lazy"
             style="width:100%;max-width:420px;border-radius:14px;box-shadow:0 10px 30px rgba(15,43,70,0.16);margin-bottom:var(--spacing-md);" />
        <p style="color:var(--color-text-secondary);">
          Dr. Connie Wu — Researcher, knowledge entrepreneur, human-AI architect.
        </p>
        <p style="color:var(--color-text-secondary);">
          Specializing in Human-AI Fit, enterprise globalization, and knowledge management. Combining academic rigor with industry experience to design sustainable human-AI capability systems.
        </p>

        <div style="margin:var(--spacing-xl) 0;padding:var(--spacing-lg);background:#f8f6f2;border-radius:8px;border-left:3px solid var(--color-accent);">
          <p style="font-size:12px;color:#8b7355;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:var(--spacing-sm);">Academic Affiliations</p>
          <div style="display:flex;flex-direction:column;gap:10px;">
            <div style="font-size:14px;color:var(--color-primary);line-height:1.8;">
              <p style="font-weight:600;color:var(--color-primary);margin-bottom:6px;">Dr. Chuanjuan Wu (Connie)</p>
              <ul style="list-style:none;padding:0;margin:0;font-size:13px;color:var(--color-text-secondary);">
                <li>• Researcher of Global Artificial Intelligence Center, Emlyon Business School (<a href="https://www.em-lyon.com.cn/researchcentre/BIC/bic-academic-members" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);">https://www.em-lyon.com.cn/researchcentre/BIC/bic-academic-members</a>)</li>
                <li>• Expert Committee Member of the hub for Business Innovation & Globalization (<a href="https://www.em-lyon.com.cn/researchcentre/BIG/expert-committee" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);">https://www.em-lyon.com.cn/researchcentre/BIG/expert-committee</a>)</li>
                <li>• Industry Expert of Good Business Center (<a href="https://www.em-lyon.com.cn/researchcentre/good-business-center/industry-experts" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);">https://www.em-lyon.com.cn/researchcentre/good-business-center/industry-experts</a>)</li>
                <li>• WOL Coach Since 2019 (<a href="https://www.workingoutloud.com/coaches/connie-wu" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);">https://www.workingoutloud.com/coaches/connie-wu</a>)</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Academic communities -->
        <div style="margin:var(--spacing-xl) 0;">
          <p style="font-size:12px;color:#8b7355;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:var(--spacing-md);">Academic Communities</p>
          <div class="about-photo-wall">
            <a class="about-photo-cell" href="https://www.gerpisa.org" target="_blank" rel="noopener noreferrer">
              <img src="/images/people/org-gerpisa-2025.jpg" alt="Dr. Connie Wu at the 33rd GERPISA International Colloquium" loading="lazy" />
              <span class="about-photo-cap"><strong>GERPISA</strong> 2025 · Int'l Network of Automotive Industry Research</span>
            </a>
            <a class="about-photo-cell" href="https://www.chinagoesglobal.org" target="_blank" rel="noopener noreferrer">
              <img src="/images/people/org-cga-2026.jpg" alt="Dr. Connie Wu at the China Goes Global 2026 Conference" loading="lazy" />
              <span class="about-photo-cap"><strong>China Goes Global</strong> 2026 · Chinese Globalization Association</span>
            </a>
            <a class="about-photo-cell" href="https://www.aaom.asia" target="_blank" rel="noopener noreferrer">
              <img src="/images/people/org-aaom-2026.jpg" alt="Dr. Connie Wu at the 14th Asia Academy of Management Conference" loading="lazy" />
              <span class="about-photo-cap"><strong>AAOM</strong> 2026 · Asia Academy of Management</span>
            </a>
          </div>
          <p style="font-size:13px;color:var(--color-text-muted);margin-top:var(--spacing-md);line-height:1.8;">
            GERPISA — International Network of Automotive Industry Research · China Goes Global Association · AAOM — Asia Academy of Management.
          </p>
        </div>

        <h2 style="font-size:1.3rem;margin:var(--spacing-xl) 0 var(--spacing-md);">Our Team</h2>
        <p style="color:var(--color-text-secondary);">
          A "human + AI" hybrid team. Beyond our founder, the core team includes specialized AI Agents:
        </p>
        <ul style="list-style:none;padding:0;color:var(--color-text-secondary);font-size:14px;">
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">🧠 Main Orchestrator — coordinator, task distribution & quality control</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">🌍 Globalization Researcher — China enterprise globalization & academic research</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">🤝 Human-AI Fit Researcher — interdisciplinary theory & compliance research</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">📚 Knowledge Coach — knowledge distillation, case study & competitive analysis</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">🏗️ AI Product Manager — AI product strategy, requirements analysis & MVP design</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">🏫 AI Teacher — AI-assisted instructional design & personalized learning paths</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">📖 AI Student — self-directed learning methodology & personal growth strategy</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">🌿 CBAM Carbon Assistant — 30-second self-check for EU carbon tariff impact</li>
          <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">🧪 AI Literacy Diagnosis — quantitative AI capability assessment for all ages</li>
          <li style="padding:8px 0;">🔧 More specialized AI Agents coming soon…</li>
        </ul>
      </div>
      <div style="padding:var(--spacing-xl);background:var(--color-primary);color:white;border-radius:8px;">
        <p class="section-label" style="color:var(--color-accent);">Core Belief</p>
        <blockquote style="font-size:18px;font-style:normal;line-height:1.7;margin:var(--spacing-lg) 0;border-left:3px solid var(--color-accent);padding-left:var(--spacing-lg);">
          True competitive strength does not come from AI alone,<br>
          but from the synergy between human intelligence and artificial intelligence.
        </blockquote>
        <p style="font-size:13px;opacity:0.7;margin-top:var(--spacing-xl);">— We live this conviction every day.</p>
      </div>
    </div>
  </section>

  <section class="section section-dark text-center">
    <div class="container">
      <h2>Want to Talk?</h2>
      <p style="max-width:500px;margin:var(--spacing-md) auto var(--spacing-xl);opacity:0.85;font-size:15px;">
        Whether you're optimizing AI use in your organization or preparing for CBAM, we'd love to listen.
      </p>
      <a href="/en/contact/" class="btn btn-primary">Contact Us →</a>
    </div>
  </section>

  <!-- Lead form -->
  <section class="section" style="background:#f8f7f4;">
    <div class="container">
      <div class="huma-lead-section">
        <div class="huma-lead-title">Leave your contact, let's talk</div>
        <div class="huma-lead-sub">Tell me your direction; I reply personally within 24h. Used only to reply — no ads.</div>
        <form class="huma-lead-form" id="leadForm-about" onsubmit="return humaSubmitLead(event, 'about')">
          <label>Your name</label>
          <input type="text" name="name" required placeholder="Your name or nickname" />
          <label>Email</label>
          <input type="email" name="email" required placeholder="you@example.com" />
          <label>What are you interested in?</label>
          <select name="intent" required>
            <option value="">Select</option>
            <option>Human-AI Fit Consulting</option>
            <option>AI Literacy Diagnosis</option>
            <option>CBAM Carbon Compliance</option>
            <option>Globalization Strategy</option>
            <option>Content Subscription</option>
            <option>Other</option>
          </select>
          <label>What do you want to solve? (optional)</label>
          <textarea name="note" placeholder="Briefly describe your need"></textarea>
          <p class="huma-lead-note">A real person (not a bot). No phone number collected. Erasable anytime.</p>
          <button type="submit" class="huma-lead-submit">Send</button>
          <div class="huma-lead-msg" id="leadMsg-about"></div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    async function humaSubmitLead(e, source) {
      e.preventDefault();
      var f = e.target, msg = document.getElementById('leadMsg-' + source), btn = f.querySelector('.huma-lead-submit');
      var data = { name: f.name.value, email: f.email.value, intent: f.intent.value, note: f.note.value, source: source };
      btn.disabled = true; btn.textContent = 'Sending...';
      try {
        await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        msg.className = 'huma-lead-msg ok'; msg.textContent = '✅ Received. I will reply within 24h.';
        f.reset();
      } catch (err) { msg.className = 'huma-lead-msg err'; msg.textContent = 'Failed. Please try again.'; }
      btn.disabled = false; btn.textContent = 'Send';
    }
  </script>


<style is:global>
  .about-photo-wall { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
  .about-photo-cell {
    display: block; text-decoration: none; background: #fff;
    border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden;
    box-shadow: 0 6px 18px rgba(15,43,70,0.08);
    transition: transform .25s, box-shadow .25s;
  }
  .about-photo-cell:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,43,70,0.16); }
  .about-photo-cell img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .about-photo-cap { display: block; padding: 10px 12px; font-size: 12px; line-height: 1.5; color: var(--color-text-secondary); }
  .about-photo-cap strong { color: var(--color-primary); display: block; font-size: 13px; }
</style>

</Base>
