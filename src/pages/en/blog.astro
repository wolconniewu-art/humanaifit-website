const tagGroups = ["All", "About", "Human-AI Fit", "Carbon Compliance", "Globalization", "AI Governance & Policy", "Frontier Tech", "AI & Organization", "AI Education & Talent", "Culture", "Policy Tables"];
---

<Base title="Blog" description="Deep dives on Human-AI Fit, carbon compliance, globalization and knowledge management." lang="en" path="/en/blog/">
  <section class="section" style="padding-top:96px;">
    <div class="container text-center" style="position:relative;z-index:1;">
      <p class="section-label" style="color:var(--color-accent);font-weight:600;">Blog</p>
      <h1>Thinking at the Frontier</h1>
      <p style="max-width:600px;margin:var(--spacing-md) auto 0;color:var(--color-text-secondary);font-size:16px;">
        Deep dives on Human-AI Fit, carbon compliance, globalization and knowledge management.
      </p>
    </div>
  </section>

  <!-- Tag filter -->
  <section style="padding:24px 0;border-bottom:1px solid var(--color-border);">
    <div class="container" style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;">
      {tagGroups.map(tag => (
        <span class={`tag-filter ${tag === 'All' ? 'tag-active' : ''}`} data-tag={tag === 'All' ? 'all' : tag}>
          {tag}
        </span>
      ))}
    </div>
  </section>

  <!-- Pinned articles -->
  <section class="section">
    <div class="container" id="article-list">
      {pinned.length > 0 && (
        <div style="margin-bottom:48px;">
          <h3 style="font-size:1.1rem;color:var(--color-accent);margin-bottom:24px;font-weight:500;">📌 Featured</h3>
          <div style="display:grid;gap:20px;">
            {pinned.map(item => (
              <a href={`/en/blog/${item.slug}/`} class="article-card"
                data-tags={item.tags}
                style="display:flex;justify-content:space-between;align-items:center;
                       padding:20px 24px;border-radius:12px;background:linear-gradient(135deg,rgba(201,169,110,0.08),rgba(201,169,110,0.02));
                       border:1px solid rgba(201,169,110,0.3);transition:all 0.25s;
                       text-decoration:none;gap:24px;">
                <div style="flex:1;min-width:0;display:flex;align-items:center;gap:16px;">
                  <ArticleCover title={item.title} tags={item.tags} size="64px" radius="12px" />
                  <div style="min-width:0;flex:1;">
                  <div style="font-size:15px;font-weight:600;color:var(--color-primary);margin-bottom:6px;line-height:1.4;">
                    {item.title}
                  </div>
                  <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    {item.tags.split(', ').map(t => (
                      <span style="padding:2px 8px;background:rgba(201,169,110,0.1);border-radius:10px;font-size:11px;color:var(--color-accent-dark);">{t}</span>
                    ))}
                  </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="blog-grid" id="blog-grid">
        {articles.map(item => (
          <a href={`/en/blog/${item.slug}/`} class="article-card"
            data-tags={item.tags}
            style="display:flex;flex-direction:column;
                   padding:0;border-radius:14px;background:var(--color-surface);
                   border:1px solid var(--color-border);transition:all 0.25s;
                   text-decoration:none;overflow:hidden;">
            <ArticleCover title={item.title} tags={item.tags} banner={true} radius="0" />
            <div style="padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px;flex:1;">
              <div style="font-size:15.5px;font-weight:600;color:var(--color-primary);line-height:1.5;">
                {item.title}
              </div>
              <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;">
                {item.tags.split(', ').slice(0,3).map(t => (
                  <span style="padding:2px 8px;background:rgba(201,169,110,0.1);border-radius:10px;font-size:11px;color:var(--color-accent-dark);">{t}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-dark text-center">
    <div class="container">
      <h2>Don't want to miss updates?</h2>
      <p style="max-width:500px;margin:var(--spacing-md) auto var(--spacing-xl);opacity:0.85;font-size:15px;">
        Leave your contact and we'll notify you when new articles are published.
      </p>
      <a href="/en/contact/" class="btn btn-primary">Subscribe →</a>
    </div>
  </section>
</Base>

<style is:global>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 980px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); gap: 18px; }
  }
  @media (max-width: 600px) {
    .blog-grid { grid-template-columns: 1fr; gap: 16px; }
  }
  .article-card { height: 100%; }
  .article-card:hover {
    border-color: var(--color-accent) !important;
    box-shadow: 0 6px 20px rgba(201,169,110,0.16);
    transform: translateY(-3px);
  }
  .tag-filter {
    display:inline-block;
    padding:6px 16px;
    border-radius:20px;
    font-size:13px;
    font-weight:500;
    cursor:pointer;
    transition:all 0.2s;
    border:1.5px solid var(--color-border);
    color:var(--color-text-secondary);
    background:transparent;
  }
  .tag-filter:hover {
    border-color: var(--color-accent) !important;
    color: var(--color-accent-dark) !important;
  }
  .tag-filter.tag-active {
    background: var(--color-primary) !important;
    color: white !important;
    border-color: var(--color-primary) !important;
  }
</style>

<script>
  function filterArticles(el) {
    document.querySelectorAll('.tag-filter').forEach(t => t.classList.remove('tag-active'));
    el.classList.add('tag-active');
    
    const tag = el.dataset.tag;
    document.querySelectorAll('.article-card').forEach(card => {
      if (tag === 'all' || card.dataset.tags.includes(tag)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  document.querySelectorAll('.tag-filter').forEach(el => {
    el.addEventListener('click', () => filterArticles(el));
  });
</script>
