      <h1>Why Are AI Leaders Suddenly Calling for a Brake? A Structural Analysis of Speed, Control, and Competition</h1>
      <div class="article-meta">
        <span>"2026-09-15"</span>
        {tags.filter(Boolean).map(t => <span class="tag">{t}</span>)}
      </div>
    </div>
