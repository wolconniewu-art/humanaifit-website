              const es = opt.scores.explore || 0;
              const aa = opt.scores.apply || 0;
              const cc = opt.scores.create || 0;
              const maxS = Math.max(es, aa, cc);
              let note = '';
              if (maxS > 0) {
                if (es === maxS && es > 0) note = '➕ 增加了“Explore型”倾向';
                else if (aa === maxS && aa > 0) note = '➕ 增加了“Apply型”倾向';
                else if (cc === maxS && cc > 0) note = '➕ 增加了“Create型”倾向';
              } else {
                note = '— Background info, not scored for tendency';
