  <script is:inline>
(function() {
  const QUESTIONS = JSON.parse(document.getElementById('adult-questions-data').textContent);

  const DIMENSIONS = [
    { id:'ai_tool_competency', name:'AI Tool Competency', layer:'base', color:'#3b82f6' },
    { id:'data_decision', name:'Data-Driven Decision', layer:'base', color:'#3b82f6' },
    { id:'workflow_design', name:'Workflow Design', layer:'base', color:'#3b82f6' },
    { id:'ai_creativity', name:'AI Creativity', layer:'advanced', color:'#3b82f6' },
    { id:'ai_judgment', name:'AI Judgment', layer:'advanced', color:'#3b82f6' },
    { id:'human_ai_collab', name:'Human-AI Collab', layer:'advanced', color:'#3b82f6' },
    { id:'ai_strategy', name:'AI Strategy', layer:'leadership', color:'#3b82f6' },
    { id:'ai_self_awareness', name:'AI Self-Awareness', layer:'leadership', color:'#8b5cf6' },
  ];
  const LAYER_NAMES = { base:'Base Layer — AI-Enabled', advanced:'Advanced Layer — Co-creating with AI', leadership:'Leadership Layer — Steering AI' };
  const LAYER_ORDER = ['base','advanced','leadership'];

  let currentIndex = 0;
  const answers = {};
  let resultData = null;

  const $ = id => document.getElementById(id);
  const startPage = $('start-page');
  const quizPage = $('quiz-page');
  const resultPage = $('result-page');
  const qCard = $('q-card');
  const qProgress = $('q-progress');
  const qFill = $('q-progress-fill');
  const prevBtn = $('prev-btn');
  const nextBtn = $('next-btn');

  $('start-btn').addEventListener('click', () => {
    startPage.style.display = 'none';
    quizPage.style.display = 'block';
    currentIndex = 0;
    renderQuestion(0);
    updateButtons();
    window.scrollTo({top:0,behavior:'smooth'});
  });

  function renderQuestion(idx) {
    const q = QUESTIONS[idx];
    qCard.innerHTML = `<div class="stem">${q.stem}</div>
      <div class="options">${q.options.map(o =>
        `<div class="option ${answers[q.id]===o.id?'selected':''}" data-q="${q.id}" data-opt="${o.id}">
          <span class="option-radio">${answers[q.id]===o.id?'●':'○'}</span>
          <span>${o.text}</span>
        </div>`
      ).join('')}</div>
      <div class="q-footer-text">${QUESTIONS.length - idx - 1} more questions</div>`;
    qCard.querySelectorAll('.option').forEach(el => {
      el.addEventListener('click', () => {
        answers[el.dataset.q] = el.dataset.opt;
        renderQuestion(idx);
        updateButtons();
      });
    });
  }

  function updateButtons() {
    const q = QUESTIONS[currentIndex];
    prevBtn.disabled = currentIndex === 0;
    nextBtn.disabled = !answers[q.id];
    nextBtn.textContent = currentIndex < QUESTIONS.length - 1 ? 'Next →' : 'See Results';
    qProgress.textContent = `Q ${currentIndex + 1} / ${QUESTIONS.length}`;
    qFill.style.width = `${((currentIndex + 1) / QUESTIONS.length) * 100}%`;
  }

  prevBtn.addEventListener('click', () => {
    if (currentIndex > 0) { currentIndex--; renderQuestion(currentIndex); updateButtons(); window.scrollTo({top:0,behavior:'smooth'}); }
  });

  nextBtn.addEventListener('click', () => {
    if (currentIndex < QUESTIONS.length - 1) {
      currentIndex++; renderQuestion(currentIndex); updateButtons(); window.scrollTo({top:0,behavior:'smooth'});
    } else {
      calculateAndShowResult();
    }
  });

  function calculateAndShowResult() {
    const dimScores = {};
    DIMENSIONS.forEach(d => { dimScores[d.id] = { total:0, weight:0 }; });

    QUESTIONS.forEach(q => {
      const optId = answers[q.id];
      if (!optId) return;
      const opt = q.options.find(o => o.id === optId);
      if (!opt) return;
      const weight = q.difficulty === 'hard' ? 2.0 : q.difficulty === 'medium' ? 1.5 : 1.0;
      const dim = q.dimension;
      if (dimScores[dim]) {
        dimScores[dim].total += opt.score * weight;
        dimScores[dim].weight += 4 * weight;
      }
    });

    const dimQuestionCount = {};
    QUESTIONS.forEach(q => {
      if (answers[q.id]) dimQuestionCount[q.dimension] = (dimQuestionCount[q.dimension]||0) + 1;
    });

    const dimensions = DIMENSIONS.map(d => {
      const raw = dimScores[d.id];
      let score = 0;
      if (raw && raw.weight > 0) score = Math.round((raw.total / raw.weight) * 100);
      score = Math.max(0, Math.min(100, score));
      const label = score >= 76 ? 'excellent' : score >= 56 ? 'good' : 'needs_improvement';
      return { dimensionId: d.id, name: d.name, score, label, color: d.color, layer: d.layer };
    });

    const overallScore = Math.round(dimensions.reduce((s,d) => s + d.score, 0) / dimensions.length);
    const sorted = [...dimensions].sort((a,b) => a.score - b.score);
    const weakest = sorted[0];
    const strongest = sorted[sorted.length - 1];
    resultData = { dimensions, overallScore, weakest, strongest };
    quizPage.style.display = 'none';
    resultPage.style.display = 'block';
    renderResult();
    window.scrollTo({top:0,behavior:'smooth'});
  }

  function renderResult() {
    const rc = $('result-content');
    const d = resultData;
    let html = '';

    html += `<div style="text-align:center;margin-bottom:16px;">
      <div style="font-size:40px;font-weight:700;color:#0F2B46;">${d.overallScore}</div>
      <div style="font-size:14px;color:#888;">Overall Score (out of 100)</div>
    </div>`;

    LAYER_ORDER.forEach(layer => {
      const dims = d.dimensions.filter(dm => dm.layer === layer);
      if (dims.length === 0) return;
      const avgScore = Math.round(dims.reduce((s,dm) => s + dm.score, 0) / dims.length);
      html += `<div class="layer-block">
        <div class="layer-header">${LAYER_NAMES[layer]}  ${avgScore}/100</div>`;
      dims.forEach(dm => {
        const barColor = dm.score <= 30 ? '#ef4444' : dm.score <= 55 ? '#f59e0b' : dm.score <= 75 ? '#3b82f6' : '#22c55e';
        const isWeakest = dm.dimensionId === d.weakest.dimensionId;
        const isD08 = dm.dimensionId === 'ai_self_awareness';
        const barStyle = isD08
          ? `width:${dm.score}%;background:repeating-linear-gradient(0deg,${barColor},${barColor} 3px,transparent 3px,transparent 6px);`
          : `width:${dm.score}%;background:${barColor};`;
        html += `<div class="dim-row">
          <div class="dim-name">${isD08 ? '⭐ ' : ''}${dm.name}</div>
          <div class="dim-bar-bg"><div class="dim-bar-fill" style="${barStyle}"></div></div>
          <div class="dim-score">${dm.score}</div>
          <div class="dim-badge">${isWeakest ? '⚠️' : dm.score >= 76 ? '⭐' : ''}</div>
        </div>`;
      });
      html += '</div>';
    });

    html += `<div class="weakness-box">
      <h3>⚠️ Your biggest growth area: ${d.weakest.name} (${d.weakest.score})</h3>
      <p>Start with "Action of the Day" — only 1 minute.</p>
    </div>`;

    html += `<div class="cta-box">
      <h3>📋 Action of the Day (1 min)</h3>
      <p>Your biggest growth area: ${d.weakest.name}<br>Try this first:</p>
      <div class="cta-prompt-box">
        <strong>Copy this and paste into your AI tool:</strong><br>
        "Summarize in one sentence what AI means for my career in 2026"
        <button id="copy-prompt-btn" class="cta-btn cta-btn-blue" style="display:block;width:100%;margin-top:8px;">📋 Copy</button>
      </div>
      <button id="step1-done-btn" class="cta-btn cta-btn-green" style="opacity:0.5;">✅ I did it</button>
      <button id="feedback-trigger-btn" class="cta-btn cta-btn-ghost">💬 Not happy with the result?</button>
      <p style="font-size:12px;color:#999;margin-top:8px;">After completing, the system will unlock W1 action cards to improve your weaker areas.</p>
    </div>`;

    html += `<div class="paywall">
      <h3>🔒 Full Diagnosis Report</h3>
      <div class="price">$29</div>
      <ul>
        <li>Complete 8D scores + comparative analysis</li>
        <li>W1-W4 full action cards</li>
        <li>Peer comparison (same industry & role)</li>
        <li>Personalized improvement plan</li>
      </ul>
      <button class="cta-btn cta-btn-blue" onclick="showAdultPayment()">Buy Now $29</button>
      <p style="font-size:12px;color:#999;margin-top:6px;">Scan WeChat to pay · Contact us after payment</p>
    </div>`;

    rc.innerHTML = html;
    bindResultEvents();
  }

  function bindResultEvents() {
    const copyBtn = $('copy-prompt-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('Summarize in one sentence what AI means for my career in 2026').then(() => {
          copyBtn.textContent = '✅ Copied';
          copyBtn.style.background = '#22c55e';
          $('step1-done-btn').style.opacity = '1';
        });
      });
    }
    const step1Btn = $('step1-done-btn');
    if (step1Btn) step1Btn.addEventListener('click', showTransition);
    const fbBtn = $('feedback-trigger-btn');
    if (fbBtn) fbBtn.addEventListener('click', showFeedback);
  }

  function showTransition() {
    const rc = $('result-content');
    rc.innerHTML = `
      <div class="transition-page">
        <div style="font-size:64px;margin-bottom:16px;">🎉</div>
        <h2>Great start! You've taken the first step in your AI growth journey</h2>
        <p>You just copied a prompt and saw how AI responds.<br>
        Want to know:<br>
        <strong>"How do I make AI understand me better?"</strong><br>
        <strong>"How do I write better prompts?"</strong></p>
        <p>Next, you'll love this 👇</p>
        <div style="background:#f0f0f0;border-radius:12px;padding:20px;margin:24px 0;text-align:left;">
          <h3 style="font-size:16px;margin-bottom:8px;">📋 W1 Task: Write a "4-Element Prompt Template"</h3>
          <p style="font-size:13px;color:#666;margin-top:8px;">Do it today (10 min):<br>Open your AI tool, type:<br><strong>Role + Format + Constraints + Example → Generate</strong></p>
        </div>
        <div style="background:#fff8e1;border-radius:12px;padding:16px;margin:16px 0;">
          <p style="font-size:13px;color:#333;">🔒 Full guide in the paid report ($29)<br>Or the system will push to you tomorrow</p>
        </div>
        <button id="back-to-result-btn" class="cta-btn cta-btn-blue">Back to Report</button>
        <button id="try-another-btn" class="cta-btn cta-btn-ghost" style="display:block;width:100%;margin-top:8px;">▼ Try a different prompt</button>
        <div id="try-another-area" style="display:none;margin-top:12px;">
          <div class="cta-prompt-box">
            <strong>Try this:</strong><br>
            "Describe AI's impact on my career in 3 words, each with an example"
            <button id="copy2-btn" class="cta-btn cta-btn-blue" style="display:block;width:100%;margin-top:8px;">📋 Copy</button>
          </div>
        </div>
        <button id="share-btn" class="cta-btn cta-btn-ghost" style="display:block;width:100%;margin-top:8px;">📤 Share to social (anonymous radar)</button>
      </div>`;
    $('back-to-result-btn').addEventListener('click', renderResult);
    $('try-another-btn').addEventListener('click', () => {
      const area = $('try-another-area');
      area.style.display = area.style.display === 'none' ? 'block' : 'none';
    });
    const copy2 = $('copy2-btn');
    if (copy2) copy2.addEventListener('click', () => {
      navigator.clipboard.writeText("Describe AI's impact on my career in 3 words, each with an example").then(() => copy2.textContent = '✅ Copied');
    });
    const shareBtn = $('share-btn');
    if (shareBtn) shareBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('I just completed the AI Workplace Diagnosis — 27 questions across 8 dimensions. Try it: https://www.humanaifit.com/en/diagnosis/adult/').then(() => alert('Copied! Share it on social.'));
    });
    window.scrollTo({top:0,behavior:'smooth'});
  }

  let feedbackLevel = 0;
  function showFeedback() {
    const rc = $('result-content');
    rc.innerHTML = '<div class="feedback-ring"><h4>Try a different approach</h4><p style="font-size:13px;color:#555;margin-bottom:12px;">Add this to your prompt:<br><strong>"Explain in detail with a concrete example"</strong></p><button id="fb-retry-btn" class="cta-btn cta-btn-blue">✅ Auto-add and copy</button><button id="fb-level2-btn" class="cta-btn cta-btn-ghost" style="display:block;width:100%;margin-top:8px;">↓ Still not right? Other options</button></div>';
    $('fb-retry-btn').addEventListener('click', () => {
      navigator.clipboard.writeText('Explain in detail with a concrete example').then(() => alert('Copied! Paste into your AI tool.'));
    });
    $('fb-level2-btn').addEventListener('click', () => {
      rc.innerHTML = '<div class="feedback-ring"><h4>What went wrong?</h4><div><button class="feedback-btn" onclick="alert(\'Try DeepSeek/ChatGPT/Claude\')">🔧 AI tool not working</button><button class="feedback-btn" onclick="alert(\'Copy this and ask AI to explain\')">🔧 Output is confusing</button><button class="feedback-btn" onclick="alert(\'Here are more examples to try\')">🔧 Not sure what to do next</button><button class="feedback-btn" onclick="showLevel3()">🔧 Other issues</button></div></div>';
    });
    window.scrollTo({top:0,behavior:'smooth'});
  }

  window.showLevel3 = function() {
    const rc = $('result-content');
    rc.innerHTML = '<div class="feedback-ring" style="text-align:center;"><h4>💬 Still stuck?</h4><p style="font-size:13px;color:#555;margin:12px 0;">Join the AI Workplace community<br>Contact WeChat blurblurfish</p><div style="background:#f0f0f0;border-radius:8px;padding:24px;margin:16px 0;font-size:12px;color:#888;">[QR code placeholder - WeChat: blurblurfish]</div><p style="font-size:12px;color:#999;font-style:italic;">"Your biggest competitive advantage is not in AI. It is between you and AI."</p><button class="cta-btn cta-btn-ghost" onclick="renderResult()" style="margin-top:12px;">Back to Report</button></div>';
    window.scrollTo({top:0,behavior:'smooth'});
  };

  window.showAdultPayment = function() {
    document.getElementById('payment-overlay').style.display = 'flex';
    document.getElementById('pay-tier-selection').style.display = 'block';
    document.getElementById('pay-tier-detail').style.display = 'none';
  };
  window.closeAdultPayment = function() {
    document.getElementById('payment-overlay').style.display = 'none';
  };
  window.showAdultPayTier = function(tier) {
    document.getElementById('pay-tier-selection').style.display = 'none';
    document.getElementById('pay-tier-detail').style.display = 'block';
    if (tier === 'report') {
      document.getElementById('pay-detail-title').textContent = '📋 Full Diagnosis Report';
      document.getElementById('pay-detail-price').innerHTML = '$29';
    } else {
      document.getElementById('pay-detail-title').textContent = '🌟 《AI Era Survival Guide》Knowledge Planet';
      document.getElementById('pay-detail-price').innerHTML = '$199<span style="font-size:14px;font-weight:400;color:#888;">/year</span>';
    }
  };
  window.showAdultPayBack = function() {
    document.getElementById('pay-tier-selection').style.display = 'block';
    document.getElementById('pay-tier-detail').style.display = 'none';
  };
})();
</script>
</body>
