---
// CBAM Carbon Compliance Self-Check — standalone full-bleed page (no site header/nav), matches AI literacy diagnosis page
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CBAM Carbon Compliance Self-Check — Check Your Product in 30 Seconds | humanaifit</title>
  <meta name="description" content="Enter your HS code (first 6-8 digits) for a free 30-second diagnosis: Is your product affected by EU CBAM? Includes emission estimation and compliance roadmap." />
  <meta property="og:title" content="CBAM Carbon Compliance Self-Check — Check Your Product in 30 Seconds | humanaifit" />
  <meta property="og:description" content="Free 30-second CBAM diagnosis by HS code." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.humanaifit.com/en/diagnosis/cbam/" />
  <meta property="og:image" content="https://humanaifit.com/og-default.jpg" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", sans-serif; }
  </style>
</head>
<body>
  <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;">CBAM Carbon Compliance Self-Check — Check Your Product in 30 Seconds</h1>

  <div style="width:100%;height:100vh;border:none;overflow:hidden;">
    <iframe
      src="https://cbam.humanaifit.com/?lang=en&v=2"
      style="width:100%;height:100%;border:none;min-height:100vh;"
      title="CBAM Carbon Compliance Self-Check Tool"
      loading="eager"
      allow="payment"
    ></iframe>
  </div>

  <script is:inline>
    window.addEventListener('message', function(e) {
      if (e.data && e.data.type === 'resize') {
        var iframe = document.querySelector('iframe');
        if (iframe) iframe.style.height = e.data.height + 'px';
      }
    });
  </script>
</body>
</html>
