        <h3 style="margin-top:0;">A Note for Parents</h3>
        <p style="font-weight:500; color:#0F2B46; font-size:14px;">${r.parentNote}</p>
      </div>

      <!-- 全球化对标 -->
      <div class="result-section" style="background:#f5f5f5;padding:16px;border-radius:10px;margin-top:12px;">
        <h3 style="margin-top:0;">🌍 🌍 Global Perspective</h3>
        <p style="font-size:13px;color:#555;margin:4px 0;">
          Globally, AI education experts (such as the US AI4K12 framework and EU DigCompEdu) also categorize AI learners into explorers, practitioners, and creators. Your child's classification aligns with mainstream AI education frameworks worldwide. Global AI literacy education is rapidly expanding — the earlier you guide your child, the better their future prospects.
        </p>
      </div>

      <hr class="sep" />

      <div class="share-area">
              ${renderComparison()}

      <!-- 行为解读 -->
      <details style="margin:12px 0;">
        <summary style="cursor:pointer;font-weight:600;font-size:14px;color:#0F2B46;padding:8px 0;">🔍 Detailed interpretation of each question</summary>
        <div style="padding:8px;background:#fafafa;border-radius:8px;margin-top:4px;max-height:400px;overflow-y:auto;">
          ${
            QUESTIONS.map((q, qi) => {
              const ansIdx = answers[q.id];
              if (ansIdx === undefined) return '';
              const opt = q.options[ansIdx];
              const es = opt.scores.explore || 0;
              const aa = opt.scores.apply || 0;
              const cc = opt.scores.create || 0;
              const maxS = Math.max(es, aa, cc);
              let note = '';
              if (maxS > 0) {
                if (es === maxS && es > 0) note = '➕ Increased "Explorer" tendency';
                else if (aa === maxS && aa > 0) note = '➕ Increased "Practitioner" tendency';
                else if (cc === maxS && cc > 0) note = '➕ Increased "Creator" tendency';
              } else {
                note = '— Background info, not scored for tendency';
              }
              return `<div style="padding:6px 0;border-bottom:1px solid #eee;font-size:12px;color:#555;">
                <strong>Q${qi+1}:</strong> ${q.title}<br/>
                <span style="color:#888;">Your choice:</span> ${opt.text}<br/>
                <span style="color:#888;">Interpretation:</span> ${note}
              </div>`;
            }).join('')
          }
        </div>
      </details>

      <div class="share-area">
        <p class="share-description">👋 👋 Share with friends and see their child's type!</p>
        <button class="btn btn-primary" onclick="shareResult()">
          📤 Share via WeChat
        </button>
        <button class="btn btn-secondary" onclick="screenshotShare()" style="margin-top:8px;">
          📸 Save Screenshot
        </button>
        <button class="btn btn-secondary" onclick="restart()" style="margin-top:8px;">
          🔄 Diagnose Again
        </button>
      </div>
    </div>
  `;
  window.scrollTo({ top: 0, behavior: 'smooth' });

  // 延迟触发分数条动画
  setTimeout(() => {
    document.querySelectorAll('.score-fill').forEach(el => {
      const pct = el.parentElement.querySelector('.score-pct');
      if (pct) el.style.width = pct.textContent;
    });
  }, 100);
}

// ===== 分享 =====
function shareResult() {
  const r = RESULTS[result.type];
  const text = [
    'My child is ' + r.icon + r.label + ' type!',
    '',
    '22 questions, 30 seconds free diagnosis. Find your child AI learning style.',
    'https://www.humanaifit.com/diagnosis/'
  ].join('\n');

  // 先复制文案
  navigator.clipboard.writeText(text).then(() => {
    // 再生成截图保存到手机
    screenshotShare();
  }).catch(() => {
    alert('📸 复制文案失败！\n\n请手动复制↓\n' + text);
  });
}

function screenshotShare() {
  if (typeof html2canvas !== 'undefined') {
    const card = document.querySelector('.card');
    if (card) {
      html2canvas(card, { backgroundColor: '#ffffff' }).then(canvas => {
        const dataUrl = canvas.toDataURL('image/png');
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;animation:fadeIn 0.2s;';
        overlay.innerHTML = '<div style="background:white;border-radius:16px;padding:20px;max-width:360px;width:100%;text-align:center;position:relative;">' +
          '<button onclick="this.parentElement.parentElement.remove()" style="position:absolute;top:8px;left:8px;border:none;background:rgba(0,0,0,0.5);color:white;font-size:20px;width:30px;height:30px;border-radius:50%;cursor:pointer;line-height:30px;z-index:10;">x</button>' +
          '<p style="font-size:14px;color:#333;margin:0 0 12px;"><strong>Long press to save to camera roll</strong></p>' +
          '<p style="font-size:12px;color:#888;margin:0 0 12px;">You can also share this image directly on WeChat</p>' +
          '<img src="' + dataUrl + '" style="width:100%;border-radius:8px;" />' +
          '<button onclick="this.parentElement.parentElement.remove()" style="margin-top:12px;padding:10px 24px;border:none;background:#0F2B46;color:white;border-radius:8px;font-size:14px;cursor:pointer;">Close</button>' +
          '</div>';
        document.body.appendChild(overlay);
      });
    }
  } else {
    alert('📸 Please screenshot to save your diagnosis!');
  }
}

function restart() {
  // 记录本次结果到localStorage（按孩子昵称区分）
  if (result) {
    try {
      saveChildHistory({ type: result.type, scores: result.scores, pct: result.pct, date: new Date().toISOString() });
    } catch(e) {}
  }
  currentStep = 0;
  answers = {};
  result = null;
  leadSubmitted = false;
  renderStart();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ===== 留资 =====
function showLead() {
  document.getElementById('leadOverlay').classList.add('active');
}

function closeLead() {
  document.getElementById('leadOverlay').classList.remove('active');
  leadSubmitted = true;
  calculateResult();
}

function submitLead() {
  const name = document.getElementById('leadName').value.trim();
  const contact = document.getElementById('leadContact').value.trim();
  
  if (!contact) {
    alert('Please enter your WeChat ID or phone number to receive the diagnosis report');
    return;
  }
  
  const privacyCheck = document.getElementById('privacyAgree');
  if (!privacyCheck || !privacyCheck.checked) {
    alert('Please agree to the privacy policy. We protect your and your child data security');
    return;
  }
  
  // Store locally
  try {
    const leads = JSON.parse(localStorage.getItem('diagnosis_leads') || '[]');
    leads.push({ name, contact, result, timestamp: new Date().toISOString() });
    localStorage.setItem('diagnosis_leads', JSON.stringify(leads));
  } catch(e) {}

  // Send to Feishu via Cloudflare Pages Function proxy
  fetch('/api/lead', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      nickname: childNickname || 'Default',
      name: name,
      contact: contact,
      result: result ? {
        type: result.type,
        typeLabel: TYPE_LABELS_EN[result.type],
        pct: result.pct,
      } : null,
    }),
  }).catch(function(err) {
    console.error('Feishu notification failed:', err);
  });

  leadSubmitted = true;
  document.getElementById('leadOverlay').classList.remove('active');
  calculateResult();
}

// ===== 键盘支持 =====
document.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    const nextBtn = document.getElementById('nextBtn');
    if (nextBtn && !nextBtn.disabled) nextBtn.click();
  }
  if (['1','2','3'].includes(e.key)) {
    const opts = document.querySelectorAll('.option');
    const idx = parseInt(e.key) - 1;
    if (opts[idx]) opts[idx].click();
  }
});

// ===== 启动 =====
renderStart();

