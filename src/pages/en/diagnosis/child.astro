      { text: 'Knows AI can make mistakes and can give specific examples', scores: {cognitive:2,critical:1}, types: {explore:2} },
      { text: 'Knows AI can be wrong, but can\'t explain how', scores: {cognitive:1}, types: {explore:1} },
      { text: 'Uses AI\'s answer directly, doesn\'t check if it\'s correct' },
    ]
  },
  {
    id: 'ST-PRA-001',
    title: 'When you need to use AI for a learning task (writing an essay, doing research), what do you do?',
    ageRange: '10-18',
    dimension: 'practice',
    theoreticalBasis: 'Task-Technology Fit (Goodhue & Thompson, 1995)',
    options: [
      { text: 'Clearly tells AI what they want, follows up and adjusts', scores: {cognitive:1,practice:2,critical:1}, types: {explore:1,apply:2} },
      { text: 'Lets AI do everything and uses it directly without changes', types: {apply:1} },
      { text: 'Doesn\'t know how to use AI for learning tasks' },
    ]
  },
  {
    id: 'ST-PRA-001B',
    title: 'If a learning app has an AI feature that reads stories, what does your child do?',
    ageRange: '6-9',
    dimension: 'practice',
    theoreticalBasis: 'Task-Technology Fit - Scenario-based for younger children',
    options: [
      { text: 'Tries having AI read different stories and asks questions', scores: {cognitive:1,practice:2}, types: {explore:1,apply:2} },
      { text: 'Lets AI read once and moves on' },
      { text: 'Doesn\'t know how to use this feature' },
    ]
  },
  {
    id: 'ST-PRA-002',
    title: 'When your child uses AI to draw, write stories, or make videos, what usually happens?',
    ageRange: 'all',
    dimension: 'practice',
    theoreticalBasis: 'Human-AI Co-Creation (Davis, 2024)',
    options: [
      { text: 'Actively uses AI to turn ideas into work and iterates until satisfied', scores: {practice:2,digital:1}, types: {apply:1,create:2} },
      { text: 'Willing to try but needs adult guidance' },
      { text: 'Not interested in AI creation, prefers traditional methods', types: {create:1} },
    ]
  },
  {
    id: 'ST-SOC-001',
    title: 'When your child hears that AI will replace human jobs, how do they react?',
    ageRange: '10-18',
    dimension: 'social',
    theoreticalBasis: 'AI Ethics + CASEL Social Awareness (Floridi et al., 2018)',
    options: [
      { text: 'Seriously discusses which jobs AI can do and which need humans', scores: {social:2,critical:1}, types: {explore:2} },
      { text: 'Discusses it with friends but can\'t articulate what to do', scores: {social:1} },
      { text: 'Hears it and moves on, doesn\'t discuss with child' },
