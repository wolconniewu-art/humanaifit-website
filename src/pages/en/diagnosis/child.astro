      { text: 'Argues that mom and dad are better - humans and robots are different', scores: {social:2,critical:1}, types: {explore:1} },
      { text: 'Asks "Can the robot cook?" - compares humans and machines', scores: {cognitive:1,social:1}, types: {explore:2} },
