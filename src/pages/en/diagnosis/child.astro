    isScreening: true
  },
  {
    id: 'ST-COG-001',
    title: 'When your child sees AI answering questions, how do they usually react?',
    ageRange: '10-18',
    dimension: 'cognitive',
    theoreticalBasis: 'AI4K12 Big Idea #1: Perception/Representation/Reasoning',
    options: [
      { text: 'Curiously asks "How did it learn to answer?"', scores: {cognitive:2}, types: {explore:2} },
      { text: 'Uses it directly to answer questions, saves time from looking it up', scores: {practice:2}, types: {apply:2} },
      { text: 'Doesn\'t care about how it works, just thinks it\'s cool', scores: {digital:1} },
    ]
  },
  {
    id: 'ST-COG-001B',
    title: 'When seeing a robot answer questions, what does your child do?',
    ageRange: '6-9',
    dimension: 'cognitive',
    theoreticalBasis: 'AI4K12 Big Idea #1 - Scenario-based for younger children',
    options: [
      { text: 'Asks "How does it know the answer?" - wants to understand', scores: {cognitive:2}, types: {explore:2} },
      { text: 'Keeps asking it more questions, finds it fun', scores: {practice:1}, types: {apply:2} },
      { text: 'Doesn\'t care much, walks away' },
