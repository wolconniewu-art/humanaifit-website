    dimension: 'practice',
    theoreticalBasis: 'Task-Technology Fit - Scenario-based for younger children',
    options: [
      { text: 'Tries having AI read different stories and asks questions', scores: {cognitive:1,practice:2}, types: {explore:1,apply:2} },
      { text: 'Lets AI read once and moves on' },
      { text: 'Doesn\'t know how to use this feature' },
    ]
  },
  {
    id: 'ST-PRA-002',
    title: 'When your child uses AI to draw, write stories, or make videos, what usually happens?',
    ageRange: 'all',
    dimension: 'practice',
    theoreticalBasis: 'Human-AI Co-Creation (Davis, 2024)',
    options: [
      { text: 'Actively uses AI to turn ideas into work and iterates until satisfied', scores: {practice:2,digital:1}, types: {apply:1,create:2} },
      { text: 'Willing to try but needs adult guidance' },
      { text: 'Not interested in AI creation, prefers traditional methods', types: {create:1} },
