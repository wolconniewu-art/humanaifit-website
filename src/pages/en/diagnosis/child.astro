        const dataUrl = canvas.toDataURL('image/png');
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;animation:fadeIn 0.2s;';
        overlay.innerHTML = '<div style="background:white;border-radius:16px;padding:20px;max-width:360px;width:100%;text-align:center;position:relative;">' +
          '<button onclick="this.parentElement.parentElement.remove()" style="position:absolute;top:8px;left:8px;border:none;background:rgba(0,0,0,0.5);color:white;font-size:20px;width:30px;height:30px;border-radius:50%;cursor:pointer;line-height:30px;z-index:10;">x</button>' +
          '<p style="font-size:14px;color:#333;margin:0 0 12px;"><strong>Long press to save to camera roll</strong></p>' +
          '<p style="font-size:12px;color:#888;margin:0 0 12px;">You can also share this image directly on WeChat</p>' +
          '<img src="' + dataUrl + '" style="width:100%;border-radius:8px;" />' +
          '<button onclick="this.parentElement.parentElement.remove()" style="margin-top:12px;padding:10px 24px;border:none;background:#0F2B46;color:white;border-radius:8px;font-size:14px;cursor:pointer;">Close</button>' +
          '</div>';
        document.body.appendChild(overlay);
      });
    }
  } else {
    alert('📸 Please screenshot to save your diagnosis!');
  }
}

function restart() {
  // 记录本次结果到localStorage（按孩子昵称区分）
  if (result) {
    try {
      saveChildHistory({ type: result.mainType, scores: result.scores, pct: result.pct, date: new Date().toISOString() });
    } catch(e) {}
  }
  currentStep = 0;
  answers = {};
  result = null;
  leadSubmitted = false;
  renderStart();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ===== 留资 =====
function showLead() {
  document.getElementById('leadOverlay').classList.add('active');
}

function closeLead() {
  document.getElementById('leadOverlay').classList.remove('active');
  leadSubmitted = true;
  calculateResult();
}

function submitLead() {
  const name = document.getElementById('leadName').value.trim();
  const contact = document.getElementById('leadContact').value.trim();
  
  if (!contact) {
    alert('Please enter your WeChat ID or phone number to receive the diagnosis report');
    return;
  }
  
  const privacyCheck = document.getElementById('privacyAgree');
  if (!privacyCheck || !privacyCheck.checked) {
    alert('Please agree to the privacy policy. We protect your and your child data security');
    return;
  }
  
  // Store locally
  try {
    const leads = JSON.parse(localStorage.getItem('diagnosis_leads') || '[]');
    leads.push({ name, contact, result, timestamp: new Date().toISOString() });
    localStorage.setItem('diagnosis_leads', JSON.stringify(leads));
  } catch(e) {}

  // Send to Feishu via Cloudflare Pages Function proxy
  fetch('/api/lead', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      nickname: childNickname || 'Default',
      name: name,
      contact: contact,
      result: result ? {
        type: result.mainType,
        typeLabel: TYPE_LABELS_EN[result.mainType],
        pct: result.pct,
      } : null,
    }),
  }).catch(function(err) {
    console.error('Feishu notification failed:', err);
  });

  leadSubmitted = true;
  document.getElementById('leadOverlay').classList.remove('active');
  calculateResult();
}

// ===== 键盘支持 =====
document.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    const nextBtn = document.getElementById('nextBtn');
    if (nextBtn && !nextBtn.disabled) nextBtn.click();
  }
  if (['1','2','3'].includes(e.key)) {
    const opts = document.querySelectorAll('.option');
    const idx = parseInt(e.key) - 1;
    if (opts[idx]) opts[idx].click();
  }
});

// ===== 启动 =====
renderStart();

