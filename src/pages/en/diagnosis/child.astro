// ===== 10道题数据 =====
const QUESTIONS = [
  {
    id: 'ST-AGE-001',
    title: 'How old is your child?',
    options: [
      { text: '6-9 years (Lower Primary)', ageGroup: 'A' },
      { text: '10-12 years (Upper Primary)', ageGroup: 'B' },
      { text: '13-18 years (Middle/High School)', ageGroup: 'C' },
