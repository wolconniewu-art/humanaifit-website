---
import Base from '../../layouts/Base.astro';
import ArticleCover from '../../components/ArticleCover.astro';
---

<Base
  title="Human-AI Synergy"
  description="Beacon Consulting — focused on Human-AI Fit research and practice, helping organizations achieve true competitive growth."
  lang="en"
  path="/en/"
>
  <!-- Hero (v3: matching zh-CN — scheme B colors, large Logo, no buttons, no stats) -->
  <section class="section" style="padding-top:120px;padding-bottom:100px;position:relative;overflow:hidden;background:linear-gradient(160deg, #f5f7fa 0%, #ffffff 40%, #eef1f5 100%);">
    
    <div style="position:absolute;top:-100px;right:-100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle, rgba(59,130,246,0.10) 0%, transparent 70%);pointer-events:none;"></div>
    <div style="position:absolute;bottom:-80px;left:-80px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle, rgba(201,169,110,0.08) 0%, transparent 70%);pointer-events:none;"></div>
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:600px;border-radius:50%;background:radial-gradient(circle, rgba(59,130,246,0.04) 0%, transparent 60%);pointer-events:none;"></div>
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;opacity:0.03;background-image:radial-gradient(circle, #0F2B46 1px, transparent 1px);background-size:40px 40px;pointer-events:none;"></div>

    <div class="container text-center" style="position:relative;z-index:1;">
      <div class="fade-in" style="margin-bottom:var(--spacing-lg);">
        <!-- Logo: new circular logo (human-AI fit mark + www.humanaifit.com) -->
        <div style="display:flex;align-items:center;justify-content:center;margin-bottom:6px;">
          <img src="/logo.svg?v=4" width="200" height="200" alt="humanAIfit — www.humanaifit.com" style="display:block;width:200px;max-width:52vw;height:auto;" />
        </div>
      <p class="section-label" style="color:#3B82F6;font-weight:600;">Beacon Consulting Co., Ltd.</p>
      <h1 style="max-width:740px;margin:0 auto var(--spacing-md);font-size:2.6rem;color:var(--color-primary);">
        You've adopted AI — has <span style="background:linear-gradient(135deg,#C9A96E,#B8944C);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">competitiveness</span> grown?
      </h1>
      <p style="font-size:18px;color:var(--color-text-secondary);margin:0 auto var(--spacing-xl);line-height:1.8;max-width:660px;">
        We specialize in <span style="font-weight:600;color:var(--color-primary);">Human-AI Fit</span> — helping organizations and individuals move from "using AI" to a state where human and AI capabilities compound each other.
      </p>

      <!-- Typewriter only -->
      <div style="margin-top:var(--spacing-lg);">
        <p style="font-size:17px;color:var(--color-text-secondary);font-weight:500;">
          <span id="typewriter-en" style="color:#3B82F6;font-weight:600;"></span>
        </p>
      </div>
    </div>
  </section>

  <!-- Value Proposition -->
  <section class="section" style="background:var(--color-surface);">
    <div class="container">
      <div class="text-center" style="margin-bottom:var(--spacing-3xl);">
        <p class="section-label">Our Belief</p>
        <h2>True Competitiveness Comes from Human-AI Synergy</h2>
        <p style="font-size:18px;color:var(--color-text-secondary);margin:var(--spacing-md) auto 0;max-width:640px;">
          Not the AI tool itself, but how humans and AI work together, determines who leads through change.
        </p>
      </div>

      <div class="grid-3">
        <div class="service-card">
          <div style="font-size:32px;margin-bottom:var(--spacing-md);color:var(--color-accent);">01</div>
          <h4>Human-AI Fit</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">Diagnose your organization's AI maturity, design human-AI collaborative workflows, and turn tech investments into real productivity.</p>
        </div>
        <div class="service-card">
          <div style="font-size:32px;margin-bottom:var(--spacing-md);color:var(--color-accent);">02</div>
          <h4>CBAM Compliance</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">Self-check your products in 30 seconds. Low-cost carbon compliance for SMEs navigating EU CBAM regulations.</p>
          <a href="/en/diagnosis/cbam/" class="btn btn-sm" style="display:inline-block;margin-top:12px;padding:8px 16px;background:#2e7d32;color:white;border-radius:6px;text-decoration:none;font-size:13px;font-weight:500;">Self-Check</a>
        </div>
        <div class="service-card">
          <div style="font-size:32px;margin-bottom:var(--spacing-md);color:var(--color-accent);">03</div>
          <h4>Globalization Strategy</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">Academic research meets industry practice. Market entry, compliance pathways, and localization for Chinese enterprises going global.</p>
        </div>
        <a href="/en/diagnosis/" class="service-card" style="display:block;text-decoration:none;color:inherit;cursor:pointer;">
          <div style="font-size:32px;margin-bottom:var(--spacing-md);color:var(--color-accent);">04</div>
          <h4>🔍 AI Literacy Diagnosis</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">10 quick questions, 30 seconds. Discover if your child is an Explorer &#x1F9D0;, Practitioner &#x1F6E0;&#xFE0F;, or Creator &#x1F3A8; — with personalized learning suggestions.</p>
          <span style="display:inline-block;margin-top:12px;padding:8px 16px;background:#2e7d32;color:white;border-radius:6px;font-size:13px;font-weight:500;">&#x1F4CA; Start Diagnosis</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Policy Tables Highlight -->
  <section style="padding:var(--spacing-3xl) 0;background:linear-gradient(135deg,#EFF6FF,#DBEAFE);">
    <div class="container text-center">
      <p class="section-label" style="color:#3B82F6;">Research · Free Download</p>
      <h2 style="color:#1E3A5F;">China-EU-US EV & Battery Policy Panorama</h2>
      <p style="max-width:550px;margin:var(--spacing-md) auto var(--spacing-xl);font-size:15px;color:#1E40AF;">
        172 policies spanning 1986–2026. Bilingual (CN/EN), six tables, free to download.
      </p>
      <div style="display:flex;gap:var(--spacing-md);justify-content:center;flex-wrap:wrap;">
        <a href="/en/policy-tables/" class="btn btn-primary" style="background:#3B82F6;box-shadow:0 4px 14px rgba(59,130,246,0.25);">📊 View Policy Tables →</a>
        <a href="/en/services/" class="btn btn-outline" style="border-color:#3B82F6;color:#1E3A5F;">Our Services</a>
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="align-items:center;">
        <div style="text-align:center;">
          <img src="/images/people/founder-2026-09.jpg" alt="Dr. Connie Wu" loading="lazy"
               style="width:100%;max-width:340px;border-radius:16px;box-shadow:0 12px 36px rgba(15,43,70,0.18);" />
          <p style="margin-top:14px;font-size:13px;color:var(--color-text-muted);">
            Dr. Connie Wu<br>Founder · Human-AI Collaboration Architect
          </p>
        </div>
        <div>
          <p class="section-label">About</p>
          <h2>Researcher · Entrepreneur · Human-AI Architect</h2>
          <p style="color:var(--color-text-secondary);">
            Founded by Connie, Beacon Consulting focuses on Human-AI Fit. We don't sell software or templates — we bring academic rigor and industry experience to help organizations and individuals find their optimal human-AI synergy path.
          </p>
          <p style="color:var(--color-text-secondary);">
            Our core team includes specialized AI Agents (Main Orchestrator, Globalization Researcher, Human-AI Fit Researcher, Knowledge Coach, AI Product Manager, AI Teacher, AI Student), delivering at a pace and depth traditional consulting cannot match.
          </p>
          <a href="/en/about/" class="btn btn-outline" style="margin-top:var(--spacing-md);">Learn More →</a>
          <div style="margin-top:var(--spacing-xl);padding-top:var(--spacing-lg);border-top:1px solid var(--color-border);">
            <div style="font-size:13px;color:var(--color-text-muted);margin-bottom:var(--spacing-md);">Core Competencies</div>
            <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-sm);">
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">Human-AI Fit</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">Organizational Behavior</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">CBAM Compliance</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">Globalization</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">Knowledge Management</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">AI Collaboration</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Academic & research community: photo wall -->
  <section style="padding:var(--spacing-2xl) 0;background:var(--color-bg);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);">
    <div class="container text-center">
      <p class="section-label" style="color:var(--color-text-muted);">Academic & Research Community</p>
      <p style="font-size:14px;color:var(--color-text-muted);max-width:560px;margin:var(--spacing-sm) auto var(--spacing-xl);">
        The founder's research and industry practice sit within the peer view of these academic institutions.
      </p>
      <div class="about-photo-wall">
        <a class="about-photo-cell" href="https://www.gerpisa.org" target="_blank" rel="noopener noreferrer">
          <img src="/images/people/org-gerpisa-2025.jpg" alt="Dr. Connie Wu at GERPISA 33rd International Colloquium" loading="lazy" />
          <span class="about-photo-cap"><strong>GERPISA</strong> 2025 · International Network of Automotive Research</span>
        </a>
        <a class="about-photo-cell" href="https://www.chinagoesglobal.org" target="_blank" rel="noopener noreferrer">
          <img src="/images/people/org-cga-2026.jpg" alt="Dr. Connie Wu at China Goes Global 2026" loading="lazy" />
          <span class="about-photo-cap"><strong>China Goes Global</strong> 2026 · China Globalization Association</span>
        </a>
        <a class="about-photo-cell" href="https://www.aaom.asia" target="_blank" rel="noopener noreferrer">
          <img src="/images/people/org-aaom-2026.jpg" alt="Dr. Connie Wu at AAOM 14th Annual Conference" loading="lazy" />
          <span class="about-photo-cap"><strong>AAOM</strong> 2026 · Asia Academy of Management</span>
        </a>
      </div>
      <p style="font-size:13px;color:var(--color-text-muted);margin-top:var(--spacing-lg);">
        And Researcher of the Global AI Center (BIC) · Expert Committee Member of the hub for Business Innovation & Globalization (BIG) · Industry Expert of the Good Business Center, emlyon business school; WOL Certified Coach.
      </p>
    </div>
  </section>

  <!-- Featured Insights -->
  <section class="section" style="background:var(--color-surface);">
    <div class="container">
      <div class="text-center" style="margin-bottom:var(--spacing-2xl);">
        <p class="section-label">Featured Insights</p>
        <h2>What We're Thinking About</h2>
        <p style="font-size:16px;color:var(--color-text-secondary);max-width:560px;margin:var(--spacing-md) auto 0;">
          36 in-depth articles on Human-AI Fit, carbon compliance, China going global, and AI governance.
        </p>
      </div>
      <div class="grid-3">
        <a href="/en/blog/three_summits_ai_physical/" class="insight-card">
          <ArticleCover title="AI from Virtual to Physical: Three Summits Converge on One Question" tags="Frontier Tech" size="100%" radius="10px" fullTitle />
          <div class="insight-body">
            <span class="insight-tag">Frontier Tech</span>
            <span class="insight-date">2026-09-12</span>
          </div>
        </a>
        <a href="/en/blog/ai_invisible_cost/" class="insight-card">
          <ArticleCover title="When AI Does All the Doing, What's the Most Important Thing Left for You?" tags="Human-AI Fit" size="100%" radius="10px" fullTitle />
          <div class="insight-body">
            <span class="insight-tag">Human-AI Fit</span>
            <span class="insight-date">2026-09-01</span>
          </div>
        </a>
        <a href="/en/blog/eu_compliance_carbon_guide/" class="insight-card">
          <ArticleCover title="Reading the Carbon Pricing Map: How CBAM Reshapes China's Exports" tags="Carbon Compliance" size="100%" radius="10px" fullTitle />
          <div class="insight-body">
            <span class="insight-tag">Carbon Compliance</span>
            <span class="insight-date">2026-09-01</span>
          </div>
        </a>
      </div>
      <div class="text-center" style="margin-top:var(--spacing-2xl);">
        <a href="/en/blog/" class="btn btn-outline">Browse all 36 articles →</a>
      </div>
    </div>
  </section>

  <!-- Open Research Output -->
  <section style="padding:var(--spacing-2xl) 0;background:linear-gradient(135deg,#EFF6FF,#DBEAFE);">
    <div class="container">
      <div class="text-center" style="margin-bottom:var(--spacing-2xl);">
        <p class="section-label" style="color:#3B82F6;">Open Research · Free Download</p>
        <h2 style="color:#1E3A5F;">Data We Curated — Take It and Use It</h2>
        <p style="max-width:600px;margin:var(--spacing-md) auto 0;font-size:15px;color:#1E40AF;">
          Not second-hand summaries — first-hand, structured, citable data. Bilingual, continuously updated.
        </p>
      </div>
      <div class="grid-3">
        <a href="/en/policy-tables/" class="research-card">
          <div class="research-icon">📊</div>
          <h4>China-EU-US Policy Panorama</h4>
          <p>172 policies spanning 1986–2026. Six tables, bilingual.</p>
          <span class="research-cta">View policy tables →</span>
        </a>
        <div class="research-card">
          <div class="research-icon">🏆</div>
          <h4>Global AI Ranking Datasets</h4>
          <p>Forbes AI 50, HumanizeAI 36 countries, Observer 100 — cleaned into analyzable tables.</p>
          <div class="research-downloads">
            <a href="/files/ai_rankings_forbes50_global_en.xlsx" download>Forbes AI 50 (EN)</a>
            <a href="/files/ai_rankings_humanizeai_36_en.xlsx" download>HumanizeAI 36 (EN)</a>
            <a href="/files/ai_rankings_observer_100_en.xlsx" download>Observer 100 (EN)</a>
          </div>
        </div>
        <a href="/en/diagnosis/" class="research-card">
          <div class="research-icon">🧪</div>
          <h4>AI Literacy Diagnosis</h4>
          <p>10 questions, 30 seconds — child, adult and senior versions with personalized suggestions.</p>
          <span class="research-cta">Start free →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark text-center">
    <div class="container">
      <p class="section-label" style="margin-bottom:var(--spacing-md);">Ready to Talk?</p>
      <p style="max-width:500px;margin:0 auto var(--spacing-lg);font-size:14px;opacity:0.85;">
        Tell us about your challenge. We'll give you a direction within 30 minutes.
      </p>
      <a href="/en/contact/" class="btn btn-primary">Book Now →</a>
    </div>
  </section>

  <!-- Lead form -->
  <section class="section" style="background:#f8f7f4;">
    <div class="container">
      <div class="huma-lead-section">
        <div class="huma-lead-title">Leave your contact, let's talk</div>
        <div class="huma-lead-sub">Tell me your direction; I reply personally within 24h. Used only to reply — no ads.</div>
        <form class="huma-lead-form" id="leadForm-home" onsubmit="return humaSubmitLead(event, 'home')">
          <label>Your name</label>
          <input type="text" name="name" required placeholder="Your name or nickname" />
          <label>Email</label>
          <input type="email" name="email" required placeholder="you@example.com" />
          <label>What are you interested in?</label>
          <select name="intent" required>
            <option value="">Select</option>
            <option>Human-AI Fit Consulting</option>
            <option>AI Literacy Diagnosis</option>
            <option>CBAM Carbon Compliance</option>
            <option>Globalization Strategy</option>
            <option>Content Subscription</option>
            <option>Other</option>
          </select>
          <label>What do you want to solve? (optional)</label>
          <textarea name="note" placeholder="Briefly describe your need"></textarea>
          <p class="huma-lead-note">A real person (not a bot). No phone number collected. Erasable anytime.</p>
          <button type="submit" class="huma-lead-submit">Send</button>
          <div class="huma-lead-msg" id="leadMsg-home"></div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    async function humaSubmitLead(e, source) {
      e.preventDefault();
      var f = e.target, msg = document.getElementById('leadMsg-' + source), btn = f.querySelector('.huma-lead-submit');
      var data = { name: f.name.value, email: f.email.value, intent: f.intent.value, note: f.note.value, source: source };
      btn.disabled = true; btn.textContent = 'Sending...';
      try {
        await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        msg.className = 'huma-lead-msg ok'; msg.textContent = '✅ Received. I will reply within 24h.';
        f.reset();
      } catch (err) { msg.className = 'huma-lead-msg err'; msg.textContent = 'Failed. Please try again.'; }
      btn.disabled = false; btn.textContent = 'Send';
    }
  </script>


  <!-- Typewriter animation script -->
  <script is:inline>
    (function() {
      var phrases = [
        "What's your organization's AI maturity level?",
        "30 seconds to check if your product faces CBAM tariffs",
        "China-EU-US: 172 EV & battery policies compared",
        "From \"using AI\" to being measurably stronger with AI",
        "Your AI literacy level? 10 questions, 30 seconds",
        "This site is bilingual — switch languages to read more!"
      ];
      function init() {
        var el = document.getElementById("typewriter-en");
        if (!el) { setTimeout(init, 100); return; }
        var idx = 0, charIdx = 0, isDeleting = false, current = "";
        function type() {
          var full = phrases[idx];
          if (isDeleting) {
            current = full.substring(0, charIdx--);
          } else {
            current = full.substring(0, charIdx++);
          }
          el.innerHTML = current + '<span style="color:#06B6D4;">▌</span>';
          if (!isDeleting && charIdx === full.length + 1) {
            isDeleting = true;
            setTimeout(type, 2000);
            return;
          }
          if (isDeleting && charIdx === 0) {
            isDeleting = false;
            idx = (idx + 1) % phrases.length;
          }
          setTimeout(type, isDeleting ? 40 : 80);
        }
        type();
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>

<style is:global>
  .insight-card {
    display: flex; flex-direction: column; background: var(--color-bg);
    border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden;
    text-decoration: none; color: inherit;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .insight-card:hover { transform: translateY(-4px); border-color: var(--color-accent); box-shadow: 0 10px 28px rgba(15,43,70,0.10); }
  .insight-card .article-cover { border-radius: 0 !important; height: 150px !important; }
  .insight-body { padding: 18px 20px 22px; }
  .insight-tag { display: inline-block; padding: 2px 10px; background: rgba(201,169,110,0.12); color: var(--color-accent-dark); border-radius: 12px; font-size: 11px; font-weight: 600; margin-bottom: 10px; }
  .insight-body h4 { font-size: 15px; line-height: 1.45; font-weight: 600; color: var(--color-primary); margin: 0 0 10px; }
  .insight-date { font-size: 12px; color: var(--color-text-muted); }
  .research-card { display: flex; flex-direction: column; padding: 28px 24px; background: #ffffff; border-radius: 14px; border: 1px solid rgba(59,130,246,0.18); text-decoration: none; color: inherit; transition: transform 0.25s, box-shadow 0.25s; }
  .research-card:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(59,130,246,0.16); }
  .research-icon { font-size: 30px; margin-bottom: 14px; }
  .research-card h4 { font-size: 16px; font-weight: 700; color: #1E3A5F; margin: 0 0 8px; }
  .research-card p { font-size: 13px; line-height: 1.7; color: var(--color-text-secondary); margin: 0 0 14px; flex: 1; }
  .research-cta { font-size: 13px; font-weight: 600; color: #3B82F6; }
  .research-downloads { display: flex; flex-direction: column; gap: 6px; }
  .research-downloads a { font-size: 12.5px; color: #2563EB; text-decoration: none; padding: 5px 10px; background: rgba(59,130,246,0.07); border-radius: 6px; transition: background 0.2s; }
  .research-downloads a:hover { background: rgba(59,130,246,0.16); }
  .about-photo-wall { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--spacing-lg, 20px); max-width: 960px; margin: 0 auto; }
  .about-photo-cell { display: block; text-decoration: none; background: #fff; border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden; box-shadow: 0 6px 18px rgba(15,43,70,0.08); transition: transform .25s, box-shadow .25s; }
  .about-photo-cell:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,43,70,0.16); }
  .about-photo-cell img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .about-photo-cap { display: block; padding: 10px 14px; font-size: 12px; line-height: 1.5; color: var(--color-text-muted); text-align: left; }
  .about-photo-cap strong { color: var(--color-primary); display: block; font-size: 13px; }
</style>

</Base>