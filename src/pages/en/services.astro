---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Services"
  description="Beacon Consulting services — Human-AI Fit Consulting, CBAM Carbon Compliance, Globalization Strategy."
  lang="en"
  path="/en/services/"
>
  <section class="section" style="padding-top:100px;">
    <div class="container text-center">
      <p class="section-label">Services</p>
      <h1>How Can We Help?</h1>
      <p style="max-width:600px;margin:var(--spacing-md) auto 0;color:var(--color-text-secondary);">
        Three core service lines centered on Human-AI Fit, from strategic diagnosis to execution.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <!-- ===== 01 Human-AI Fit Consulting ===== -->
      <div id="human-ai-fit" style="margin-bottom:var(--spacing-3xl);padding:var(--spacing-xl);background:var(--color-surface);border-radius:12px;border:1px solid var(--color-border);">
        <h2 style="margin-bottom:var(--spacing-lg);">01. Human-AI Fit Consulting</h2>

        <div style="margin-bottom:var(--spacing-lg);">
          <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">The problem</div>
          <p style="color:var(--color-text-secondary);margin:0;">Teams are using AI, yet output hasn't improved: tools were bought, workflows didn't change, accountability is unclear. <strong style="color:var(--color-primary);">"Using AI" hasn't turned into "being stronger because of AI."</strong></p>
        </div>

        <div style="margin-bottom:var(--spacing-lg);">
          <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">What you get</div>
          <ul style="color:var(--color-text-secondary);margin:0;padding-left:1.2em;line-height:1.9;">
            <li>AI maturity assessment: where you stand and what blocks you</li>
            <li>Human + AI dual-engine operating model: workflow redesign and role redefinition</li>
            <li>Team enablement: tiered training and hands-on coaching</li>
            <li>Continuous optimization: periodic reviews and iteration guidance</li>
          </ul>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-lg);margin-bottom:var(--spacing-lg);">
          <div>
            <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">Typical timeline</div>
            <p style="margin:0;color:var(--color-text-secondary);">4–8 weeks (scope-dependent)</p>
          </div>
          <div>
            <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">Who it's for</div>
            <p style="margin:0;color:var(--color-text-secondary);">Organizations rolling out AI with disappointing returns</p>
          </div>
        </div>

        <div style="margin-top:var(--spacing-lg);display:flex;flex-wrap:wrap;gap:var(--spacing-sm);">
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">AI Maturity Assessment</span>
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">Workflow Redesign</span>
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">Team Enablement</span>
        </div>
        <div style="margin-top:var(--spacing-lg);display:flex;gap:12px;flex-wrap:wrap;">
          <a href="/en/diagnosis/" class="btn btn-primary" target="_blank">AI Literacy Diagnosis →</a>
          <a href="/en/contact/" class="btn" style="border:1px solid var(--color-border);color:var(--color-primary);border-radius:8px;padding:12px 20px;text-decoration:none;font-weight:600;">Request a quote →</a>
        </div>
      </div>

      <!-- ===== 02 CBAM ===== -->
      <div id="cbam" style="margin-bottom:var(--spacing-3xl);padding:var(--spacing-xl);background:var(--color-surface);border-radius:12px;border:1px solid var(--color-border);">
        <h2 style="margin-bottom:var(--spacing-lg);">02. CBAM Carbon Compliance</h2>

        <div style="margin-bottom:var(--spacing-lg);">
          <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">The problem</div>
          <p style="color:var(--color-text-secondary);margin:0;">EU CBAM is now operational: <strong style="color:var(--color-primary);">does your product need reporting, where does carbon data come from, and what will it cost?</strong> — uncertainty means risk and extra cost.</p>
        </div>

        <div style="margin-bottom:var(--spacing-lg);">
          <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">What you get</div>
          <ul style="color:var(--color-text-secondary);margin:0;padding-left:1.2em;line-height:1.9;">
            <li>30-second free self-check by HS code</li>
            <li>Compliance pathway: obligations, timeline, ownership</li>
            <li>Carbon data collection templates and calculation methods</li>
            <li>Ongoing EU regulation tracking and alerts</li>
          </ul>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-lg);margin-bottom:var(--spacing-lg);">
          <div>
            <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">Typical timeline</div>
            <p style="margin:0;color:var(--color-text-secondary);">Self-check instant; setup 2–6 weeks</p>
          </div>
          <div>
            <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">Who it's for</div>
            <p style="margin:0;color:var(--color-text-secondary);">Exporters of steel, aluminium, cement, fertiliser, electricity, hydrogen to the EU</p>
          </div>
        </div>

        <div style="margin-top:var(--spacing-lg);display:flex;flex-wrap:wrap;gap:var(--spacing-sm);">
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">Free Self-Check</span>
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">Compliance Planning</span>
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">EU Regulation Tracking</span>
        </div>
        <div style="margin-top:var(--spacing-lg);display:flex;gap:12px;flex-wrap:wrap;">
          <a href="/en/diagnosis/cbam/" class="btn btn-primary" target="_blank">Free Self-Check →</a>
          <a href="/en/contact/" class="btn" style="border:1px solid var(--color-border);color:var(--color-primary);border-radius:8px;padding:12px 20px;text-decoration:none;font-weight:600;">Request a quote →</a>
        </div>
      </div>

      <!-- ===== 03 Globalization ===== -->
      <div id="globalization" style="padding:var(--spacing-xl);background:var(--color-surface);border-radius:12px;border:1px solid var(--color-border);">
        <h2 style="margin-bottom:var(--spacing-lg);">03. Globalization Strategy</h2>

        <div style="margin-bottom:var(--spacing-lg);">
          <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">The problem</div>
          <p style="color:var(--color-text-secondary);margin:0;">Going global is a must, but <strong style="color:var(--color-primary);">which market, in what form, and how to land compliantly</strong> — without a structured view, resources go to the wrong markets.</p>
        </div>

        <div style="margin-bottom:var(--spacing-lg);">
          <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">What you get</div>
          <ul style="color:var(--color-text-secondary);margin:0;padding-left:1.2em;line-height:1.9;">
            <li>Market entry strategy: selection and sequencing</li>
            <li>Brand and value positioning guidance</li>
            <li>Cross-border compliance and policy risk map</li>
            <li>Localization and organizational recommendations</li>
          </ul>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-lg);margin-bottom:var(--spacing-lg);">
          <div>
            <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">Typical timeline</div>
            <p style="margin:0;color:var(--color-text-secondary);">3–6 weeks (report + workshop)</p>
          </div>
          <div>
            <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-muted);text-transform:uppercase;margin-bottom:6px;">Who it's for</div>
            <p style="margin:0;color:var(--color-text-secondary);">Chinese companies planning or already going global</p>
          </div>
        </div>

        <div style="margin-top:var(--spacing-lg);display:flex;flex-wrap:wrap;gap:var(--spacing-sm);">
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">Market Entry Strategy</span>
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">Regulatory Compliance</span>
          <span style="padding:4px 12px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:16px;font-size:12px;">Localization</span>
        </div>
        <a href="/en/contact/" class="btn btn-primary" style="margin-top:var(--spacing-lg);display:inline-block;">Request a quote →</a>
      </div>
    </div>
  </section>

  <section class="section section-dark text-center">
    <div class="container">
      <h2>Not Sure Which Service Fits?</h2>
      <p style="max-width:500px;margin:var(--spacing-md) auto var(--spacing-xl);opacity:0.85;font-size:15px;">
        Book a free diagnostic session and we'll help identify your most urgent needs.
      </p>
      <a href="/en/contact/" class="btn btn-primary">Book Now →</a>
    </div>
  </section>
</Base>
