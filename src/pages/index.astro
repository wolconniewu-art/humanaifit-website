---
import Base from '../layouts/Base.astro';
import ArticleCover from '../components/ArticleCover.astro';
---

<Base
  title="人机协同，驱动增长"
  description="彼恳管理咨询 — 专注于人机契合（Human-AI Fit）研究与实践，帮助组织和个人实现真正的竞争力增长。"
  lang="zh-CN"
  path="/"
>
  <!-- Hero (简洁版：去装饰层，留核心信息) -->
  <section class="section" style="padding-top:100px;padding-bottom:80px;background:linear-gradient(160deg, #f5f7fa 0%, #ffffff 40%, #eef1f5 100%);">
    <div class="container text-center">
      <div class="fade-in" style="margin-bottom:var(--spacing-lg);">
        <!-- Logo: 去电光蓝装饰线 -->
        <div style="display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:var(--spacing-lg);">
          <svg width="56" height="56" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="hlogo" x1="0" y1="0" x2="72" y2="72">
                <stop offset="0%" stop-color="#0F2B46"/>
                <stop offset="100%" stop-color="#1A3F64"/>
              </linearGradient>
            </defs>
            <rect width="72" height="72" rx="18" fill="url(#hlogo)"/>
            <text x="36" y="47" text-anchor="middle" font-family="Inter,sans-serif" font-size="32" font-weight="800" fill="white">H</text>
          </svg>
          <span style="font-size:36px;font-weight:400;color:#0F2B46;letter-spacing:-0.5px;">human</span>
          <span style="font-size:44px;font-weight:900;background:linear-gradient(135deg,#C9A96E,#DFC88A);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">AI</span>
          <span style="font-size:30px;font-weight:300;color:#8A8A8A;">fit</span>
        </div>
      <p class="section-label" style="color:#3B82F6;font-weight:600;">彼恳企业管理咨询</p>
      <h1 style="max-width:700px;margin:0 auto var(--spacing-md);font-size:2.4rem;color:var(--color-primary);">
        你用了AI，<span style="background:linear-gradient(135deg,#C9A96E,#B8944C);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">竞争力增长</span>了吗？
      </h1>
      <p style="font-size:17px;color:var(--color-text-secondary);margin:0 auto var(--spacing-lg);line-height:1.8;max-width:640px;">
        我们专注于<span style="font-weight:600;color:var(--color-primary);">人机契合（Human-AI Fit）</span>研究与实践——帮助组织和个人从"会用AI"走向"因AI而真正更强"。
      </p>

      <!-- Typewriter -->
      <div style="margin-top:var(--spacing-lg);">
        <p style="font-size:17px;color:var(--color-text-secondary);font-weight:500;">
          <span id="typewriter" style="color:#3B82F6;font-weight:600;"></span>
        </p>
      </div>
    </div>
  </section>

  <!-- Value Proposition: 服务卡片 2+2 分组（去编号、去emoji） -->
  <section class="section" style="background:var(--color-surface);">
    <div class="container">
      <div class="text-center" style="margin-bottom:var(--spacing-2xl);">
        <p class="section-label">我们的信念</p>
        <h2>真正的竞争力来自人机协同</h2>
        <p style="font-size:17px;color:var(--color-text-secondary);margin:var(--spacing-md) auto 0;max-width:620px;">
          不是AI工具本身，而是人如何与AI协同工作，决定了一个组织能否在变革中领先。
        </p>
      </div>

      <!-- 面向组织 -->
      <p class="section-label" style="margin-bottom:var(--spacing-sm);">面向组织</p>
      <div class="grid-2" style="margin-bottom:var(--spacing-2xl);">
        <div class="service-card">
          <h4>人机协同咨询</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">诊断组织当前的AI使用成熟度，设计人与AI协同的工作流程，让技术投资转化为真实效率增长。</p>
        </div>
        <div class="service-card">
          <h4>CBAM碳合规</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">30秒自检产品是否受欧盟碳关税影响。面向中小企业的低成本碳合规方案，助您从容应对欧盟CBAM法规。</p>
          <a href="/diagnosis/cbam/" class="btn btn-sm" style="display:inline-block;margin-top:12px;padding:8px 16px;background:#2e7d32;color:white;border-radius:6px;text-decoration:none;font-size:13px;font-weight:500;">开始自检</a>
        </div>
        <div class="service-card">
          <h4>全球化战略</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">基于学术研究与产业实践，为出海企业提供全球化战略咨询，涵盖市场准入、合规路径与本地化运营。</p>
        </div>
      </div>

      <!-- 面向个人 -->
      <p class="section-label" style="margin-bottom:var(--spacing-sm);">面向个人</p>
      <div class="grid-2">
        <a href="/diagnosis/" class="service-card" style="display:block;text-decoration:none;color:inherit;cursor:pointer;">
          <h4>孩子AI素养诊断</h4>
          <p style="font-size:14px;color:var(--color-text-secondary);">10道选择题，30秒测出你孩子的AI学习类型：探索型 / 应用型 / 创作型。附个性化学习建议，帮家长回答「我的孩子该学什么AI？」</p>
          <span style="display:inline-block;margin-top:12px;padding:8px 16px;background:#2e7d32;color:white;border-radius:6px;font-size:13px;font-weight:500;">免费诊断</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 精选洞察：让 36 篇存量内容在首屏下拉处被看见 -->
  <section class="section" style="background:var(--color-surface);">
    <div class="container">
      <div class="text-center" style="margin-bottom:var(--spacing-2xl);">
        <p class="section-label">精选洞察</p>
        <h2>我们在想什么</h2>
        <p style="font-size:16px;color:var(--color-text-secondary);max-width:560px;margin:var(--spacing-md) auto 0;">
          36 篇深度文章，关于人机契合、碳合规、中国全球化与 AI 治理。
        </p>
      </div>
      <div class="grid-3">
        <a href="/blog/three_summits_ai_physical/" class="insight-card">
          <ArticleCover title="AI 从虚拟走向物理：三场大会在同一个问题上收敛" tags="前沿科技" size="100%" radius="10px" />
          <div class="insight-body">
            <span class="insight-tag">前沿科技</span>
            <h4>AI 从虚拟走向物理：三场大会在同一个问题上收敛</h4>
            <span class="insight-date">2026-09-12</span>
          </div>
        </a>
        <a href="/blog/ai_invisible_cost/" class="insight-card">
          <ArticleCover title="当 AI 把活都替你干了，你最该做的是什么？" tags="人机契合" size="100%" radius="10px" />
          <div class="insight-body">
            <span class="insight-tag">人机契合</span>
            <h4>当 AI 把活都替你干了，你最该做的是什么？</h4>
            <span class="insight-date">2026-09-01</span>
          </div>
        </a>
        <a href="/blog/eu_compliance_carbon_guide/" class="insight-card">
          <ArticleCover title="读懂碳世界的定价地图：欧盟 CBAM 如何重构中国出口" tags="碳合规" size="100%" radius="10px" />
          <div class="insight-body">
            <span class="insight-tag">碳合规</span>
            <h4>读懂碳世界的定价地图：CBAM 如何重构中国出口</h4>
            <span class="insight-date">2026-09-01</span>
          </div>
        </a>
      </div>
      <div class="text-center" style="margin-top:var(--spacing-2xl);">
        <a href="/blog/" class="btn btn-outline">浏览全部 36 篇 →</a>
      </div>
    </div>
  </section>

  <!-- 开放研究产出：政策表 + AI 榜单，一个入口全下载 -->
  <section style="padding:var(--spacing-2xl) 0;background:linear-gradient(135deg,#EFF6FF,#DBEAFE);">
    <div class="container">
      <div class="text-center" style="margin-bottom:var(--spacing-2xl);">
        <p class="section-label" style="color:#3B82F6;">开放研究产出 · 免费下载</p>
        <h2 style="color:#1E3A5F;">我们自己整理的数据，直接拿去用</h2>
        <p style="max-width:600px;margin:var(--spacing-md) auto 0;font-size:15px;color:#1E40AF;">
          不是二手转述——是一手整理、可引用的结构化数据。中英双语，持续更新。
        </p>
      </div>
      <div class="grid-3">
        <a href="/policy-tables/" class="research-card">
          <div class="research-icon">📊</div>
          <h4>中美欧新能源政策全景</h4>
          <p>172 条政策，覆盖 1986–2026 四十年。六张表格，中英双语。</p>
          <span class="research-cta">查看政策表 →</span>
        </a>
        <div class="research-card">
          <div class="research-icon">🏆</div>
          <h4>全球 AI 榜单数据集</h4>
          <p>Forbes AI 50、HumanizeAI 36 国、Observer 100 人——整理成可分析表格。</p>
          <div class="research-downloads">
            <a href="/files/AI榜单_Forbes_AI50全球_2026.xlsx" download>Forbes AI 50</a>
            <a href="/files/AI榜单_HumanizeAI_36国_2026.xlsx" download>HumanizeAI 36国</a>
            <a href="/files/AI榜单_Observer_100人_2025.xlsx" download>Observer 100人</a>
          </div>
        </div>
        <a href="/diagnosis/" class="research-card">
          <div class="research-icon">🧪</div>
          <h4>在线工具：AI 素养诊断</h4>
          <p>10 道题、30 秒，覆盖儿童 / 成人 / 银发三档，给出个性化建议。</p>
          <span class="research-cta">免费诊断 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="align-items:center;">
        <div style="text-align:center;">
          <img src="/images/people/connie-wu.jpg" alt="吴传娟博士（Dr. Connie Wu）" loading="lazy"
               style="width:100%;max-width:340px;border-radius:16px;box-shadow:0 12px 36px rgba(15,43,70,0.18);" />
          <p style="margin-top:14px;font-size:13px;color:var(--color-text-muted);">
            吴传娟博士（Dr. Connie Wu）<br>创始人 · 人机协同架构师
          </p>
        </div>
        <div>
          <p class="section-label">关于</p>
          <h2>研究者 · 创业者 · 人机协同架构师</h2>
          <p style="color:var(--color-text-secondary);">
            彼恳咨询由Connie创立，专注于人机契合（Human-AI Fit）研究与实践。我们不卖软件、不套模板——带着学术研究的严谨和产业实战的经验，帮助组织和个人找到最适合自己的人机协同路径。
          </p>
          <p style="color:var(--color-text-secondary);font-size:14px;margin-top:var(--spacing-md);">
            核心团队汇聚了多位专业AI Agent（AI大总管·全球化研究员·人机契合研究员·知识教练·AI时代的产品经理·AI时代的老师·AI时代的学生），以传统咨询无法匹及的速度与深度交付成果。
          </p>
          <a href="/about/" class="btn btn-outline" style="margin-top:var(--spacing-md);">了解更多</a>
          <div style="margin-top:var(--spacing-xl);padding-top:var(--spacing-lg);border-top:1px solid var(--color-border);">
            <div style="font-size:13px;color:var(--color-text-muted);margin-bottom:var(--spacing-md);">核心领域</div>
            <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-sm);">
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">人机契合</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">组织行为</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">CBAM碳合规</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">全球化</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">知识管理</span>
              <span style="padding:6px 14px;background:rgba(201,169,110,0.1);color:var(--color-accent-dark);border-radius:20px;font-size:13px;font-weight:500;">AI协同</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 学术背书：研究机构 logo 墙 -->
  <section style="padding:var(--spacing-2xl) 0;background:var(--color-bg);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);">
    <div class="container text-center">
      <p class="section-label" style="color:var(--color-text-muted);">学术与研究社群</p>
      <p style="font-size:14px;color:var(--color-text-muted);max-width:560px;margin:var(--spacing-sm) auto var(--spacing-xl);">
        创始人的研究与产业实践，长期置于这些学术机构的同行视野之中。
      </p>
      <div class="logo-wall">
        <div class="logo-cell"><img src="/images/orgs/gerpisa.png" alt="GERPISA" /></div>
        <div class="logo-cell"><img src="/images/orgs/cga.jpg" alt="Chinese Globalization Association" /></div>
        <div class="logo-cell"><span class="logo-wordmark">AAOM</span><span class="logo-sub">Asia Academy of Management</span></div>
      </div>
      <p style="font-size:13px;color:var(--color-text-muted);margin-top:var(--spacing-lg);">
        以及 emlyon business school 全球人工智能中心（BIC）· 商业创新与全球化研究中心（BIG）· 美好商业中心，WOL 认证教练
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark text-center">
    <div class="container">
      <p class="section-label" style="margin-bottom:var(--spacing-md);">准备好聊聊了吗？</p>
      <p style="max-width:500px;margin:0 auto var(--spacing-lg);font-size:14px;opacity:0.85;">
        告诉我们你的挑战，30分钟内给你一个可行的方向。
      </p>
      <a href="/contact/" class="btn btn-primary">立即预约</a>
    </div>
  </section>

  <!-- 留资表单 -->
  <section class="section" style="background:#f8f7f4;">
    <div class="container">
      <div class="huma-lead-section">
        <div class="huma-lead-title">留下你的联系方式，我们好好聊一次</div>
        <div class="huma-lead-sub">告诉我你的方向，24小时内我会亲自回复。你的信息仅用于回复，不会推送广告。</div>
        <form class="huma-lead-form" id="leadForm-home" onsubmit="return humaSubmitLead(event, 'home')">
          <label>怎么称呼你？</label>
          <input type="text" name="name" required placeholder="你的姓名或昵称" />
          <label>邮箱</label>
          <input type="email" name="email" required placeholder="you@example.com" />
          <label>你关心什么？</label>
          <select name="intent" required>
            <option value="">请选择</option>
            <option>人机协同咨询</option>
            <option>AI素养诊断</option>
            <option>CBAM碳合规</option>
            <option>全球化战略</option>
            <option>订阅内容</option>
            <option>其他合作</option>
          </select>
          <label>想解决的问题（选填）</label>
          <textarea name="note" placeholder="简单描述你的需求"></textarea>
          <p class="huma-lead-note">这是一个真人（不是客服系统），留言会直接到我的飞书。不收集手机号，可随时要求删除。</p>
          <button type="submit" class="huma-lead-submit">发送</button>
          <div class="huma-lead-msg" id="leadMsg-home"></div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    async function humaSubmitLead(e, source) {
      e.preventDefault();
      var f = e.target, msg = document.getElementById('leadMsg-' + source), btn = f.querySelector('.huma-lead-submit');
      var data = {
        name: f.name.value, email: f.email.value,
        intent: f.intent.value, note: f.note.value, source: source
      };
      btn.disabled = true; btn.textContent = '发送中...';
      try {
        await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        msg.className = 'huma-lead-msg ok'; msg.textContent = '✅ 已收到，我会在24小时内回复你。';
        f.reset();
      } catch (err) {
        msg.className = 'huma-lead-msg err'; msg.textContent = '发送失败，请稍后再试。';
      }
      btn.disabled = false; btn.textContent = '发送';
    }
  </script>

  <!-- Typewriter animation script -->
  <script is:inline>
    (function() {
      var phrases = [
        "你的组织AI成熟度在哪个阶段？",
        "30秒判断产品是否受CBAM碳关税影响",
        "中美欧172条EV/电池政策最新对比",
        "从\u201C会用AI\u201D到\u201C因AI而更强\u201D",
        "你的AI素养什么水平？10题快速诊断",
        "网站有中英文双语版，记得切换阅读哦"
      ];
      function init() {
        var el = document.getElementById("typewriter");
        if (!el) { setTimeout(init, 100); return; }
        var idx = 0, charIdx = 0, isDeleting = false, current = "";
        function type() {
          var full = phrases[idx];
          if (isDeleting) {
            current = full.substring(0, charIdx--);
          } else {
            current = full.substring(0, charIdx++);
          }
          el.innerHTML = current + '<span style="color:#06B6D4;">\u258c</span>';
          if (!isDeleting && charIdx === full.length + 1) {
            isDeleting = true;
            setTimeout(type, 2000);
            return;
          }
          if (isDeleting && charIdx === 0) {
            isDeleting = false;
            idx = (idx + 1) % phrases.length;
          }
          setTimeout(type, isDeleting ? 40 : 80);
        }
        type();
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>

<style is:global>
  /* 精选洞察卡片 */
  .insight-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .insight-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 10px 28px rgba(15,43,70,0.10);
  }
  .insight-card .article-cover { border-radius: 0 !important; }
  .insight-body { padding: 18px 20px 22px; }
  .insight-tag {
    display: inline-block;
    padding: 2px 10px;
    background: rgba(201,169,110,0.12);
    color: var(--color-accent-dark);
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .insight-body h4 {
    font-size: 15px;
    line-height: 1.45;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 10px;
  }
  .insight-date { font-size: 12px; color: var(--color-text-muted); }

  /* 开放研究产出卡片 */
  .research-card {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid rgba(59,130,246,0.18);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .research-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(59,130,246,0.16);
  }
  .research-icon { font-size: 30px; margin-bottom: 14px; }
  .research-card h4 {
    font-size: 16px;
    font-weight: 700;
    color: #1E3A5F;
    margin: 0 0 8px;
  }
  .research-card p {
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 14px;
    flex: 1;
  }
  .research-cta {
    font-size: 13px;
    font-weight: 600;
    color: #3B82F6;
  }
  .research-downloads { display: flex; flex-direction: column; gap: 6px; }
  .research-downloads a {
    font-size: 12.5px;
    color: #2563EB;
    text-decoration: none;
    padding: 5px 10px;
    background: rgba(59,130,246,0.07);
    border-radius: 6px;
